{
    "$schema": "http://json-schema.org/schema#",
    "title": "System description for Arm CMN-based system",
    "type": "object",
    "required": ["version", "elements"],
    "additionalProperties": false,
    "properties": {
        "version": {
            "description": "System descriptor JSON version (currently 1)",
            "type": "integer"
        },
        "generator": {
            "description": "Tool that generated the descriptor file",
            "type": "string"
        },
        "date": {
            "description": "(deprecated) Date/time generated, seconds since Linux epoch",
            "type": "number"
        },
        "topology_discovery_time": {
            "description": "Topology discovery time in UTC RFC 3339 format",
            "type": "string"
        },
        "cpu_discovery_time": {
            "description": "CPU location discovery time in UTC RFC 3339 format",
            "type": "string"
        },
        "system_type": {
            "description": "System type, e.g. vendor string from BIOS",
            "type": "string"
        },
        "system_uuid": {
            "description": "System UUID, from BIOS",
            "type": "string"
        },
        "processor_type": {
            "description": "Processor type",
            "type": "string"
        },
        "c2c_links": {
            "description": "Recorded direct chip-to-chip connections. Absent or empty does not establish that no links exist.",
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "endpoints"],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "description": "Link identifier, unique within this system description",
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                    },
                    "endpoints": {
                        "description": "Two endpoints on different meshes; order does not imply direction",
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                            "type": "object",
                            "required": ["mseq", "id"],
                            "additionalProperties": false,
                            "properties": {
                                "mseq": {
                                    "description": "Zero-based CMN sequence number in CMN element order, not a hardware chip ID",
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "id": {
                                    "description": "CHI device slot ID within the mesh",
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 65535
                                },
                                "type": {
                                    "description": "Optional explicit node type at this slot; preserved if the node was not captured",
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 65535
                                },
                                "interface": {
                                    "description": "Interface number within this gateway attachment, distinct from XP port number; omitted means unspecified",
                                    "type": "integer",
                                    "minimum": 0
                                }
                            }
                        }
                    },
                    "protocol": {
                        "description": "Optional link protocol name, e.g. CHI-C2C or CCIX",
                        "type": "string"
                    },
                    "description": {
                        "description": "Optional description of the connection",
                        "type": "string"
                    }
                }
            }
        },
        "io_address_map": {
            "description": "Non-hashed physical-address regions hosted by CMN I/O home nodes",
            "type": "object",
            "required": ["homes"],
            "additionalProperties": false,
            "properties": {
                "discovery_time": {
                    "description": "I/O address-map discovery time in UTC RFC 3339 format",
                    "type": "string"
                },
                "homes": {
                    "type": "array",
                    "items": {
                        "title": "CMN I/O home",
                        "type": "object",
                        "required": ["mseq", "id", "type_s", "regions"],
                        "additionalProperties": false,
                        "properties": {
                            "mseq": {
                                "description": "CMN instance number",
                                "type": "integer"
                            },
                            "id": {
                                "description": "I/O home node CHI target ID",
                                "type": "integer"
                            },
                            "type_s": {
                                "description": "I/O home node type",
                                "type": "string"
                            },
                            "regions": {
                                "type": "array",
                                "items": {
                                    "title": "I/O SAM region",
                                    "type": "object",
                                    "required": ["start", "end", "status", "resources"],
                                    "additionalProperties": false,
                                    "properties": {
                                        "start": {
                                            "description": "Inclusive region start as a hex string",
                                            "type": "string",
                                            "pattern": "^0x[0-9a-fA-F]+$"
                                        },
                                        "end": {
                                            "description": "Inclusive region end as a hex string",
                                            "type": "string",
                                            "pattern": "^0x[0-9a-fA-F]+$"
                                        },
                                        "status": {
                                            "description": "Whether system-wide homing information is consistent",
                                            "type": "string",
                                            "enum": ["ok", "inconsistent"]
                                        },
                                        "resources": {
                                            "description": "Named /proc/iomem resources within this region",
                                            "type": "array",
                                            "items": {
                                                "title": "I/O address resource",
                                                "type": "object",
                                                "required": ["start", "end", "name"],
                                                "additionalProperties": false,
                                                "properties": {
                                                    "start": {
                                                        "description": "Inclusive resource start as a hex string",
                                                        "type": "string",
                                                        "pattern": "^0x[0-9a-fA-F]+$"
                                                    },
                                                    "end": {
                                                        "description": "Inclusive resource end as a hex string",
                                                        "type": "string",
                                                        "pattern": "^0x[0-9a-fA-F]+$"
                                                    },
                                                    "name": {
                                                        "description": "Kernel resource name",
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "elements": {
            "description": "System elements, currently all CMNs",
            "type": "array",
            "items": {
                "title": "System element",
                "type": "object",
                "required": ["type", "product"],
                "additionalProperties": false,
                "properties": {
                    "type": {
                        "description": "Element type e.g. interconnect",
                        "type": "string",
                        "enum": ["interconnect"]
                    },
                    "product": {
                        "description": "Product name e.g. CMN",
                        "type": "string"
                    },
                    "version": {
                        "description": "Full product name e.g. CMN-700",
                        "type": ["string", "integer"]
                    },
                    "revision": {
                        "description": "Product revision",
                        "type": "integer"
                    },
                    "frequency": {
                        "description": "Current measured CMN frequency",
                        "type": "number"
                    },
                    "skiplist": {
                        "description": "Node skip list",
                        "type": "array"
                    },
                    "config": {
                        "description": "Product-specific configuration",
                        "type": "object",
                        "required": ["X", "Y", "xps"],
                        "additionalProperties": false,
                        "properties": {
                            "base": {
                                "description": "CMN base address as hex string",
                                "type": "string"
                            },
                            "rootnode_offset": {
                                "description": "CMN root node offset as hex string",
                                "type": "string"
                            },
                            "chi_version": {
                                "description": "CHI version e.g. 5 = CHI-E",
                                "type": "integer"
                            },
                            "mpam_enabled": {
                                "type": "boolean"
                            },
                            "mpam_partid_width": {
                                "description": "MPAM PARTID width",
                                "type": "integer",
                                "minimum": 1
                            },
                            "mte_enabled": {
                                "type": "boolean"
                            },
                            "pa_width": {
                                "description": "Physical address width",
                                "type": "integer",
                                "minimum": 3,
                                "maximum": 52
                            },
                            "req_pa_width": {
                                "description": "REQ physical address width",
                                "type": "integer",
                                "minimum": 3,
                                "maximum": 52
                            },
                            "rsvdc_width": {
                                "description": "REQ RSVDC width",
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 255
                            },
                            "X": {
                                "description": "X dimension",
                                "type": "integer"
                            },
                            "Y": {
                                "description": "Y dimension",
                                "type": "integer"
                            },
                            "extra_ports": {
                                "description": "(deprecated) true if some XPs have extra ports",
                                "type": "boolean"
                            },
                            "xps": {
                                "description": "CMN crosspoints",
                                "type": "array",
                                "items": {
                                    "title": "CMN crosspoint",
                                    "type": "object",
                                    "required": ["X", "Y", "n_ports"],
                                    "additionalProperties": false,
                                    "properties": {
                                        "X": {
                                            "description": "X coordinate",
                                            "type": "integer"
                                        },
                                        "Y": {
                                            "description": "Y coordinate",
                                            "type": "integer"
                                        },
                                        "n_ports": {
                                            "description": "Number of XP ports",
                                            "type": "integer"
                                        },
                                        "id": {
                                            "description": "XP's CMN node id",
                                            "type": "integer"
                                        },
                                        "is_external": {
                                            "type": "boolean"
                                        },
                                        "disabled": {
                                            "description": "Node recorded as disabled; omitted when false",
                                            "type": "boolean",
                                            "default": false
                                        },
                                        "logical_id": {
                                            "description": "Logical ID",
                                            "type": "integer"
                                        },
                                        "dtc": {
                                            "description": "DTC domain",
                                            "type": "integer"
                                        },
                                        "skipped": {
                                            "description": "Node skip indicator",
                                            "type": "integer"
                                        },
                                        "mcs_east": {
                                            "description": "Mesh credited slices (east)",
                                            "type": "integer"
                                        },
                                        "mcs_north": {
                                            "description": "Mesh credited slices (north)",
                                            "type": "integer"
                                        },
                                        "ports": {
                                            "description": "XP ports",
                                            "type": "array",
                                            "items": {
                                                "title": "CMN XP port",
                                                "type": "object",
                                                "required": ["port"],
                                                "anyOf": [{"required": ["type"]}, {"required": ["base_id"]}],
                                                "additionalProperties": false,
                                                "properties": {
                                                    "port": {
                                                        "description": "XP port number",
                                                        "type": "integer"
                                                    },
                                                    "type": {
                                                        "description": "Port connected device type",
                                                        "type": "integer"
                                                    },
                                                    "type_s": {
                                                        "description": "Port connected device type string",
                                                        "type": "string"
                                                    },
                                                    "base_id": {
                                                        "description": "CHI ID of device slot zero",
                                                        "type": "integer",
                                                        "minimum": 0
                                                    },
                                                    "cal": {
                                                        "description": "Component Aggregation Layer (CAL) width",
                                                        "type": ["boolean", "integer"]
                                                    },
                                                    "ccs": {
                                                        "description": "CAL credited slices",
                                                        "type": "integer"
                                                    },
                                                    "devices": {
                                                        "description": "Device nodes connected to port",
                                                        "type": "array",
                                                        "items": {
                                                            "title": "CMN device node",
                                                            "type": "object",
                                                            "required": ["id", "type"],
                                                            "additionalProperties": false,
                                                            "properties": {
                                                                "id": {
                                                                    "description": "Device node id",
                                                                    "type": "integer"
                                                                },
                                                                "is_external": {
                                                                    "type": "boolean"
                                                                },
                                                                "disabled": {
                                                                    "description": "Node recorded as disabled; omitted when false",
                                                                    "type": "boolean",
                                                                    "default": false
                                                                },
                                                                "logical_id": {
                                                                    "description": "Logical ID",
                                                                    "type": "integer"
                                                                },
                                                                "type": {
                                                                    "description": "Device type",
                                                                    "type": "integer"
                                                                },
                                                                "type_s": {
                                                                    "description": "Device type string",
                                                                    "type": "string"
                                                                }
                                                            }
                                                        }
                                                    },
                                                    "pdevices": {
                                                        "description": "Devices on port, indexed by device number",
                                                        "type": "array",
                                                        "items": {
                                                            "title": "CMN port device",
                                                            "type": "object",
                                                            "additionalProperties": false,
                                                            "properties": {
                                                                "id": {
                                                                    "description": "Device node id",
                                                                    "type": "integer"
                                                                },
                                                                "device_number": {
                                                                    "description": "Device number within port",
                                                                    "type": "integer"
                                                                },
                                                                "dcs": {
                                                                    "description": "Device credited slices",
                                                                    "type": "integer"
                                                                }
                                                            }
                                                        }
                                                    },
                                                    "attached": {
                                                        "description": "Attached external devices e.g. CPUs",
                                                        "type": "array",
                                                        "items": {
                                                            "title": "Attached external device",
                                                            "type": "object"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "cpus": {
            "description": "CPUs, as known to OS",
            "type": "array",
            "items": {
                "title": "CPU",
                "type": "object",
                "properties": {
                    "type": {
                        "description": "type",
                        "type": "string",
                        "enum": ["cpu"]
                    },
                    "cpu": {
                        "description": "CPU number, as known to OS",
                        "type": "integer"
                    },
                    "mseq": {
                        "description": "CMN instance number",
                        "type": "integer"
                    },
                    "id": {
                        "description": "CHI srcid/tgtid",
                        "type": "integer"
                    },
                    "lpid": {
                        "description": "CHI LPID value; omitted when not known",
                        "type": "integer"
                    }
                }
            }
        }
    }
}
