R 0x1100 64 - S rnsam_status
RESET 0x1000000000000001 0x77ff00000007ff03
DESC Functions as the default and programming mode status register.
F 0 1 use_default_node
DESC Indicates target ID selection mode 1'b0: Enables RN SAM to hash address bits and generate target ID 1'b1: Uses default target ID
F 1 1 nstall_req
DESC Indicates RN SAM is programmed and ready 1'b0: STALL requests 1'b1: UNSTALL requests
F 8 11 dn_nodeid
DESC DN Node ID for DN operations
F 48 11 default_nodeid
DESC Default Node ID
PAR DEFAULT_NODEID_PARAM
F 60 3 default_target_type
DESC Indicates node type 3'b000: HN-F 3'b001: HN-I 3'b010: CXRA 3'b011: HN-P 3'b100: PCI-CXRA Others: Reserved CONSTRAINT: Only applicable for RN-I
R 0x1108 64 - S gic_mem_region_reg
RESET 0x0 0x7fffffffffff007d
DESC Configures GIC memory region.
SGO por_rnsam_secure_register_groups_override.mem_range
F 52 11 gic_region_nodeid
DESC GIC node ID
F 16 36 gic_region_base_addr
DESC Base address of the GIC memory region CONSTRAINT: Must be an integer multiple of region size
F 4 3 gic_region_size
DESC GIC memory region size 3'b000: 64KB 3'b001: 128KB 3'b010: 256KB 3'b011: 512KB CONSTRAINT: Memory region must be a power of 2.
F 2 2 gic_region_target_type
DESC Indicates node type 2'b00: HN-F 2'b01: HN-I 2'b10: CXRA 2'b11: HN-P CONSTRAINT: Only applicable for RN-I
F 0 1 gic_region_valid
DESC Memory region 1 valid 1'b0: Not valid 1'b1: Valid for memory region comparison
R 0x1120 64 - S sys_cache_grp_cal_mode_reg
RESET 0x0 0xb000b000b000b
DESC Configures the HN CAL mode support for all hashed target groups.
SGO por_rnsam_secure_register_groups_override.mem_range
F 51 1 scg3_hnf_cal_bit_override
DESC Configuration to choose LSB/MSB bit to override Device ID for HTG 3 1'b0: Hash MSB bit to override Device ID 1'b1: Hash LSB bit to override Device ID
F 49 1 scg3_hnf_cal_type
DESC Enables type of HN CAL for HTG 3 1'b0: CAL2 mode 1'b1: CAL4 mode
F 48 1 scg3_hnf_cal_mode_en
DESC Enables support for HN CAL for HTG 3
F 35 1 scg2_hnf_cal_bit_override
DESC Configuration to choose LSB/MSB bit to override Device ID for HTG 2 1'b0: Hash MSB bit to override Device ID 1'b1: Hash LSB bit to override Device ID
F 33 1 scg2_hnf_cal_type
DESC Enables type of HN CAL for HTG 2 1'b0: CAL2 mode 1'b1: CAL4 mode
F 32 1 scg2_hnf_cal_mode_en
DESC Enables support for HN CAL for HTG 2
F 19 1 scg1_hnf_cal_bit_override
DESC Configuration to choose LSB/MSB bit to override Device ID for HTG 1 1'b0: Hash MSB bit to override Device ID 1'b1: Hash LSB bit to override Device ID
F 17 1 scg1_hnf_cal_type
DESC Enables type of HN CAL for HTG 1 1'b0: CAL2 mode 1'b1: CAL4 mode
F 16 1 scg1_hnf_cal_mode_en
DESC Enables support for HN CAL for HTG 1
F 3 1 scg0_hnf_cal_bit_override
DESC Configuration to choose LSB/MSB bit to override Device ID for HTG 0 1'b0: Hash MSB bit to override Device ID 1'b1: Hash LSB bit to override Device ID
F 1 1 scg0_hnf_cal_type
DESC Enables type of HN CAL for HTG 0 1'b0: CAL2 mode 1'b1: CAL4 mode
