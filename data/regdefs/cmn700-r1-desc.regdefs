R 0x2000 64 - - por_ccg_ra_pmu_event_sel
RESET 0x0 0xf7f7f7f7f
DESC Specifies the PMU event to be counted.
F 0 7 pmu_event0_id
DESC CXRA PMU Event 0 ID 7'h00: No event 7'h41: Request Tracker (RHT) occupancy count overflow 7'h42: Snoop Tracker (SHT) occupancy count overflow 7'h43: Read Data Buffer (RDB) occupancy count overflow 7'h44: Write Data Buffer (WDB) occupancy count overflow 7'h45: Snoop Sink Buffer (SSB) occupancy count overflow 7'h46: CCIX RX broadcast snoops 7'h47: CCIX TX request chain 7'h48: CCIX TX request chain average length 7'h49: CHI internal RSP stall 7'h4A: CHI internal DAT stall 7'h4B: CCIX REQ Protocol credit Link 0 stall 7'h4C: CCIX REQ Protocol credit Link 1 stall 7'h4D: CCIX REQ Protocol credit Link 2 stall 7'h4E: CCIX DAT Protocol credit Link 0 stall 7'h4F: CCIX DAT Protocol credit Link 1 stall 7'h50: CCIX DAT Protocol credit Link 2 stall 7'h51: CHI external RSP stall 7'h52: CHI external DAT stall 7'h53: CCIX MISC Protocol credit Link 0 stall 7'h54: CCIX MISC Protocol credit Link 1 stall 7'h55: CCIX MISC Protocol credit Link 2 stall 7'h56: Request Tracker (RHT) allocations 7'h57: Snoop Tracker (SHT) allocations 7'h58: Read Data Buffer (RDB) allocations 7'h59: Write Data Buffer (WDB) allocations 7'h5A: Snoop Sink Buffer (SSB) allocations
F 8 7 pmu_event1_id
DESC CXRA PMU Event 1 ID; see pmu_event0_id for encodings
F 16 7 pmu_event2_id
DESC CXRA PMU Event 2 ID; see pmu_event0_id for encodings
F 24 7 pmu_event3_id
DESC CXRA PMU Event 3 ID; see pmu_event0_id for encodings
F 32 4 pmu_occup1_id
DESC PMU occupancy event selector ID
ENDGROUP
GROUP por_ccla_registers
BASE 0x0
RANGE 0x10000
R 0x0 64 RO - por_ccla_node_info
RESET 0x105 0xffffffffffff
DESC Provides component identification information.
F 0 16 node_type
DESC CMN-600 node type identifier
F 16 16 node_id
DESC Component CHI node ID
PAR NODEID_PARAM
F 32 16 logical_id
DESC Component logical ID
PAR LOGICALID_PARAM
R 0x80 64 RO - por_ccla_child_info
RESET 0x0 0xffffffff
DESC Provides component child identification information.
F 0 16 child_count
DESC Number of child nodes; used in discovery process
F 16 16 child_ptr_offset
DESC Starting register offset which contains pointers to the child nodes
R 0x910 64 RO - por_ccla_unit_info
RESET 0x0 0xffff801fff
DESC Provides component identification information for CCLA.
F 0 1 ccix_present
DESC Option to generate CCIX support over CXS
PAR CCLA_CCIX_PRESENT_PARAM
F 1 1 cxl_present
DESC Option to generate CXL support over CXS
PAR CCLA_CXL_PRESENT_PARAM
F 2 1 rx_stl_ram_parity_gen
DESC Option to generate parity bits for the RX STL buffer
PAR CCLA_RX_STL_RAM_PARITY_GEN_PARAM
F 3 10 rx_stl_buffer_depth
DESC Depth of CCL stalling channel RX buffer for CXS RSP with data messages
PAR CCLA_RX_STL_BUFFER_DEPTH_PARAM
F 23 1 ccla_portfwd_en
DESC Port forwarding is enabled at this CCLA port
PAR CCLA_PORTFWD_EN_PARAM
F 24 8 portfwd_static_crds
DESC Number of static credits granted by this CCLA port for port forwarded traffic
PAR CCLA_PORTFWD_NUM_STATIC_TXBUF_PARAM
F 32 8 portfwd_dynamic_crds
DESC Number of dynamic credits granted by this CCLA port for port forwarded traffic
PAR CCLA_PORTFWD_NUM_DYNAMIC_TXBUF_PARAM
R 0x988 64 - S por_ccla_secure_register_groups_override
RESET 0x0 0xfd
DESC Allows non-secure access to predefined groups of secure registers.
F 0 1 cfg_ctl
DESC Allows non-secure access to secure configuration control register
F 2 1 linkid_ctl
DESC Allows non-secure access to secure LA Link ID registers
F 3 1 portid_ctl
DESC Allows non-secure access to secure LA Port ID registers
F 4 1 cxllink_ctl
DESC Allows non-secure access to secure CXL link layer registers
F 5 1 ull_ctl
DESC Allows non-secure access to secure upper link layer control registers
F 6 1 cxlerrinj_ctl
DESC Allows non-secure access to secure CXL error injection registers
F 7 1 ras_secure_access_override
DESC Allow non-secure access to secure RAS registers
R 0xb00 64 - S por_ccla_cfg_ctl
RESET 0x49001c 0x1ff003f
DESC Functions as the configuration control register for CCLA.
SGO por_ccla_secure_register_groups_override.cfg_ctl
F 0 1 la_cxl_mode_en
DESC  When set enables CXL mode
F 1 1 la_device_mode_en
DESC Enable the Device mode, by default set to Host mode
F 2 2 cxl_type
DESC  Used to program CXL Type 2'b00: Reserved 2'b01: Type1 2'b10: Type2 2'b11: Type3
F 4 1 cxl_mem_en
DESC Enable CXL .mem mode, by default is enabled
F 5 1 cxl_cache_en
DESC Enable CXL .cache mode, by default is disabled
F 16 3 link0_weight
DESC Determines weight of link0 in CCL linkend arbitration
F 19 3 link1_weight
DESC Determines weight of link1 in CCL linkend arbitration
F 22 3 link2_weight
DESC Determines weight of link2 in CCL linkend arbitration
R 0xb08 64 - S por_ccla_aux_ctl
RESET 0x1220000000006 0x7770000000007
DESC Functions as the auxiliary control register for CCLA.
F 0 1 cg_disable
DESC Disables CCLA architectural clock gates
F 1 1 disable_byteen_parity_err
DESC Disables CCLA RX RAM byte enable parity errors
F 2 1 disable_viral_err_report
DESC When set, disables viral error reporting through CMN's error reporting mechanism
F 40 3 crdgnt_crd_count_th
DESC Maximum number of protocol credits (i.e. Req, Dat, Snp..) that need to be accumulated to send a credit grant message 3'b000: 16 credits 3'b001: 32 credits 3'b010: 64 credits 3'b011: 128 credits
F 44 3 crdgnt_cycle_count_th
DESC Maximum number of cycles that need to be elapsed since previous piggyback credits were sent, to send a protocol (Req, Dat, Snp..) credit grant message 3'b000: 32 cycles 3'b001: 64 cycles 3'b010: 128 cycles 3'b011: 256 cycles
F 48 3 lcrdgnt_cycle_count_th
DESC Maximum number of cycles that need to be elapsed since previous piggyback credits were sent, to send a link credit grant message 3'b000: 8  cycles 3'b001: 16 cycles 3'b010: 32 cycles 3'b011: 64 cycles
R 0xc00 64 RO S por_ccla_ccix_prop_capabilities
RESET 0x9 0x3f
DESC Contains CCIX-supported properties.
F 0 1 nocompack
DESC No CompAck supported 1'b0: False 1'b1: True
F 1 1 partialcachestates
DESC Partial cache states supported 1'b0: False 1'b1: True
F 2 1 cachelinesize
DESC Cacheline size supported 1'b0: 64B 1'b1: 128B
F 3 3 addrwidth
DESC Address width supported 3'b000: 48b 3'b001: 52b 3'b010: 56b 3'b011: 60b 3'b100: 64b
R 0xc08 64 RO S por_ccla_cxs_attr_capabilities
RESET 0x1 0x4ccffcf33
DESC Contains CXS supported attributes.
F 0 2 cxsdataflitwidth
DESC CXS data flit width supported 2'b00: 256b 2'b01: 512b 2'b10: 1024b
F 4 2 cxsmaxpktperflit
DESC CXS maximum packets per flit supported 2'b00: 2 2'b01: 3 2'b10: 4
PAR CCLA_CXS_MAX_PKT_PER_FLIT_PARAM
F 8 1 cxscontinuousdata
DESC CXS continuous data supported 1'b0: False 1'b1: True
PAR CCLA_CXS_CONTINUOUS_DATA_PARAM
F 9 1 cxserrorfullpkt
DESC CXS error full packet supported 1'b0: False 1'b1: True
PAR CCLA_CXS_ERROR_FULL_PKT_PARAM
F 10 2 cxsdatacheck
DESC CXS datacheck supported 2'b00: None 2'b01: Parity 2'b10: SECDED
PAR CCLA_CXS_DATACHECK_PARAM
F 14 8 cxscntlwidth
DESC Width of CXS TX/RX control
PAR CCLA_CXS_CNTL_WIDTH_PARAM
F 22 2 cxsprcltypewidth
DESC Width of CXS TX/RX control
PAR CCLA_CXS_PRCLTYPE_WIDTH_PARAM
F 26 2 cxslinkcontrol
DESC Set to Explicit Credit Return.
PAR CCLA_CXS_LINKCONTROL_PARAM
F 30 2 cxsprotocoltype
DESC CXS Protocol type signal is supported
PAR CCLA_CXS_PROTOCOL_TYPE_PARAM
F 34 1 cxslast
DESC CXS LAST signal is supported
PAR CCLA_CXS_LAST_PARAM
