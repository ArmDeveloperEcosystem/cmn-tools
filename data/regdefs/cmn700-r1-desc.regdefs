DESC Controls access modes for TC data and TC Control debug read.
SGO por_mtu_secure_register_groups_override.tc_dbgrd
F 0 13 tc_access_set
DESC Set address for TC debug read access
F 16 4 tc_access_way
DESC Way address for TC debug read access
F 20 3 tc_access_dw
DESC 64-bit chunk address for TC data debug read access
F 24 2 tc_access_component
DESC Specifies TC Data/Control array debug read 2'b01: TC data read 2'b10: TC control read
R 0xb88 64 RO S por_mtu_tc_cache_access_tc_ctl
RESET 0x0 0xffffffffffffffff
DESC Contains TC Control debug read data bits
SGO por_mtu_secure_register_groups_override.tc_dbgrd
F 0 64 tc_cache_access_tc_control
DESC TC Control debug read data
R 0xb98 64 RO S por_mtu_tc_cache_access_tc_data
RESET 0x0 0xffffffffffffffff
DESC Contains TC data RAM debug read data.
SGO por_mtu_secure_register_groups_override.tc_dbgrd
F 0 64 tc_cache_access_tc_data
DESC TC data RAM debug read data
R 0x2000 64 - - por_mtu_pmu_event_sel
RESET 0x0 0x3f3f3f3f
DESC Specifies the PMU event to be counted.
F 0 6 pmu_event0_id
DESC MTU PMU Event 0 select 6'h00: No event 6'h01: PMU_MTU_TC_LOOKUP_EVENT; Count total cache lookup requests. 6'h02: PMU_MTU_TC_FILL_EVENT; Count total number of tag cache allocation (Dirty or Clean) requests. 6'h03; PMU_MTU_TC_MISS_EVENT; Count total cache miss responses. 6'h04; PMU_MTU_TDB_FORWARD_EVENT: Count total number of requests that got TDB forwarded data. 6'h05; PMU_MTU_TCQ_HAZARD_EVENT: Count number of incoming requests hazarding againt pending TCQ requests. 6'h06; PMU_MTU_TCQ_RD_ALLOC_EVENT; Count number of read requests allocated in TCQ. This includes Read & Write_Match. 6'h07; PMU_MTU_TCQ_WR_ALLOC_EVENT; Count number of write requests allocated in TCQ. This includes Write_Update. 6'h08; PMU_MTU_TCQ_CMO_ALLOC_EVENT; Count number of CMO requests allocated in TCQ. This includes CMOs & wr+CMO. 6'h09; PMU_MTU_AXI_RD_REQ_EVENT; Count number of read requests sent out on AXI. 6'h0A; PMU_MTU_AXI_WR_REQ_EVENT; Count number of write requests sent out on AXI. 6'h0B; PMU_MTU_TCQ_OCCUPANCY_CNT_OVERFLOW_EVENT; TCQ tracker occupancy count overflow. 6'h0C; PMU_MTU_TDB_OCCUPANCY_CNT_OVERFLOW_EVENT; TDB occupancy count overflow. NOTE: All other encodings are reserved.
F 8 6 pmu_event1_id
DESC MTU PMU Event 1 select; see pmu_event0_id for encodings
F 16 6 pmu_event2_id
DESC MTU PMU Event 2 select; see pmu_event0_id for encodings
F 24 6 pmu_event3_id
DESC MTU PMU Event 3 select; see pmu_event0_id for encodings
R 0x3000 64 RO S por_mtu_errfr
RESET 0x48a1 0x7cff
DESC Functions as the error feature register.
SGO por_mtu_secure_register_groups_override.ras_secure_access_override
F 0 2 ED
DESC Error detection 2'b00: Feature not supported 2'b01: Feature always enabled 2'b10: Feature is controllable 2'b11: Reserved
F 2 2 DE
DESC Deferred errors
F 4 2 UI
DESC Uncorrected error interrupt
F 6 2 FI
DESC Fault handling interrupt
F 10 2 CFI
DESC Corrected error interrupt
F 12 3 CEC
DESC Standard corrected error count mechanism 3'b000: Does not implement standardized error counter model 3'b010: Implements 8-bit error counter in por_mtu_errmisc[39:32] 3'b100: Implements 16-bit error counter in por_mtu_errmisc[47:32]
R 0x3008 64 - S por_mtu_errctlr
RESET 0x0 0x10f
DESC Functions as the error control register. Controls whether specific error-handling interrupts and error detection/deferment are enabled.
SGO por_mtu_secure_register_groups_override.ras_secure_access_override
F 0 1 ED
DESC Enables error detection as specified in por_mtu_errfr.ED
F 1 1 DE
DESC Enables error deferment as specified in por_mtu_errfr.DE
F 2 1 UI
DESC Enables uncorrected error interrupt as specified in por_mtu_errfr.UI
F 3 1 FI
DESC Enables fault handling interrupt for all detected deferred errors as specified in por_mtu_errfr.FI
F 8 1 CFI
DESC Enables corrected error interrupt as specified in por_mtu_errfr.CFI
R 0x3010 64 - S por_mtu_errstatus
RESET 0x0 0xed800000
DESC Functions as the error status register. AV and MV bits must be cleared in the same cycle, otherwise the error record does not have a consistent view.
SGO por_mtu_secure_register_groups_override.ras_secure_access_override
F 31 1 AV W1C
DESC Address register valid; writes to this bit are ignored if any of the UE, DE, or CE bits are set to 1, and the highest priority are not cleared to 0 in the same write; write a 1 to clear 1'b1: Address is valid; por_mtu_erraddr contains a physical address for that recorded error 1'b0: Address is not valid
F 30 1 V W1C
DESC Register valid; writes to this bit are ignored if any of the UE, DE, or CE bits are set to 1, and are not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one error recorded; register is valid 1'b0: No errors recorded
F 29 1 UE W1C
DESC Uncorrected errors; writes to this bit are ignored if the OF bit is set to 1, and is not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one error detected that is not corrected and is not deferred to a slave 1'b0: No uncorrected errors detected
F 27 1 OF W1C
DESC Overflow; asserted when multiple errors of the highest priority type are detected; write a 1 to clear 1'b1: More than one error detected 1'b0: Only one error of the highest priority type detected as described by UE/DE/CE fields
F 26 1 MV W1C
DESC por_mtu_errmisc valid; writes to this bit are ignored if any of the UE, DE, or CE bits are set to 1, and the highest priority are not cleared to 0 in the same write; write a 1 to clear 1'b1: Miscellaneous registers are valid 1'b0: Miscellaneous registers are not valid
F 24 1 CE W1C
DESC Corrected errors; writes to this bit are ignored if the OF bit is set to 1, and is not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one transient corrected error recorded 1'b0: No corrected errors recorded
F 23 1 DE W1C
DESC Deferred errors; writes to this bit are ignored if the OF bit is set to 1, and is not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one error is not corrected and is deferred 1'b0: No errors deferred
R 0x3018 64 - S por_mtu_erraddr
RESET 0x0 0x800fffffffffffff
DESC Contains the error record address.
SGO por_mtu_secure_register_groups_override.ras_secure_access_override
F 0 52 ADDR
DESC Transaction address for Data Request (Data PA). Same PA received from HN. Note: For Errors on TC evictions, this represents address that caused eviction. Note: Address is undefined if errmisc.OPTYPE is Other. For most part, these transactions are set/way based and not PA based.
F 63 1 NS
DESC Security status of transaction 1'b1: Non-secure transaction 1'b0: Secure transaction CONSTRAINT: por_mtu_erraddr.NS is redundant. Since it is writable, it cannot be used for logic qualification.
R 0x3020 64 - S por_mtu_errmisc
RESET 0x0 0xdfffffff0003000f
DESC Functions as the miscellaneous error register. Contains miscellaneous information about deferred/uncorrected errors.
SGO por_mtu_secure_register_groups_override.ras_secure_access_override
F 0 4 ERRSRC
DESC Error source 4'b0001: Data single-bit ECC 4'b0010: Data double-bit ECC 4'b0011: Single-bit ECC overflow 4'b0101: Control single-bit ECC 4'b0110: Control double-bit ECC 4'b1000: AXI AR Slave Error 4'b1001: AXI AR Decode Error 4'b1010: AXI AR Poison Error 4'b1011: AXI AR Datachk Error 4'b1100: AXI W Slave Error 4'b1101: AXI W Decode Error 4'b1110: PA out of range Error
F 16 2 OPTYPE
DESC Error opcode type 2'b00: Read Type (RD_NO_SNP, PrefetchTgt) 2'b01: Write (WR_NO_SNP) 2'b10: CMO, WR+CMO 2'b11: Other
F 32 16 CEC
DESC Corrected ECC error count
F 48 13 ERRSET
DESC TC set address for ECC Single bit error
F 62 1 SETMATCH
DESC Set address match
F 63 1 CECOF
DESC Corrected error counter overflow
R 0x3030 64 - S por_mtu_err_inj
RESET 0x0 0x3fffffffffffff
DESC Enables error injection and setup. When enabled for a given PA and NS bit, MTU returns an error interrupt which emulates a TC double-bit data ECC error. This feature enables software to test the error handler. The error is reported for cacheable read access with Tag Op Transfer for which TC hit. No error is reported for cacheable read access for which TC miss.
F 0 1 mtu_err_inj_en
DESC Enables error injection and report
F 1 52 mtu_err_inj_addr
DESC Physical Address used to match for error injection
F 53 1 mtu_err_inj_addr_ns
DESC Address NS used to match for error injection
R 0x3100 64 RO - por_mtu_errfr_NS
RESET 0x48a1 0x7cff
DESC Functions as the non-secure error feature register.
F 0 2 ED
DESC Error detection 2'b00: Feature not supported 2'b01: Feature always enabled 2'b10: Feature is controllable 2'b11: Reserved
F 2 2 DE
DESC Deferred errors
F 4 2 UI
DESC Uncorrected error interrupt
F 6 2 FI
DESC Fault handling interrupt
F 10 2 CFI
DESC Corrected error interrupt
F 12 3 CEC
DESC Standard corrected error count mechanism 3'b000: Does not implement standardized error counter model 3'b010: Implements 8-bit error counter in por_mtu_errmisc_NS[39:32] 3'b100: Implements 16-bit error counter in por_mtu_errmisc_NS[47:32]
R 0x3108 64 - - por_mtu_errctlr_NS
RESET 0x0 0x10f
DESC Functions as the non-secure error control register. Controls whether specific error-handling interrupts and error detection/deferment are enabled.
F 0 1 ED
DESC Enables error detection as specified in por_mtu_errfr_NS.ED
F 1 1 DE
DESC Enables error deferment as specified in por_mtu_errfr_NS.DE
F 2 1 UI
DESC Enables uncorrected error interrupt as specified in por_mtu_errfr_NS.UI
F 3 1 FI
DESC Enables fault handling interrupt for all detected deferred errors as specified in por_mtu_errfr_NS.FI
F 8 1 CFI
DESC Enables corrected error interrupt as specified in por_mtu_errfr_NS.CFI
R 0x3110 64 - - por_mtu_errstatus_NS
RESET 0x0 0xed800000
DESC Functions as the non-secure error status register.
F 31 1 AV W1C
DESC Address register valid; writes to this bit are ignored if any of the UE, DE, or CE bits are set to 1, and the highest priority are not cleared to 0 in the same write; write a 1 to clear 1'b1: Address is valid; por_mtu_erraddr_NS contains a physical address for that recorded error 1'b0: Address is not valid
F 30 1 V W1C
DESC Register valid; writes to this bit are ignored if any of the UE, DE, or CE bits are set to 1, and are not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one error recorded; register is valid 1'b0: No errors recorded
F 29 1 UE W1C
DESC Uncorrected errors; writes to this bit are ignored if the OF bit is set to 1, and is not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one error detected that is not corrected and is not deferred to a slave 1'b0: No uncorrected errors detected
F 27 1 OF W1C
DESC Overflow; asserted when multiple errors of the highest priority type are detected; write a 1 to clear 1'b1: More than one error detected 1'b0: Only one error of the highest priority type detected as described by UE/DE/CE fields
F 26 1 MV W1C
DESC por_mtu_errmisc_NS valid; writes to this bit are ignored if any of the UE, DE, or CE bits are set to 1, and the highest priority are not cleared to 0 in the same write; write a 1 to clear 1'b1: Miscellaneous registers are valid 1'b0: Miscellaneous registers are not valid
F 24 1 CE W1C
DESC Corrected errors; writes to this bit are ignored if the OF bit is set to 1, and is not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one transient corrected error recorded 1'b0: No corrected errors recorded
F 23 1 DE W1C
DESC Deferred errors; writes to this bit are ignored if the OF bit is set to 1, and is not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one error is not corrected and is deferred 1'b0: No errors deferred
R 0x3118 64 - - por_mtu_erraddr_NS
RESET 0x0 0x800fffffffffffff
DESC Contains the non-secure error record address.
F 0 52 ADDR
DESC Transaction address for Data Request (Data PA). Same PA received from HN. Note: For Errors on TC evictions, this represents address that caused eviction. Note: Address is undefined if errmisc.OPTYPE is Other. For most part, these transactions are set/way based and not PA based.
F 63 1 NS
DESC Security status of transaction 1'b1: Non-secure transaction 1'b0: Secure transaction CONSTRAINT: por_mtu_erraddr_NS.NS is redundant. Since it is writable, it cannot be used for logic qualification.
R 0x3120 64 - - por_mtu_errmisc_NS
RESET 0x0 0xdfffffff0003000f
DESC Functions as the non-secure miscellaneous error register. Contains miscellaneous information about deferred/uncorrected errors.
F 0 4 ERRSRC
DESC Error source 4'b0001: Data single-bit ECC 4'b0010: Data double-bit ECC 4'b0011: Single-bit ECC overflow 4'b0101: Control single-bit ECC 4'b0110: Control double-bit ECC 4'b1000: AXI AR Slave Error 4'b1001: AXI AR Decode Error 4'b1010: AXI AR Poison Error 4'b1011: AXI AR Datachk Error 4'b1100: AXI W Slave Error 4'b1101: AXI W Decode Error 4'b1110: PA out of range Error
F 16 2 OPTYPE
DESC Error opcode type 2'b00: Read Type (RD_NO_SNP, PrefetchTgt) 2'b01: Write (WR_NO_SNP) 2'b10: CMO, WR+CMO 2'b11: Other op types
F 32 16 CEC
DESC Corrected ECC error count
F 48 13 ERRSET
DESC TC set address for ECC Single bit error
F 62 1 SETMATCH
DESC Set address match
F 63 1 CECOF
DESC Corrected error counter overflow
ENDGROUP
GROUP por_mxp_registers
BASE 0x0
RANGE 0x10000
R 0x0 64 RO - por_mxp_node_info
RESET 0x2000000000006 0xfffffffffffff
DESC Provides component identification information.
F 0 16 node_type
DESC CMN-600 node type identifier
F 16 16 xy_id
DESC Identifies (X,Y) location of XP within the mesh NOTE: The (X,Y) location is specified following the node ID format as defined in Node ID mapping section, with the bottom 3 bits, corresponding to port ID and device ID, set to 0. Bits 31:11 must always be set to 0. The range of bits representing the (X,Y) location varies for different node ID formats.
F 32 16 logical_id
DESC Component logical ID
PAR LOGICALID_PARAM
F 48 4 num_device_port
DESC Number of device ports attached to the MXP. Mesh config = (1x1)? Max. of 6 Device Ports are supported : Max. of 4 Device Ports are supported
PAR MXP_NUM_DEV_PORT_PARAM
R 0x8 64 RO - por_mxp_device_port_connect_info_p0
RESET 0x0 0xffff0f9f
