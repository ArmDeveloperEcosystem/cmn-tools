F 0 64 valid
DESC Specifies whether the Port ID is valid; bit number corresponds to logical Agent ID number (from 0 to 63)
R 0xd78 64 V S por_ccla_portfwd_ctl
RESET 0x0 0xffff0000ffff
DESC Functions as the Port-to-Port forwarding control register. Works with por_ccla_portfwd_status.
F 0 16 port_fwd_en
DESC Bit vector, where each bit represents logical PortID of a Port (CXG) present on CMN. Each bit when set, enables Port-to-Port forwarding with the corresponding port. 1'b0: Port-to-Port forwarding is disabled 1'b1: Port-to-Port forwarding  is enabled
F 32 16 port_fwd_req
DESC Bit vector, where each bit represents logical PortID of a Port (CXG) present on CMN. Each bit is used to control the communication channel with the corresponding port. 1'b0: Port-to-Port forwarding channel de-activate request 1'b1: Port-to-Port forwarding channel activate  request
R 0xd80 64 ROV S por_ccla_portfwd_status
RESET 0x0 0xffff
DESC Functions as the Port-to-Port forwarding status register. Works with por_ccla_portfwd_ctl.
F 0 16 port_fwd_ack
DESC Bit vector, where each bit represents logical PortID of a Port (CXG) present on CMN. Each bit represents the status of the port-to-port control request sent to the corresponding port. 1'b0: Port-to-Port forwarding channel is de-active. 1'b1: Port-to-Port forwarding channel is active
R 0xe00 64 V S por_ccla_cxl_link_rx_credit_ctl
RESET 0x0 0x3ffffffffffff
DESC CXL Link Rx Credit Control Register
SGO por_ccla_secure_register_groups_override.cxllink_ctl
F 0 10 cache_req_credits
DESC Credits to advertise for Cache Request channel at init
F 10 10 cache_rsp_credits
DESC Credits to advertise for Cache Response channel at init
F 20 10 cache_data_credits
DESC Credits to advertise for Cache Data channel at init
F 30 10 mem_req_rsp_credits
DESC Credits to advertise for Mem Request or Response channel at init
PAR CCG_RA_NUM_REQS_PARAM
F 40 10 mem_data_credits
DESC Credits to advertise for Mem Data channel at init
PAR CCLA_RX_STL_BUFFER_DEPTH_PARAM
R 0xe08 64 ROV S por_ccla_cxl_link_rx_credit_return_stat
RESET 0x0 0x3ffffffffffff
DESC CXL Link Rx Credit Return Status Register
SGO por_ccla_secure_register_groups_override.cxllink_ctl
F 0 10 cache_req_credits
DESC Running snapshot of accumulated Cache Request credits to be returned
F 10 10 cache_rsp_credits
DESC Running snapshot of accumulated Cache Response credits to be returned
F 20 10 cache_data_credits
DESC Running snapshot of accumulated Cache Data credits to be returned
F 30 10 mem_req_rsp_credits
DESC Running snapshot of accumulated Mem Request or Response credits to be returned
F 40 10 mem_data_credits
DESC Running snapshot of accumulated Mem Data credits to be returned
R 0xe10 64 ROV S por_ccla_cxl_link_tx_credit_stat
RESET 0x0 0x3ffffffffffff
DESC CXL Link Tx Credit Status Register
SGO por_ccla_secure_register_groups_override.cxllink_ctl
F 0 10 cache_req_credits
DESC Running snapshot of accumulated Cache Request credits for TX
F 10 10 cache_rsp_credits
DESC Running snapshot of accumulated Cache Response credits for TX
F 20 10 cache_data_credits
DESC Running snapshot of accumulated Cache Data credits for TX
F 30 10 mem_req_rsp_credits
DESC Running snapshot of accumulated Mem Request or Response credits for TX
F 40 10 mem_data_credits
DESC Running snapshot of accumulated Mem Data credits for TX
R 0xe18 64 - S por_ccla_cxl_link_layer_defeature
RESET 0x0 0x1
DESC CXL Link Layer Defeature Register
SGO por_ccla_secure_register_groups_override.cxllink_ctl
F 0 1 disable_mdh
DESC Write 1 to disable MDH. Software needs to ensure it programs this value consistently on the UP & DP. After programming, a warm reset is required for the disable to take effect.
R 0xe20 64 - S por_ccla_ull_ctl
RESET 0x0 0x3
DESC Upper Link Layer Control Register
SGO por_ccla_secure_register_groups_override.ull_ctl
F 0 1 send_vd_init
DESC Used to send VD Init message. Must only be used for direct ULL to ULL connection. Must be used along with Tx ULL state (tx_ull_state) status bit 1'b0: When clear and tx_ull_state is in run_state, sends VD.De-activate flit. 1'b1: When set and tx_ull_state is in stop state, sends VD.Activate flit.
F 1 1 ull_to_ull_en
DESC Used to enable ULL-to_ULL mode. Must be set on both sides of the link before 'send_vd_init' is set on either side 1'b0: When clear, ull-to-ull mode is disabled. 1'b1: When set, ull-to-ull mode is enabled.
R 0xe28 64 RO S por_ccla_ull_status
RESET 0x0 0x3
DESC Upper Link Layer Status Register
SGO por_ccla_secure_register_groups_override.ull_ctl
F 0 1 tx_ull_state
DESC Reflects the Tx ULL state . 1'b0: Tx ULL is in Stop state 1'b1: Tx ULL is in Run state 
F 1 1 rx_ull_state
DESC Reflects the Rx ULL state . 1'b0: Rx ULL is in Stop state 1'b1: Rx ULL is in Run state 
R 0xe30 64 - S por_ccla_cxl_ll_errinject_ctl
RESET 0x0 0x5
DESC CXL .cache .mem Link Layer Error Injection Control Register
SGO por_ccla_secure_register_groups_override.cxlerrinj_ctl
F 0 1 CachePoisonInjectionStart
DESC Software writes 0x1 to this bit to trigger a single poison injection on a CXL.cache message in the Tx direction. Hardware must override the poison field in the data header slot ofthe corresponding message (D2H if device, H2D if Host). This bit is required only if CXL.cache protocol issupported.
F 2 1 MemPoisonInjectionStart
DESC Software writes 0x1 to this bit to trigger a single poison injection on a CXL.mem message in the Tx direction. Hardware must override the poison field in the data header slot ofthe corresponding message (DRS if device, RwD if Host). This bit is required only if CXL.mem protocol issupported.
R 0xe38 64 RO S por_ccla_cxl_ll_errinject_stat
RESET 0x0 0xa
DESC CXL .cache .mem Link Layer Error Injection Status Register
SGO por_ccla_secure_register_groups_override.cxlerrinj_ctl
F 1 1 CachePoisonInjectionBusy
DESC Hardware loads 1 to this bit when the Start bit is written. Hardware must clear this bit to indicate that it has indeed finished poisoning a packet. Software is permitted to poll on this bit to find out when hardware has finished poison injection. This bit is required only if CXL.cache protocol issupported.
F 3 1 MemPoisonInjectionBusy
DESC Hardware loads 1 to this bit when the Start bit is written. Hardware must clear this bit to indicate that it has indeed finished poisoning a packet. Software is permitted to poll on this bit to find out when hardware has finished poison injection. This bit is required only if CXL.mem protocol issupported.
R 0x2008 64 - - por_ccla_pmu_event_sel
RESET 0x0 0x7f7f7f7f
DESC Specifies the PMU event to be counted.
F 0 7 pmu_event0_id
DESC CCLA PMU Event 0 ID 7'h00: No event 7'h21: LA_RX_CXS : number of RX CXS beats 7'h22: LA_TX_CXS : number of TX CXS beats 7'h23: LA_RX_CXS_AVG_SIZE : average size of RX CXS beats 7'h24: LA_TX_CXS_AVG_SIZE : average size of TX CXS beats 7'h25: LA_TX_CXS_LCRD_BACKPRESSURE : CXS backpressue due to lack of CXS credits 7'h26: LA_LINK_CRDBUF_OCC : CCLA RX RAM buffer occupany 7'h27: LA_LINK_CRDBUF_ALLOC: CCLA RX RAM buffer allocation 
F 8 7 pmu_event1_id
DESC CCLA PMU Event 1 ID; see pmu_event0_id for encodings
F 16 7 pmu_event2_id
DESC CCLA PMU Event 2 ID; see pmu_event0_id for encodings
F 24 7 pmu_event3_id
DESC CCLA PMU Event 3 ID; see pmu_event0_id for encodings
R 0x3000 64 RO S por_ccla_errfr
RESET 0xa5 0x7cff
DESC Functions as the error feature register.
SGO por_ccla_secure_register_groups_override.ras_secure_access_override
F 0 2 ED
DESC Error detection
F 2 2 DE
DESC Deferred errors for data poison
F 4 2 UI
DESC Uncorrected error interrupt
F 6 2 FI
DESC Fault handling interrupt
F 10 2 CFI
DESC Corrected error interrupt
F 12 3 CEC
DESC Standard corrected error count mechanism 3'b000: Does not implement standardized error counter model 3'b010: Implements 8-bit error counter in por_ccla_errmisc[39:32] 3'b100: Implements 16-bit error counter in por_ccla_errmisc[47:32]
R 0x3008 64 - S por_ccla_errctlr
RESET 0x0 0x10f
DESC Functions as the error control register. Controls whether specific error-handling interrupts and error detection/deferment are enabled.
SGO por_ccla_secure_register_groups_override.ras_secure_access_override
F 0 1 ED
DESC Enables error detection as specified in por_ccla_errfr.ED
F 1 1 DE
DESC Enables error deferment as specified in por_ccla_errfr.DE
F 2 1 UI
DESC Enables uncorrected error interrupt as specified in por_ccla_errfr.UI
F 3 1 FI
DESC Enables fault handling interrupt for all detected deferred errors as specified in por_ccla_errfr.FI
F 8 1 CFI
DESC Enables corrected error interrupt as specified in por_ccla_errfr.CFI
R 0x3010 64 - S por_ccla_errstatus
RESET 0x0 0xed800000
DESC Functions as the error status register. AV and MV bits must be cleared in the same cycle, otherwise the error record does not have a consistent view.
SGO por_ccla_secure_register_groups_override.ras_secure_access_override
F 31 1 AV W1C
DESC Address register valid; writes to this bit are ignored if any of the UE, DE, or CE bits are set to 1, and the highest priority are not cleared to 0 in the same write; write a 1 to clear 1'b1: Address is valid; por_ccla_erraddr contains a physical address for that recorded error 1'b0: Address is not valid
F 30 1 V W1C
DESC Register valid; writes to this bit are ignored if any of the UE, DE, or CE bits are set to 1, and are not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one error recorded; register is valid 1'b0: No errors recorded
F 29 1 UE W1C
DESC Uncorrected errors; writes to this bit are ignored if the OF bit is set to 1, and is not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one error detected that is not corrected and is not deferred to a slave 1'b0: No uncorrected errors detected
F 27 1 OF W1C
DESC Overflow; asserted when multiple errors of the highest priority type are detected; write a 1 to clear 1'b1: More than one error detected 1'b0: Only one error of the highest priority type detected as described by UE/DE/CE fields
F 26 1 MV W1C
DESC por_ccla_errmisc valid; writes to this bit are ignored if any of the UE, DE, or CE bits are set to 1, and the highest priority are not cleared to 0 in the same write; write a 1 to clear 1'b1: Miscellaneous registers are valid 1'b0: Miscellaneous registers are not valid
F 24 1 CE W1C
DESC Corrected errors; writes to this bit are ignored if the OF bit is set to 1, and is not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one transient corrected error recorded 1'b0: No corrected errors recorded
F 23 1 DE W1C
DESC Deferred errors; writes to this bit are ignored if the OF bit is set to 1, and is not cleared to 0 in the same write; write a 1 to clear 1'b1: At least one error is not corrected and is deferred 1'b0: No errors deferred
R 0x3018 64 - S por_ccla_erraddr
RESET 0x0 0x800fffffffffffff
DESC Contains the error record address.
SGO por_ccla_secure_register_groups_override.ras_secure_access_override
F 63 1 NS
DESC Security status of transaction 1'b1: Non-secure transaction 1'b0: Secure transaction CONSTRAINT: por_ccla_erraddr.NS is redundant. Since it is writable, it cannot be used for logic qualification.
F 0 52 ADDR
DESC Transaction address
R 0x3020 64 - S por_ccla_errmisc
RESET 0x0 0x1ff0000000ffff7
DESC Functions as the miscellaneous error register. Contains miscellaneous information about deferred/uncorrected errors.
SGO por_ccla_secure_register_groups_override.ras_secure_access_override
F 4 16 SRCID
DESC CCIX RAID of the requestor or the snoop target
F 48 9 ERRSET
DESC RAM entry set address for parity error
F 0 3 ERRSRC
DESC Source of the parity error 3'b000: Read data buffer 0 3'b001: Read data buffer 1 3'b010: Write data buffer 0 3'b011: Write data buffer 1 3'b100: Passive Buffer 3'b101: CCLA Data RAM 3'b110: Rsvd 3'b111: CXL Viral
R 0x3100 64 RO - por_ccla_errfr_NS
RESET 0xa5 0x7cff
DESC Functions as the non-secure error feature register.
F 0 2 ED
DESC Error detection
F 2 2 DE
DESC Deferred errors for data poison
F 4 2 UI
DESC Uncorrected error interrupt
F 6 2 FI
DESC Fault handling interrupt
F 10 2 CFI
DESC Corrected error interrupt
F 12 3 CEC
DESC Standard corrected error count mechanism 3'b000: Does not implement standardized error counter model 3'b010: Implements 8-bit error counter in por_ccla_errmisc[39:32] 3'b100: Implements 16-bit error counter in por_ccla_errmisc[47:32]
R 0x3108 64 - - por_ccla_errctlr_NS
RESET 0x0 0x10f
DESC Functions as the non-secure error control register. Controls whether specific error-handling interrupts and error detection/deferment are enabled.
F 0 1 ED
DESC Enables error detection as specified in por_ccla_errfr.ED
F 1 1 DE
DESC Enables error deferment as specified in por_ccla_errfr.DE
F 2 1 UI
DESC Enables uncorrected error interrupt as specified in por_ccla_errfr.UI
F 3 1 FI
DESC Enables fault handling interrupt for all detected deferred errors as specified in por_ccla_errfr.FI
F 8 1 CFI
DESC Enables corrected error interrupt as specified in por_ccla_errfr.CFI
R 0x3110 64 - - por_ccla_errstatus_NS
RESET 0x0 0xed800000
