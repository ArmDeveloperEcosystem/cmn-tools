F 4 1 s2_mpam_ns
DESC Port S2 MPAM_NS value
F 8 9 s2_mpam_partid
DESC Port S2 MPAM_PARTID value
F 24 1 s2_mpam_pmg
DESC Port S2 MPAM_PMG value
R 0xa80 64 - S por_rni_s0_qos_control
RESET 0x0 0xff00ff
