GROUP por_ccg_ha_registers
BASE 0x0
RANGE 0x10000
R 0x0 64 RO - por_ccg_ha_node_info
RESET 0x104 0xffffffffffff
DESC Provides component identification information.
F 0 16 node_type
DESC CMN-600 node type identifier
F 16 16 node_id
DESC Component CHI node ID
PAR NODEID_PARAM
F 32 16 logical_id
DESC Component logical ID
PAR LOGICALID_PARAM
R 0x8 64 - S por_ccg_ha_id
RESET 0x0 0x3ff
DESC Contains the CCIX-assigned HAID.
F 0 10 ccix_haid
DESC CCIX HAID
R 0x80 64 RO - por_ccg_ha_child_info
RESET 0x0 0xffffffff
DESC Provides component child identification information.
F 0 16 child_count
DESC Number of child nodes; used in discovery process
F 16 16 child_ptr_offset
DESC Starting register offset which contains pointers to the child nodes
R 0x900 64 RO - por_ccg_ha_unit_info
RESET 0x404100802010100 0x7fffffffffffffff
DESC Provides component identification information for CXHA.
F 0 9 request_tracker_depth
DESC Depth of request tracker
PAR CCG_HA_NUM_REQS_PARAM
F 9 9 rdb_depth
DESC Depth of read data buffer
PAR CCG_HA_NUM_RDBUF_PARAM
F 18 9 wdb_depth
DESC Depth of write data buffer
PAR CCG_HA_NUM_WRBUF_PARAM
F 27 9 snoop_request_sinkbuffer_depth
DESC Depth of snoop request sink buffer; number of CHI SNP requests that can be sunk by CXHA
PAR CCG_HA_SSB_DEPTH_PARAM
F 36 9 snoop_tracker_depth
DESC Depth of snoop tracker; number of outstanding SNP requests on CCIX
PAR CCG_HA_NUM_SNPREQS_PARAM
F 45 9 snoop_databuffer_depth
DESC Depth of snoop data buffer
PAR CCG_HA_NUM_SNPBUF_PARAM
F 54 9 snoop_compack_hazbuf_depth
DESC Depth of CompAck snoop hazard buffer
PAR CCG_HA_CSHAZBUF_DEPTH_PARAM
R 0x908 64 RO - por_ccg_ha_unit_info2
RESET 0x180802040100 0x3ffffffffffff
DESC Provides additonal component identification information for CXHA.
F 0 10 req_pass_buff_depth
DESC Depth of REQ Passive Buffer
PAR CCG_HA_REQ_PASS_BUFF_DEPTH_PARAM
F 10 10 dat_pass_buff_depth
DESC Depth of DAT Passive Buffer
PAR CCG_HA_DAT_PASS_BUFF_DEPTH_PARAM
F 20 10 ha_rni_num_wr_reqs
DESC Number of HA_RNI outstanding write requests
PAR CCG_HA_RNID_NUM_WR_REQ_PARAM
F 30 10 ha_rni_num_rd_reqs
DESC Number of HA_RNI outstanding read requests
PAR CCG_HA_RNID_NUM_RD_REQ_PARAM
F 40 10 ha_rni_num_rd_bufs
DESC Number of HA_RNI read data buffers
PAR CCG_HA_RNID_NUM_RD_BUF_PARAM
R 0x980 64 - S por_ccg_ha_secure_register_groups_override
RESET 0x0 0xf
DESC Allows non-secure access to predefined groups of secure registers.
F 0 1 ldid_ctl
DESC Allows non-secure access to secure HA LDID registers
F 1 1 linkid_ctl
DESC Allows non-secure access to secure HA Link ID registers
F 2 1 mpam_ctl
DESC Allows non-secure access to secure HA MPAM override registers
F 3 1 cfg_ctl
DESC Allows non-secure access to secure HA config control registers
R 0xa00 64 - S por_ccg_ha_cfg_ctl
RESET 0x0 0x1f
DESC Functions as the configuration control register. Specifies the current mode.
SGO por_ccg_ha_secure_register_groups_override.cfg_ctl
F 0 1 qos_override_en
DESC QoS override en When set, QoS value on CHI side is driven from QoS override value in this register
F 1 4 qos_override
DESC QoS override value
R 0xa08 64 - S por_ccg_ha_aux_ctl
RESET 0x3c3008 0x3fff7f
DESC Functions as the auxiliary control register for CXHA.
F 0 1 cg_disable
DESC Disables clock gating when set
F 1 1 snoop_dataret_disable
DESC Disables setting data return for CCIX snoop requests for all CHI snoop opcodes
F 2 1 remote_chia_rnf_present
DESC Indicates existence of CHIA RN-F in system; HA uses this indication to send SnpToS or SnpToSC 1'b0: HA converts SnpShared, SnpClean, and SnpNotSharedDirty to SnpToSC 1'b1: HA converts SnpShared, SnpClean, and SnpNotSharedDirty to SnpToS
F 3 1 early_compack_en
DESC Early CompAck enable; enables sending early CompAck on CCIX for requests that require CompAck
F 4 1 disable_secure_access
DESC Converts all accesses to non-secure
F 5 1 disable_cg_flopen
DESC Disables enhanced flop enable control for dynamic power savings
F 6 1 disable_chic_dmt
DESC When set disables CHI-C style DMT
F 8 7 num_copyback_crds
DESC Controls the total number of Request/Data credits reserved for CopyBack Requests across all links Note: This should be less than the Write Data Buffer depth
F 15 1 spcl_copyback_crd_en
DESC When set enables sending special credits (from configured num_copyback_crds) for CopyBack Requests across all links
F 16 1 snpreq_copyback_haz_en
DESC When set enables Snoop-CopyBack hazarding at incoming Snoop Request pipe
F 17 1 passive_buf_force_ue
DESC When set, focres all DE's originating in Passive Buffer to be reported as UEs
F 18 2 max_nd_rspout_msgs
DESC Used to configure the maximum number of non-data response messages (Completions/GO/WritePulls) presented to CCLA's packing logic. 2'b00: one message 2'b01: two messages 2'b10: three messages 2'b11: four messages Note: The max is further limited by max allowed by the given protocol (CCIX2.0/CXL.mem/CXL.cache)
F 20 2 max_dat_rspout_msgs
DESC Used to configure the maximum number of response data messages (Read Data) presented to CCLA's packing logic. 2'b00: one message 2'b01: two messages 2'b10: three messages 2'b11: four messages Note: The max is further limited by max allowed by the given protocol (CCIX2.0/CXL.mem/CXL.cache)
R 0xa10 64 - S por_ccg_ha_mpam_control_link0
RESET 0x0 0x101ff11
DESC Controls MPAM override values on incoming CCIX Request in non-SMP mode for Link0
SGO por_ccg_ha_secure_register_groups_override.mpam_ctl
F 0 1 mpam_override_en0
DESC MPAM override en When set, MPAM value on CHI side is driven from MPAM override value in this register. Applicable only in non-SMP mode
F 4 1 mpam_ns0
DESC MPAM_NS value
F 8 9 mpam_partid0
DESC MPAM_PARTID value
F 24 1 mpam_pmg0
DESC MPAM_PMG value
R 0xa18 64 - S por_ccg_ha_mpam_control_link1
RESET 0x0 0x101ff11
DESC Controls MPAM override values on incoming CCIX Request in non-SMP mode for Link1
SGO por_ccg_ha_secure_register_groups_override.mpam_ctl
F 0 1 mpam_override_en1
DESC MPAM override en When set, MPAM value on CHI side is driven from MPAM override value in this register. Applicable only in non-SMP mode
F 4 1 mpam_ns1
DESC MPAM_NS value
F 8 9 mpam_partid1
DESC MPAM_PARTID value
F 24 1 mpam_pmg1
DESC MPAM_PMG value
R 0xa20 64 - S por_ccg_ha_mpam_control_link2
RESET 0x0 0x101ff11
DESC Controls MPAM override values on incoming CCIX Request in non-SMP mode for Link2
SGO por_ccg_ha_secure_register_groups_override.mpam_ctl
F 0 1 mpam_override_en2
DESC MPAM override en When set, MPAM value on CHI side is driven from MPAM override value in this register. Applicable only in non-SMP mode
F 4 1 mpam_ns2
DESC MPAM_NS value
F 8 9 mpam_partid2
DESC MPAM_PARTID value
F 24 1 mpam_pmg2
DESC MPAM_PMG value
R 0xc00 64 - S por_ccg_ha_rnf_exp_raid_to_ldid_reg_0
RESET 0x0 0xc1ffc1ffc1ffc1ff
DESC Specifies the mapping of Expanded RAID to RN-F LDID for Expanded RAIDs 0 to 3.
