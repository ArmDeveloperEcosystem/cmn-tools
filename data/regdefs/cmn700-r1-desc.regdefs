R 0x900 64 RO - por_info_global
RESET 0x4014000003303008 0xffff8fffffffffff
DESC Contains user-specified values of build-time global configuration parameters.
F 0 8 chi_req_rsvdc_width
DESC RSVDC field width in CHI REQ flit
PAR POR_CHIX_REQ_RSVDC_WIDTH_PARAM
F 8 8 chi_req_addr_width
DESC REQ address width
PAR POR_CHIX_REQ_ADDR_WIDTH_PARAM
F 16 8 physical_address_width
DESC Physical address width
PAR POR_PA_WIDTH_PARAM
F 24 1 datacheck_en
DESC Indicates whether datacheck feature is enabled for CHI DAT flit
PAR POR_DATACHECK_EN_PARAM
F 25 1 flit_parity_en
DESC Indicates whether parity checking is enabled in the transport layer on all flits sent on the interconnect
PAR POR_FLIT_PAR_EN_PARAM
F 26 10 num_remote_rnf
DESC Number of remote RN-F devices in the system when the CML feature is enabled
PAR POR_NUM_REMOTE_RNF_PARAM
F 36 8 rnsam_num_add_hashed_tgt
DESC Number of additional hashed target ID's supported by the RN SAM, beyond the local HNF count
PAR POR_RNSAM_NUM_ADD_HASHED_TGT_PARAM
F 47 1 meta_data_en
DESC Meta Data Preservation mode enable
PAR POR_RSVDC_METADATA_EN_PARAM
F 48 1 r2_enable
DESC CMN R2 feature enable
PAR POR_R2_ENABLE_PARAM
F 49 1 mpam_en
DESC MPAM enable
PAR POR_CHI_MPAM_ENABLE_PARAM
F 50 2 dat_vc_num
DESC Number of additional DAT channels internal to MXP. For inreased bandwidth, this parameter need to be set to 2
PAR POR_DAT_VC_NUM_PARAM
F 52 2 rsp_vc_num
DESC Number of additional RSP channels internal to MXP. For inreased bandwidth, this parameter need to be set to 2
PAR POR_RSP_VC_NUM_PARAM
F 54 5 xy_override_cnt
DESC Number of Src-Tgt pairs whose XY route path can be overriden
PAR POR_XY_OVERRIDE_CNT_PARAM
F 59 1 portfwd_en
DESC CCIX Port to Port Forwarding feature enable
PAR POR_PORTFWD_EN_PARAM
F 60 3 chix_ver
DESC CHIX Version Parameter: 2 -> CHIB, 3 -> CHIC, 4 -> CHID, 5 -> CHIE
PAR POR_CHIX_VER_PARAM
F 63 1 mxp_multiple_dtm_en
DESC Multiple DTMs feature enable. This is used if number of device ports on the XP is > 2
PAR POR_MXP_MULTIPLE_DTM_EN_PARAM
R 0x908 64 RO - por_info_global_1
RESET 0x24205 0x7fff1f
DESC Contains user-specified values of build-time global configuration parameters.
F 0 2 req_vc_num
DESC Number of additional REQ channels internal to MXP. For inreased bandwidth, this parameter need to be set to 2
PAR POR_REQ_VC_NUM_PARAM
F 2 2 snp_vc_num
DESC Number of additional SNP channels internal to MXP. For inreased bandwidth, this parameter need to be set to 2
PAR POR_SNP_VC_NUM_PARAM
F 4 1 mesh2x_def_sel
DESC Default ping-pong scheme selection for TGTID Lookup in 2xMESH
PAR POR_MESH_DEF_MESH_SEL_PARAM
F 8 1 rsvdc_lb_en
DESC RSVDC Loop Back Mode Enable
PAR POR_RSVDC_LB_EN_PARAM
F 9 3 rsvdc_lb_width
DESC RSVDC Loop Back Field Width
PAR POR_RSVDC_LB_WIDTH_PARAM
F 12 1 rsvdc_pbha_en
DESC RSVDC PBHA Mode Enable
PAR POR_RSVDC_PBHA_EN_PARAM
F 13 3 rsvdc_pbha_width
DESC RSVDC PBHA Field Width
PAR POR_RSVDC_PBHA_WIDTH_PARAM
F 16 3 rxbuf_num_entries_mcs
DESC RX Buffer Entries at upload interface of MCSX/MCSY
PAR POR_MCS_RXBUF_NUM_ENTRIES_PARAM
F 19 1 chi_mte_enable
DESC CHI MTE Feature Enable
