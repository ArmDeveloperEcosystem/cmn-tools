SGO por_ccla_scr.c2c_cfg
F 0 16 version
DESC Version of the Logical Link End register block. Version value is 0h for this version of the spec.
F 16 16 length
DESC Length in bytes of this register block. 
R 0xf780 64 - ROOT por_ccla_c2c_logical_linkend_0_control_and_status
RESET 0x2 0x3ffffffffffff
DESC C2C Port ID route table control and status register
RGO por_ccla_rcr.c2c_cfg
SGO por_ccla_scr.c2c_cfg
F 0 1 lle
DESC LLE - LogicalLinkEndEnabled Bit Values: 0        LogicalLinkEndEnd is disabled or not valid. 1        LogicalLinkEndEnd is enabled.
F 1 1 pe
DESC Property Exchange Enable Bit Values: 0        LogicalLinkEndEnd is disabled or not valid. 1        LogicalLinkEndEnd is enabled.
F 8 2 acttrigger
DESC Activation Trigger
F 12 2 cohtrigger
DESC Coherency Trigger
F 16 2 dvmtrigger
DESC DVM Trigger
F 32 8 initstate
DESC  Initialization State for the Logical Link. Bit definitions: 0          LinkStatusRcvd 1          RemoteActive 2          PropNegComplete 7:3       Reserved
F 40 2 activationstate
DESC - Activity State for the Logical Link. Field values: 0          STOP 1          ACTIVATE 2          RUN 3          DEACTIVATE
F 42 2 res3
DESC reserved
F 44 2 cohstate
DESC Coherency State for the Logical Link. Field values: 0          CohDisabled 1          CohConnect 2          CohEnabled 3          CohDisconnect
F 46 2 res4
DESC reserved
F 48 2 dvmstate
DESC DVM State for the Logical Link. Field values: 0          DVMDisabled 1          DVMConnect 2          DVMEnabled 3          DVMDisconnect
R 0xf788 64 - ROOT por_ccla_c2c_logical_linkend_0_map_table
RESET 0x0 0xffffffffffffffff
DESC C2C logical link end map table register
RGO por_ccla_rcr.c2c_cfg
SGO por_ccla_scr.c2c_cfg
F 0 3 txrpmt0
DESC Value indicates C2C RP mapped to on-chip RP 0
F 3 3 txrpmt1
DESC Value indicates C2C RP mapped to on-chip RP 1
F 6 3 txrpmt2
DESC Value indicates C2C RP mapped to on-chip RP 2
F 9 3 txrpmt3
DESC Value indicates C2C RP mapped to on-chip RP 3
F 12 3 txrpmt4
DESC Value indicates C2C RP mapped to on-chip RP 4
F 15 3 txrpmt5
DESC Value indicates C2C RP mapped to on-chip RP 5
F 18 3 txrpmt6
DESC Value indicates C2C RP mapped to on-chip RP 6
F 21 3 txrpmt7
DESC Value indicates C2C RP mapped to on-chip RP 7
F 31 1 txv
DESC Tx RP Map Valid. Bit Values: 0          Tx RP Map is not valid 1          Tx RP Map is valid
F 32 3 rxrpmt0
DESC Value indicates on-chip RP mapped to C2C RP 0
F 35 3 rxrpmt1
DESC Value indicates on-chip RP mapped to C2C RP 1
F 38 3 rxrpmt2
DESC Value indicates on-chip RP mapped to C2C RP  2
F 41 3 rxrpmt3
DESC Value indicates on-chip RP mapped to C2C RP  3
F 44 3 rxrpmt4
DESC Value indicates on-chip RP mapped to C2C RP  4
F 47 3 rxrpmt5
DESC Value indicates on-chip RP mapped to C2C RP  5
F 50 3 rxrpmt6
DESC Value indicates on-chip RP mapped to C2C RP  6
F 53 3 rxrpmt7
DESC Value indicates on-chip RP mapped to C2C RP  7
F 63 1 rxv
DESC Rx RP Map Valid. Bit Values: 0          Rx RP Map is not valid 1          Rx RP Map is valid
R 0xf790 64 RO ROOT por_ccla_c2c_linkproperties_supported_uniform1_0
RESET 0x21000 0x3fffff
DESC C2C uniform property supported set
RGO por_ccla_rcr.c2c_cfg
SGO por_ccla_scr.c2c_cfg
F 0 4 num_properties_msg
