RGO por_rnsam_rcr.mem_range
SGO por_rnsam_scr.mem_range
F 0 34 axi_id_mask
DESC AXI_ID mask applied before hashing
R 0xe90 64 - ROOT rnsam_region_cmp_addr_mask_reg
