R 0xf7b0 64 RO ROOT por_ccla_c2c_linkproperties_supported_rx1_0
RESET 0x100015114501 0xfffffffffffff
DESC C2C rx property supported set
RGO por_ccla_rcr.c2c_cfg
SGO por_ccla_scr.c2c_cfg
F 0 4 num_rp_req_rx
DESC Number of resource planes the interface supports as a receiver on the REQ channel: 0b0000             1 0b0001             2 0b0010             3 0b0011             4 0b0100             5 0b0101             6 0b0110             7 0b0111             8 Others             Reserved
F 8 2 writepush_support_rx
DESC Support for WritePush for Immediate writes and Atomics by the interface as a receiver: 0b00               False WritePush for Immediate writes and Atomics is not supported. 0b01               True WritePush for Immediate writes and Atomics is supported. Others             Reserved
F 10 2 dvmpush_support_rx
DESC Support for WritePush for DVM transactionsbytransactions by the interface as a receiver: 0b00              False WritePush for DVM transactions is not supported. 0b01             True WritePush for DVM transactions is supported. Others           Reserved
F 12 2 snoop_transactions_rx
DESC Support for Snoop transactions as a receiver: 0b00 False Snoop transactions not supported. 0b01 True Snoop transactions supported. Others       Reserved
F 14 2 dvm_support_rx
DESC Support for DVM messages as a receiver: 0b00       False DVM transactions not supported. 0b01       True DVM transactions supported. Others     Reserved
F 16 2 atomic_transactions_rx
DESC Support for Atomic transactions as a receiver: 0b00     False Atomic transactions not supported. 0b01     True Atomic transactions supported. Others   Reserved
F 18 2 cache_stash_transactions_rx
DESC Support for Stashing requests and snoops as a receiver: 0b00       False Stash transactions not supported. 0b01       True Stash transactions supported. Others     Reserved
F 20 2 persist_transactions_rx
DESC Support for CMO operations to the PoP and PoDP as a receiver: 0b00       False Persist CMO transactions not supported. 0b01       True Persist CMO transactions supported. Others     Reserved
F 22 2 mte_support_rx
DESC Support for MTE as a receiver: 0b00    False MTE not supported. 0b01    Reduced MTE transaction support. 0b10    Full MTE transaction support. 0b11    Reserved
F 24 2 deferrable_write_rx
DESC Support for WriteNoSnpDef as a receiver: 0b00      False Deferrable Write transactions not supported. 0b01      True Others        Reserved
F 26 2 rme_support_rx
DESC Support for the Realm Management Extensions, including Realm and Root Physical Address Spaces (PAS) and PoPA CMOs as a receiver: 0b00        False RME transactions not supported. 0b01        True RME transactions supported. Others        Reserved
F 28 2 cmo_transactions_rx
DESC Support for CMO transactions as a receiver: 0b00        False Will not send CMO transactions. 0b01        True Can send CMO transactions. Others      Reserved
F 30 2 mpam_support_rx
DESC Support for MPAM on the receiver chip: 0b00     False - MPAM field not present 0b01     True - MPAM field present Others   Reserved 
PAR POR_CHI_MPAM_ENABLE_PARAM == 1 ? 2'b01 : 2'b00
F 32 2 pbha_support_rx
DESC Support for PBHA on the receiver chip: 0b00       False - PBHA field not present 0b01       True - PBHA field present Others     Reserved
PAR POR_PBHA_EN_PARAM == 1 ? 2'b01 : 2'b00
F 34 2 mec_support_rx
DESC Support for MEC on the receiver chip: 0b00       False - MECID field not present 0b01       True - MECID field present Others     Reserved 
PAR METADATA_MECID_EN_PARAM == 1 ? 2'b01 : 2'b00
F 36 4 rsvdc_req_rx
DESC Width of RSVDC on the REQ channel on the receiver chip: 0b000      0 bits 0b001      4 bits 0b010      8 bits 0b011      12 bits 0b100      16 bits 0b101      24 bits 0b110      32 bits 0b111      Reserved
PAR POR_CHIX_REQ_RSVDC_WIDTH_PARAM == 4?  4'b0001 : POR_CHIX_REQ_RSVDC_WIDTH_PARAM == 8?  4'b0010 : POR_CHIX_REQ_RSVDC_WIDTH_PARAM == 12? 4'b0011 : POR_CHIX_REQ_RSVDC_WIDTH_PARAM == 16? 4'b0100 : POR_CHIX_REQ_RSVDC_WIDTH_PARAM == 24? 4'b0101 : POR_CHIX_REQ_RSVDC_WIDTH_PARAM == 32? 4'b0110 :  4'b0000
F 40 4 rsvdc_dat_rx
DESC Width of RSVDC on the DAT channel on the receiver chip: 0b000      0 bits 0b001      4 bits 0b010      8 bits 0b011      12 bits 0b100      16 bits 0b101      24 bits 0b110      32 bits Others     Reserved
F 44 4 devassign_support_rx
DESC Support for RME-DA or RME-CDA. Only valid when RME_Support_Rx is True. Provided for informational purposes only, to assist with setup or debug. Not expected to have any functional effect in isolation. Each bit defines the roles of the other chip that this chip can connect to: Bit 0       Host 0         Cannot connect to a host. 1         Can connect to a host. Bit 1       Device_StreamID_SecSID1 0         Cannot connect to a device. Does not use SecSID1 and StreamID fields. 1         Can connect to a device. Can make use of SecSID1 and StreamID fields. Bit 2       Device_NoStreamID_NoSecSID1 0         Cannot connect to a device. Does not use SecSID1 and StreamID fields. 1         Can connect to a device. Does not use SecSID1 and StreamID fields. Bit 3        Reserved
F 48 2 multihop_support_rx
DESC multihop support
F 50 2 multireq_support_rx
DESC multireq support
