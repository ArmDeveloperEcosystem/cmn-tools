F 25 4 htg_region0_hier_cluster_mask
DESC Hierarchical hashing: Enable cluster masking to achieve different interleave granularity across clusters. 4'b0000: 64   byte interleave granularity across clusters 4'b0110: 4096 byte interleave granularity across clusters 4'b1111: Cluster interleaving disabled others: Reserved
F 16 6 htg_region0_hier_hash_nodes
DESC Hierarchical hashing mode, define number of nodes in each cluster
F 8 6 htg_region0_hier_hash_clusters
DESC Hierarchical hashing mode, define number of clusters groups
F 3 3 htg_region0_hier_enable_address_striping
DESC Hierarchical hashing: configure number of address bits needs to shuttered (removed) at second hierarchy hash (LSB bit is based on cluster mask). 3'b000: no address shuttering 3'b001: one addr bit shuttered   (2  clusters) 3'b010: two addr bit shuttered   (4  clusters) 3'b011: three addr bit shuttered (8  clusters) 3'b100: four addr bit shuttered  (16 clusters) 3'b101: five addr bit shuttered  (32 clusters) 3'b110: six addr bit shuttered   (These are configured when the cachelines are > 64B interleaved and clusters are enabled) 3'b111: seven addr bit shuttered others: Reserved
F 2 1 htg_region0_hierarchical_hash_en
DESC Hierarchical Hashing mode enable configure bit
F 1 1 htg_region0_nonpowerof2_hash_en
DESC Non power of two Hashing mode enable cconfigure bit
R 0x3408 64 - ROOT ra_rnsam_hashed_target_grp_hash_cntl_reg1
RESET 0x1e000000 0x1e3f3f3e
DESC Configures HTG hash type
RGO por_ccg_ra_rcr.cfg_ctl
SGO por_ccg_ra_scr.cfg_ctl
F 25 4 htg_region1_hier_cluster_mask
