R 0xb00 64 - ROOT por_ccla_cfg_ctl
RESET 0x8249001c 0xffffffff073f
DESC Functions as the configuration control register for CCLA.
RGO por_ccla_rcr.cfg_ctl
SGO por_ccla_scr.cfg_ctl
F 0 1 la_cxl_mode_en
DESC  When set enables CXL mode
F 1 1 la_device_mode_en
DESC Enable the Device mode, by default set to Host mode
F 2 2 cxl_type
DESC  Used to program CXL Type for RA 2'b00: Reserved 2'b01: Type1 2'b10: Type2 2'b11: Type3
F 4 1 cxl_mem_en
DESC Enable CXL .mem mode, by default is enabled
F 5 1 cxl_cache_en
DESC Enable CXL .cache mode, by default is disabled
F 8 1 smp_link0_viral_prop_en
DESC When set, enables viral propagation on SMP link0
F 9 1 smp_link1_viral_prop_en
DESC When set, enables viral propagation on SMP link1
F 10 1 smp_link2_viral_prop_en
DESC When set, enables viral propagation on SMP link2
F 16 3 link0_weight
DESC Determines weight of link0 in CCL linkend arbitration
F 19 3 link1_weight
DESC Determines weight of link1 in CCL linkend arbitration
F 22 3 link2_weight
DESC Determines weight of link2 in CCL linkend arbitration
F 25 2 ha_cxl_type
DESC  Used to program CXL Type for HA 2'b00: Reserved 2'b01: Type1 2'b10: Type2 2'b11: Type3
F 27 8 linkend_arb_cnt
DESC The count for how long each linkend is selected during linkend arbitration. If linkend_arb_cnt=8, each linkend is active for 8 cycles before switching to the next linkend
F 35 1 txrsp_byp_tgtid_cam
DESC Bypass the Tgtid CAM for finding the tx rsp port to be used.
F 36 3 ccg_baseid
DESC 3-bit id that is unique within the connected physical ccix link. this will be send as LSB (3-bit) of SRCID while sending a packet accross ccix link
F 39 1 ccg_gcid_en
DESC enable indicating if CCG-RA needs to send global chip id (gcid) for non-caching agent request
F 40 5 ccg_gcid
DESC Global Chip ID
F 45 1 la_c2c_mode_en
DESC  When set enables CHI C2C mode
F 46 1 la_cml_smp_tx_hold_on_datacheck_err
DESC  When set holds CML_SMP TX from sending CXS flits when datacheck has a parity error. When set, will halt TX (not restartable)  so that the flit with datacheck error does not get sent on CXS. When clear this allows flits with datcheck error to be sent over TX
F 47 1 la_cxl3_t1h_t3d_tx_hold_on_datacheck_err
DESC  When set holds either CXL3 Type1 host or Type 3 device TX from sending CXS flits when datacheck has a parity error. When set, will halt TX (not restartable)  so that the flit with datacheck error does not get sent on CXS. When clear this allows flits with datcheck error to be sent over TX
R 0xb08 64 - ROOT por_ccla_aux_ctl
RESET 0x61440000000004 0x7f77000000007f
DESC Functions as the auxiliary control register for CCLA.
F 0 1 cg_disable
DESC Disables CCLA architectural clock gates
F 1 1 disable_byteen_parity_err
DESC Disables CCLA RX RAM byte enable parity errors
F 2 1 disable_viral_err_report
DESC When set, disables viral error reporting through CMN's error reporting mechanism
F 3 1 enable_cxl_regs_apb_access
DESC When set, Enables the APB access to the CXL registers and Disables the CMN access
F 4 1 disable_cxl_cache_poison_err_report
DESC When set, disables cxl cache poison err reporting through CMN's error reporting mechanism
F 5 1 disable_cxl_mem_poison_err_report
DESC When set, disables cxl mem poison err reporting through CMN's error reporting mechanism
F 6 1 disable_cxl_mem_hdm_decode_err_report
DESC When set, disables cxl HDM decode errors reporting through CMN's error reporting mechanism
F 40 3 crdgnt_crd_count_th
DESC Maximum number of protocol credits (i.e. Req, Dat, Snp..) that need to be accumulated to send a credit grant message 3'b000:  4 cycles 3'b001:  8 cycles 3'b010: 16 credits 3'b011: 32 credits 3'b100: 64 credits 3'b101: 128 credits
F 44 3 crdgnt_cycle_count_th
DESC Maximum number of cycles that need to be elapsed since previous piggyback credits were sent, to send a protocol (Req, Dat, Snp..) credit grant message 3'b000:  8 cycles 3'b001: 16 cycles 3'b010: 32 cycles 3'b011: 64 cycles 3'b100: 128 cycles 3'b101: 256 cycles
F 48 3 lcrdgnt_cycle_count_th
DESC Maximum number of cycles that need to be elapsed since previous piggyback credits were sent, to send a link credit grant message 3'b000: 8  cycles 3'b001: 16 cycles 3'b010: 32 cycles 3'b011: 64 cycles
F 51 1 disable_hdm_decoder_cxl_reset
DESC When set, disables resetting HDM decoder registers on CXL reset
F 52 2 sel_256b_flit_type
DESC selects the Flit Type[1:0] in 256B flit header for CXL 3 and SMP 2'b00: 00b Physical Layer NOP or IDle flit or CXL.io NOP 2'b01: 01b CXL.io Payload flit 2'b10: 10b CXL.cachemem Payload flit or CXL.cachemen empty flit 2'b11: 11b ALMP arb/mux link anagement packet
F 54 1 disable_cxl_dcd_lut_entry_v
DESC When set, ignores the entry valid information read from the DCD LUT. Applicable only in CXL Type3 Device mode with Dynamic Capacity Device support enabled
R 0xb10 64 - ROOT por_ccla_c2c_packing_ctl
RESET 0x19b3883232323201 0x3bf7bfbfbfbfbf03
DESC Controls CCLA C2C Packing Logic Arbiter Control
F 0 2 update_on_grant
DESC Controls when LRU arbitration order is updated 2'b00: Update LRU order after Message Class weight exhausted 2'b01: Update LRU order after every grant 2'b10: Update LRU order after packing max_message limit 2'b11: Reserved
F 8 6 reqsnp_weights
DESC Number of Request/Snoop Message class messages allowed
F 15 1 reqsnp_allow_force_reload
DESC Allow reloading Request/Snoop Message class weights even when non-zero 0: Reload Request/Snoop Message class weights only when exhausted 1: Allow reloading Request/Snoop Message class weights even when non-zero in case all other message types have exhausted their weights
F 16 6 rsp_weights
DESC Number of Response Message class messages allowed
F 23 1 rsp_allow_force_reload
DESC Allow reloading Response Message class weights even when non-zero 0: Reload Response Message class weights only when exhausted 1: Allow reloading Response Message class weights even when non-zero in case all other message types have exhausted their weights
F 24 6 dat_weights
DESC Number of Dat Message class messages allowed
F 31 1 dat_allow_force_reload
DESC Allow reloading Dat Message class weights even when non-zero 0: Reload Dat Message class weights only when exhausted 1: Allow reloading Dat Message class weights even when non-zero in case all other message types have exhausted their weights
F 32 6 wrreqdat_weights
DESC Number of WrReqDat Message class messages allowed
F 39 1 wrreqdat_allow_force_reload
DESC Allow reloading WrReqDat Message class weights even when non-zero 0: Reload WrReqDat Message class weights only when exhausted 1: Allow reloading WrReqDat Message class weights even when non-zero in case all other message types have exhausted their weights
F 40 6 misc_weights
DESC Number of Misc Message class messages allowed
F 47 1 misc_allow_force_reload
DESC Allow reloading Misc Message class weights even when non-zero 0: Reload Misc Message class weights only when exhausted 1: Allow reloading Misc Message class weights even when non-zero in case all other message types have exhausted their weights
F 48 3 reqsnp_lru_update_cnt
DESC Max consequtive Request/Snoop Message class requests to pack before updating LRU order 3'b000: Update LRU order after 1 Request/Snoop Message packed 3'b001: Update LRU order after 2 Request/Snoop Message packed 3'b010: Update LRU order after 3 Request/Snoop Message packed 3'b011: Update LRU order after 4 Request/Snoop Message packed 3'b100: Update LRU order after 5 Request/Snoop Message packed 3'b101: Update LRU order after 5 Request/Snoop Message packed 3'b110: Update LRU order after 7 Request/Snoop Message packed 3'b111: Update LRU order after 8 Request/Snoop Message packed
F 52 3 rsp_lru_update_cnt
DESC Max consequtive Response Message class requests to pack before updating LRU order 3'b000: Update LRU order after 1 Response Message packed 3'b001: Update LRU order after 2 Response Message packed 3'b010: Update LRU order after 3 Response Message packed 3'b011: Update LRU order after 4 Response Message packed 3'b100: Update LRU order after 5 Response Message packed 3'b101: Update LRU order after 5 Response Message packed 3'b110: Update LRU order after 7 Response Message packed 3'b111: Update LRU order after 8 Response Message packed
F 55 3 dat_lru_update_cnt
DESC Max consequtive Dat Message class requests to pack before updating LRU order 3'b000: Update LRU order after 1 Dat Message packed 3'b001: Update LRU order after 2 Dat Message packed 3'b010: Update LRU order after 3 Dat Message packed 3'b011: Update LRU order after 4 Dat Message packed 3'b100: Update LRU order after 5 Dat Message packed 3'b101: Update LRU order after 5 Dat Message packed 3'b110: Update LRU order after 7 Dat Message packed 3'b111: Update LRU order after 8 Dat Message packed
F 59 3 wrreqdat_lru_update_cnt
DESC Max consequtive WrReqDat Message class requests to pack before updating LRU order 3'b000: Update LRU order after 1 WrReqDat Message packed 3'b001: Update LRU order after 2 WrReqDat Message packed 3'b010: Update LRU order after 3 WrReqDat Message packed 3'b011: Update LRU order after 4 WrReqDat Message packed 3'b100: Update LRU order after 5 WrReqDat Message packed 3'b101: Update LRU order after 5 WrReqDat Message packed 3'b110: Update LRU order after 7 WrReqDat Message packed 3'b111: Update LRU order after 8 WrReqDat Message packed
R 0xc00 64 RO ROOT por_ccla_ccix_prop_capabilities
RESET 0x9 0x3f
DESC Contains CCIX-supported properties.
F 0 1 nocompack
DESC No CompAck supported 1'b0: False 1'b1: True
F 1 1 partialcachestates
DESC Partial cache states supported 1'b0: False 1'b1: True
F 2 1 cachelinesize
DESC Cacheline size supported 1'b0: 64B 1'b1: 128B
F 3 3 addrwidth
DESC Address width supported 3'b000: 48b 3'b001: 52b 3'b010: 56b 3'b011: 60b 3'b100: 64b
