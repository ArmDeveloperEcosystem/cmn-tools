R 0xb80 64 WO ROOT por_mtu_cfg_tc_dbgrd
RESET 0x2000000 0x37f1fff
DESC Controls access modes for TC data and TC Control debug read.
RGO por_mtu_rcr.tc_dbgrd
SGO por_mtu_scr.tc_dbgrd
F 0 13 tc_access_set
DESC Set address for TC debug read access
F 16 4 tc_access_way
DESC Way address for TC debug read access
F 20 3 tc_access_dw
DESC 64-bit chunk address for TC data debug read access
F 24 2 tc_access_component
DESC Specifies TC Data/Control array debug read 2'b01: TC data read 2'b10: TC control read
R 0xb88 64 RO ROOT por_mtu_tc_cache_access_tc_ctl
RESET 0x0 0xffffffffffffffff
DESC Contains TC Control debug read data bits
RGO por_mtu_rcr.tc_dbgrd
SGO por_mtu_scr.tc_dbgrd
F 0 64 tc_cache_access_tc_control
DESC TC Control debug read data
R 0xb98 64 RO ROOT por_mtu_tc_cache_access_tc_data
RESET 0x0 0xffffffffffffffff
DESC Contains TC data RAM debug read data.
RGO por_mtu_rcr.tc_dbgrd
SGO por_mtu_scr.tc_dbgrd
F 0 64 tc_cache_access_tc_data
DESC TC data RAM debug read data
R 0xd900 64 - - por_mtu_pmu_event_sel
RESET 0x0 0x3f3f3f3f
DESC Specifies the PMU event to be counted.
F 0 6 pmu_event0_id
DESC MTU PMU Event 0 select 6'h00: No event 6'h01: PMU_MTU_TC_LOOKUP_EVENT; Count total cache lookup requests. 6'h02: PMU_MTU_TC_FILL_EVENT; Count total number of tag cache allocation (Dirty or Clean) requests. 6'h03; PMU_MTU_TC_MISS_EVENT; Count total cache miss responses. 6'h04; PMU_MTU_TDB_FORWARD_EVENT: Count total number of requests that got TDB forwarded data. 6'h05; PMU_MTU_TCQ_HAZARD_EVENT: Count number of incoming requests hazarding againt pending TCQ requests. 6'h06; PMU_MTU_TCQ_RD_ALLOC_EVENT; Count number of read requests allocated in TCQ. This includes Read & Write_Match. 6'h07; PMU_MTU_TCQ_WR_ALLOC_EVENT; Count number of write requests allocated in TCQ. This includes Write_Update. 6'h08; PMU_MTU_TCQ_CMO_ALLOC_EVENT; Count number of CMO requests allocated in TCQ. This includes CMOs & wr+CMO. 6'h09; PMU_MTU_AXI_RD_REQ_EVENT; Count number of read requests sent out on AXI. 6'h0A; PMU_MTU_AXI_WR_REQ_EVENT; Count number of write requests sent out on AXI. 6'h0B; PMU_MTU_TCQ_OCCUPANCY_CNT_OVERFLOW_EVENT; TCQ tracker occupancy count overflow. 6'h0C; PMU_MTU_TDB_OCCUPANCY_CNT_OVERFLOW_EVENT; TDB occupancy count overflow. NOTE: All other encodings are reserved.
F 8 6 pmu_event1_id
DESC MTU PMU Event 1 select; see pmu_event0_id for encodings
F 16 6 pmu_event2_id
DESC MTU PMU Event 2 select; see pmu_event0_id for encodings
F 24 6 pmu_event3_id
DESC MTU PMU Event 3 select; see pmu_event0_id for encodings
R 0xe000 64 RO ROOT por_mtu_errfr
RESET 0x4200008010c9a2 0x720000803ffff3
DESC Functions as the Root PAS error feature register.
RGO por_mtu_rcr.ras
SGO por_mtu_scr.ras
F 0 2 ed
DESC Error reporting and logging control 2'b10: Error reporting and logging is controllable using por_mtu_errctlr.ED
F 4 2 ui
DESC Error Recovery Interrupt from Uncorrected errors control 2'b00: Does not support Error Recovery Interrupt from Uncorrected errors 2'b10: Support Error Recovery Interrupt on Uncorrected errors and controllable using por_mtu_errctlr.UI.
F 6 2 fi
DESC Fault Handling Interrupt for Deferred and Uncorrected errors control 2'b00: Does not support Fault Handling Interrupt from Deferred and Uncorrected errors 2'b10: Support Fault Handling Interrupt on Deferred and Uncorrected errors and controllable using por_mtu_errctlr.FI.
F 8 2 ue
DESC In-band error response is always on
F 10 2 cfi
DESC Fault Handling Interrupt from Corrected errors control 2'b00: Does not support Fault Handling Interrupt from Corrected errors 2'b10: Support Fault Handling Interrupt on corrected errors and controllable using por_mtu_errctlr.CFI.
F 12 3 cec
DESC Standard corrected error counter 3'b000: Does not implement standard error counter model 3'b100: Implements a 16-bit Corrected error counter in por_mtu_errmisc0
F 15 1 rp
DESC Repeat counter (valid only when por_mtu_errfr.CEC == 3'b100.) 1'b0: Invalid 1'b1: Implements a first (repeat) counter and a second (other) counter in por_mtu_errmisc0
F 16 2 dui
DESC Error Recovery Interrupt from Deferred errors control 2'b00: Does not support Error Recovery Interrupt from Deferred errors
F 18 2 ceo
DESC Corrected Error overwrite 2'b00: Keep the first Corrected Error syndrome
F 20 2 inj
DESC Fault Injection Extension 2'b01: Support Common Fault Injection Model Extension
F 31 1 frx
DESC Feature Register extension 1'b1: por_mtu_errfr[63:48] is architecturally defined
F 49 1 ueu
DESC Unrecoverable Error recording 1'b0: Unrecoverable Error not supported 1'b1: Unrecoverable Error supported
F 52 1 de
DESC Deferred Error recording 1'b0: Deferred Error not supported
F 53 2 ce
DESC Corrected Error recording 2'b00: Corrected Error not supported 2'b10: Non-specific Corrected Error supported
R 0xe008 64 - ROOT por_mtu_errctlr
RESET 0x0 0x50d
DESC Functions as the Root PAS error control register. Controls whether specific error-handling interrupts and error detection/deferment are enabled.
RGO por_mtu_rcr.ras
SGO por_mtu_scr.ras
F 0 1 ed
DESC Enables error detection as specified in por_mtu_errfr.ED
F 2 1 ui
DESC Enables error recovery interrupt for uncorrected error as specified in por_mtu_errfr.UI
F 3 1 fi
DESC Enables fault handling interrupt for uncorrected errors as specified in por_mtu_errfr.FI
F 8 1 cfi
DESC Enables fault handling interrupt for corrected error as specified in por_mtu_errfr.CFI
F 10 1 dui
DESC Enables error recovery interrupt for deferred error as specified in por_mtu_errfr.DUI
R 0xe010 64 - ROOT por_mtu_errstatus
RESET 0x0 0xfff0ffff
DESC Functions as the Root PAS error status register. When V is set, only write exact same value as in the register can clear it.
RGO por_mtu_rcr.ras
SGO por_mtu_scr.ras
F 31 1 av W1C
DESC Address register valid 1'b1: Address is valid; por_mtu_erraddr contains a physical address for that recorded error 1'b0: Address is not valid
F 30 1 v W1C
DESC Status register valid 1'b1: At least one error recorded; register is valid 1'b0: No errors recorded
F 29 1 ue W1C
DESC Uncorrected errors 1'b1: At least one error detected that is not corrected and is not deferred to a subordinate 1'b0: No uncorrected errors detected
F 28 1 er W1C
DESC Error Reported 1'b1: In-band error response signaled to the Requester 1'b0: No in-band error response signaled
F 27 1 of W1C
DESC Overflow; asserted when multiple errors are detected 1'b1: More than one error detected 1'b0: None or only one error detected as described by UE/DE/CE fields
F 26 1 mv W1C
DESC por_mtu_errmisc<01> valid 1'b1: Miscellaneous registers are valid 1'b0: Miscellaneous registers are not valid
F 24 2 ce W1C
DESC Corrected errors 2'b10: At least one corrected error recorded 2'b00: No corrected errors recorded
F 23 1 de W1C
DESC Deferred errors 1'b0: No errors deferred
F 22 1 pn W1C
DESC Poison 1'b1: Uncorrected error recorded because a poison value was consumed 1'b0: Other cases
F 20 2 uet W1C
DESC Uncorrected Error Type, valid only when UE != 0 2'b01: Uncorrected error, Unrecoverable error (UEU). 2'b00: Invalid
F 8 8 ierr W1C
DESC Implementation-defined primary error code. 8'h00: No error 8'h01: Partner implementation defined error
F 0 8 serr W1C
DESC Architecturally-defined primary error code. 8'h00: No error 8'h01: CMN implementation defined error. Refer to por_mtu_errmisc1.ERRSRC for error type details. 8'h06: ECC error on L3 data 8'h07: ECC error on L3/SF Tag 8'h0A: Producer write data was poisoned but ACE-Lite does not support poisoned data 8'h0D: Illegal address 8'h1A: Parity error
R 0xe018 64 - ROOT por_mtu_erraddr
RESET 0x0 0xc80fffffffffffff
DESC Functions as the Root PAS error address register.
RGO por_mtu_rcr.ras
SGO por_mtu_scr.ras
F 0 52 addr
DESC Transaction address for Data Request (Data PA). Same PA received from HN. Note: For Errors on TC evictions, this represents address that caused eviction. Note: Address is undefined if errmisc.OPTYPE is Other. For most part, these transactions are set/way based and not PA based.
F 59 1 nse
DESC Root status of transaction.  PAS[1] of the transaction.
F 62 1 si
DESC {NSE,NS} valid 1'b0: PAS field is valid 1'b1: PAS field is invalid
F 63 1 ns
DESC Secure status of transaction.  PAS[0] of the transaction.
R 0xe020 64 - ROOT por_mtu_errmisc0
RESET 0x0 0xffffffff00000000
