F 0 64 valid
DESC Specifies whether the Port ID is valid; bit number corresponds to logical Agent ID number (from 0 to 63)
R 0xd78 64 V ROOT por_cxla_portfwd_ctl
RESET 0x0 0xffff0000ffff
DESC Functions as the Port-to-Port forwarding control register. Works with por_cxla_portfwd_status.
F 0 16 port_fwd_en
DESC Bit vector, where each bit represents logical PortID of a Port (CXG) present on CMN. Each bit when set, enables Port-to-Port forwarding with the corresponding port. 1'b0: Port-to-Port forwarding is disabled 1'b1: Port-to-Port forwarding  is enabled
F 32 16 port_fwd_req
DESC Bit vector, where each bit represents logical PortID of a Port (CXG) present on CMN. Each bit is used to control the communication channel with the corresponding port. 1'b0: Port-to-Port forwarding channel de-activate request 1'b1: Port-to-Port forwarding channel activate  request
R 0xd80 64 ROV ROOT por_cxla_portfwd_status
RESET 0x0 0xffff
DESC Functions as the Port-to-Port forwarding status register. Works with por_cxla_portfwd_ctl.
F 0 16 port_fwd_ack
DESC Bit vector, where each bit represents logical PortID of a Port (CXG) present on CMN. Each bit represents the status of the port-to-port control request sent to the corresponding port. 1'b0: Port-to-Port forwarding channel is de-active. 1'b1: Port-to-Port forwarding channel is active
R 0xd900 64 - - por_cxla_pmu_event_sel
RESET 0x0 0x3f3f3f3f
DESC Specifies the PMU event to be counted.
F 0 6 pmu_event0_id
DESC CXLA PMU Event 0 ID 6'h00: No event 6'h01: Average RX TLP count for Link 0 6'h02: Average RX TLP count for Link 1 6'h03: Average RX TLP count for Link 2 6'h04: Average TX TLP count for Link 0 6'h05: Average TX TLP count for Link 1 6'h06: Average TX TLP count for Link 2 6'h07: RX CXS for Link 0 6'h08: RX CXS for Link 1 6'h09: RX CXS for Link 2 6'h0A: TX CXS for Link 0 6'h0B: TX CXS for Link 1 6'h0C: TX CXS for Link 2 6'h0D: Average RX TLP size in DWs 6'h0E: Average TX TLP size in DWs 6'h0F: Average RX TLP size in CCIX messages 6'h10: Average TX TLP size in CCIX messages 6'h11: Average size of RX CXS in DWs within a beat 6'h12: Average size of TX CXS in DWs within a beat 6'h13: TX CXS link credit backpressure 6'h14: RX TLP buffer full and backpressured 6'h15: TX TLP buffer full and backpressured 6'h16: Reserved 6'h17: Average latency to form a TX TLP 6'h18: TX Request Chain 6'h19: RX RSPDAT (Memory Response with Data) CGL Buffer backpressured 6'h1A: RX SNPDAT (Snoop Response with Data) CGL Buffer backpressured 6'h1B: RX REQDAT (Memory Request) CGL Buffer backpressured 6'h1C: RX REQRSP (Memory Response without Data) CGL Buffer backpressured 6'h1D: RX SNPRSP (Snoop Response without Data) CGL Buffer backpressured 6'h1E: RX SNP (Snoop Request) CGL Buffer backpressured 6'h1F: RX UCMISC (Misc) CGL Buffer backpressured 6'h20: RX Number of Port forwarded CXS beats 6'h21: TX Number of Port forwarded CXS beats 6'h22: RX Number of port forwarded message stalls due to static credits 6'h23: RX Number of port forwarded message stalls due to dynamic credits
F 8 6 pmu_event1_id
DESC CXLA PMU Event 1 ID; see pmu_event0_id for encodings
F 16 6 pmu_event2_id
DESC CXLA PMU Event 2 ID; see pmu_event0_id for encodings
F 24 6 pmu_event3_id
DESC CXLA PMU Event 3 ID; see pmu_event0_id for encodings
R 0xdb10 64 - - por_cxla_pmu_config
RESET 0x0 0x777701ff
DESC Configures the CXLA PMU.
F 0 1 pmu_en
DESC CXLA PMU enable NOTE: All other fields in this register are valid only if this bit is set.
F 1 1 pmevcnt01_combined
DESC Enables combination of PMU counters 0 and 1
F 2 1 pmevcnt23_combined
DESC Enables combination of PMU counters 2 and 3
F 3 1 pmevcntall_combined
DESC Enables combination of all PMU counters (0, 1, 2, 3) NOTE: When set, pmevcnt01_combined and pmevcnt23_combined have no effect.
F 4 4 pmevcnt_paired
DESC PMU local counter paired with global counter
F 8 1 cntr_rst
DESC Enables clearing of live counters upon assertion of snapshot
F 16 3 pmevcnt0_global_num
DESC Global counter to pair with PMU counter 0 3'b000: Global PMU event counter A 3'b001: Global PMU event counter B 3'b010: Global PMU event counter C 3'b011: Global PMU event counter D 3'b100: Global PMU event counter E 3'b101: Global PMU event counter F 3'b110: Global PMU event counter G 3'b111: Global PMU event counter H
F 20 3 pmevcnt1_global_num
DESC Global counter to pair with PMU counter 1; see pmevcnt0_global_num for encodings
F 24 3 pmevcnt2_global_num
DESC Global counter to pair with PMU counter 2; see pmevcnt0_global_num for encodings
F 28 3 pmevcnt3_global_num
DESC Global counter to pair with PMU counter 3; see pmevcnt0_global_num for encodings
R 0xdb20 64 - - por_cxla_pmevcnt
RESET 0x0 0xffffffffffffffff
DESC Contains all PMU event counters (0, 1, 2, 3).
F 0 16 pmevcnt0
DESC PMU event counter 0
F 16 16 pmevcnt1
DESC PMU event counter 1
F 32 16 pmevcnt2
DESC PMU event counter 2
F 48 16 pmevcnt3
DESC PMU event counter 3
R 0xdb40 64 - - por_cxla_pmevcntsr
RESET 0x0 0xffffffffffffffff
DESC Functions as the PMU event counter shadow register for all counters (0, 1, 2, 3).
F 0 16 pmevcntsr0
DESC PMU event counter 0 shadow register
F 16 16 pmevcntsr1
DESC PMU event counter 1 shadow register
F 32 16 pmevcntsr2
DESC PMU event counter 2 shadow register
F 48 16 pmevcntsr3
DESC PMU event counter 3 shadow register
ENDGROUP
GROUP por_cxlapb_registers
R 0x0 64 - ROOT por_cxlapb_ll_to_ull_msg
RESET 0x0 0xffffffffffffffff
DESC Contains lll_to_ull_message
F 0 64 msg_payload
DESC Contains 64 bits of message sent from ll to ull
R 0x10c 32 - ROOT por_cxlapb_dvsec_cxl_control
RESET 0x2 0x4fff
DESC Contains DVSEC_CXL_Control. Only applicable for Device. Host does not use this register 
F 0 1 cache_enable
DESC When set  enables CXL.cache protocol operation when in Flex Bus.CXL mode. Locked by CONFIG_LOCK.
F 1 1 io_enable
DESC When set  enables CXL.io protocol operation when in Flex Bus.CXL mode.
F 2 1 mem_enable
DESC When set  enables CXL.mem protocol operation when in Flex Bus.CXL mode. Locked by CONFIG_LOCK.
F 3 5 cache_sf_coverage
DESC Performance hint to the device. Locked by CONFIG_LOCK. 0x00: Indicates no Snoop Filter coverage on the Host For all other values of N: Indicates Snoop Filter coverage on the Host of 2^(N+15d) Bytes.
F 8 3 cache_sf_granularity
DESC Performance hint to the device. Locked by CONFIG_LOCK. 000: Indicates 64B granular tracking on the Host 001: Indicates 128B granular tracking on the Host 010: Indicates 256B granular tracking on the Host 011: Indicates 512B granular tracking on the Host 100: Indicates 1KB granular tracking on the Host 101: Indicates 2KB granular tracking on the Host 110: Indicates 4KB granular tracking on the Host 111: Reserved
F 11 1 cache_clean_eviction
DESC Performance hint to the device. Locked by CONFIG_LOCK. 0: Indicates clean evictions from device caches are needed for best performance 1: Indicates clean evictions from device caches are NOT needed for best performance
F 14 1 viral_enable
DESC When set  enables Viral handling in the CXL device. Locked by CONFIG_LOCK. If 0  the CXL device may ignore the viral that it receives
R 0x110 32 V ROOT por_cxlapb_dvsec_cxl_control2
RESET 0x0 0xf
DESC Contains DVSEC_CXL_Control2. Only applicable for Device. Host does not use this register
F 0 1 disable_caching
DESC When set to 1  device shall no longer cache new modified lines in its local cache. Device shall continue to correctly respond to CXL.cache transactions.
F 1 1 initiate_cache_write_back
DESC When set to 1  device shall write back all modified lines in the local cache and invalidate all lines. The device shall send CacheFlushed message to host as required by CXL.Cache protocol to indicate it does not hold any modified lines.
F 2 1 initiate_cxl_reset
DESC When set to 1  device shall initiate CXL Reset as defined in Section 9.7. This bit always returns the value of 0 when read by the software. A write of 0 is ignored.
F 3 1 cxl_reset_mem_clr_enable
DESC When set  and CXL Reset Mem Clr Capable returns 1  Device shall clear or randomize volatile HDM ranges as part of the CXL Reset operation. When CXL Reset Mem Clr Capable is clear  this bit is ignored and volatile HDM ranges may or may not be cleared or randomized during CXL Reset.
R 0x114 32 V ROOT por_cxlapb_dvsec_cxl_lock
RESET 0x0 0x1
DESC Contains DVSEC_CXL_Lock. Only applicable for Device. Host does not use this register
F 0 1 config_lock
DESC When set  all register fields in the PCIe DVSEC for CXL Devices Capability with RWL attribute become read only. Consult individual register fields for details. This bit is cleared upon device Conventional Reset. This bit and all the fields that are locked by this bit are not affected by CXL Reset.
R 0x118 32 RO ROOT por_cxlapb_dvsec_cxl_range_1_size_high
RESET 0x0 0xffffffff
DESC Contains DVSEC_CXL_Range_1_size_High. Only applicable for Device. Host does not use this register
F 0 32 memory_size_high
DESC Corresponds to bits 63:32 of CXL Range 1 memory size.
R 0x11c 32 RO ROOT por_cxlapb_dvsec_cxl_range_1_size_low
RESET 0x2348 0xf000ffff
DESC Contains DVSEC_CXL_Range_1_size_Low. Only applicable for Device. Host does not use this register
F 0 1 memory_info_valid
DESC When set, indicates that the CXL Range 1 Size high and Size Low registers are valid. Must be set within 1 second of deassertion of reset to CXL device.
F 1 1 memory_active
DESC When set, indicates that the CXL Range 1 memory is fully initialized and available for software use. Must be set within Range 1.Memory_Active_Timeout of deassertion of reset to CXL device if CXL.mem HwInit Mode=1.
F 2 3 media_type
DESC Other encodings are reserved. CXL 2.0 and future CXL.mem devices shall set this field to 010.
F 5 3 media_class
DESC CXL 2.0 and future CXL.mem devices shall set this field to 010.
F 8 5 desired_interleave
DESC all other settings are reserved.
F 13 3 memory_active_timeout
DESC All other - Reserved
F 28 4 memory_size_low
DESC Corresponds to bits 31:28 of CXL Range 1 memory size.
R 0x120 32 - ROOT por_cxlapb_dvsec_cxl_range_1_base_high
RESET 0x0 0xffffffff
DESC Contains DVSEC_CXL_Range_1_Base_High. Only applicable for Device. Host does not use this register
F 0 32 memory_base_high
DESC Corresponds to bits 63:32 of CXL Range 1 base in the host address space. Locked by CONFIG_LOCK. If a device implements CXL HDM Decoder Capability registers and software has enabled HDM Decoder by setting HDM Decoder Enable bit in CXL HDM Decoder Global Control register  the value of this field is not used during address decode. It is recommended that software program this to match CXL HDM Decoder 0 Base High Register for backward compatibility reasons.
R 0x124 32 - ROOT por_cxlapb_dvsec_cxl_range_1_base_low
RESET 0x0 0xf0000000
DESC Contains DVSEC_CXL_Range_1_Base_Low. Only applicable for Device. Host does not use this register
F 28 4 memory_base_low
DESC Corresponds to bits 31:28 of CXL Range 1 base in the host address space. Locked by CONFIG_LOCK. If a device implements CXL HDM Decoder Capability registers and software has enabled HDM Decoder by setting HDM Decoder Enable bit in CXL HDM Decoder Global Control register  the value of this field is not used during address decode. It is recommended that software program this to match CXL HDM Decoder 0 Base Low Register for backward compatibility reasons.
R 0x128 32 RO ROOT por_cxlapb_dvsec_cxl_range_2_size_high
RESET 0x0 0xffffffff
DESC Contains DVSEC_CXL_Range_2_size_High. Only applicable for Device. Host does not use this register
F 0 32 memory_size_high
DESC Corresponds to bits 63:32 of CXL Range 2 memory size.
R 0x12c 32 RO ROOT por_cxlapb_dvsec_cxl_range_2_size_low
RESET 0x2348 0xf000ffff
DESC Contains DVSEC_CXL_Range_2_size_Low. Only applicable for Device. Host does not use this register
F 0 1 memory_info_valid
DESC When set, indicates that the CXL range 2 Size high and Size Low registers are valid. Must be set within 1 second of deassertion of reset to CXL device.
F 1 1 memory_active
DESC When set, indicates that the CXL range 2 memory is fully initialized and available for software use. Must be set within range 2.Memory_Active_Timeout of deassertion of reset to CXL device if CXL.mem HwInit Mode=1.
F 2 3 media_type
DESC Other encodings are reserved. CXL 2.0 and future CXL.mem devices shall set this field to 010.
F 5 3 media_class
DESC CXL 2.0 and future CXL.mem devices shall set this field to 010.
F 8 5 desired_interleave
DESC all other settings are reserved.
F 13 3 memory_active_timeout
DESC All other - Reserved
F 28 4 memory_size_low
DESC Corresponds to bits 31:28 of CXL range 2 memory size.
R 0x130 32 - ROOT por_cxlapb_dvsec_cxl_range_2_base_high
RESET 0x0 0xffffffff
DESC Contains DVSEC_CXL_Range_2_Base_High. Only applicable for Device. Host does not use this register
F 0 32 memory_base_high
DESC Corresponds to bits 63:32 of CXL Range 2 base in the host address space. Locked by CONFIG_LOCK. If a device implements CXL HDM Decoder Capability registers and software has enabled HDM Decoder by setting HDM Decoder Enable bit in CXL HDM Decoder Global Control register  the value of this field is not used during address decode. It is recommended that software program this to match the corresponding CXL HDM Decoder Base High Register for backward compatibility reasons.
R 0x134 32 - ROOT por_cxlapb_dvsec_cxl_range_2_base_low
RESET 0x0 0xf0000000
DESC Contains DVSEC_CXL_Range_2_Base_Low. Only applicable for Device. Host does not use this register
F 28 4 memory_base_low
DESC Corresponds to bits 31:28 of CXL Range 2 base in the host address space. Locked by CONFIG_LOCK
R 0x20c 32 - ROOT por_cxlapb_dvsec_flex_bus_port_control
RESET 0x0 0x65
DESC Contains DVSEC_Flex_Bus_Port_Control
F 0 1 cache_enable
DESC When set  enables CXL.cache protocol operation when in Flex Bus.CXL mode.
F 2 1 mem_enable
DESC When set  enables CXL.mem protocol operation when in Flex Bus.CXL mode.
F 5 1 cxl2p0_enable
DESC When set  enable CXL2.0 protocol operation when in Flex Bus.CXL mode.
F 6 1 cxl_multi_logical_device_enable
DESC When set  enable Multi-Logical Device operation when in Flex Bus.CXL mode
R 0x1014 32 - ROOT por_cxlapb_err_capabilities_control
RESET 0x0 0x2000
DESC Contains err_capabilities_control. Only applicable for Device. Host does not use this register
F 13 1 poison_enabled
DESC If this bit is 0  CXL 1.1 Upstream Ports  CXL 1.1 Downstream Ports and CXL 2.0 Root Port shall treat poison received on CXL.cache or CXL.mem as uncorrectable error and log the error in Uncorrectable Error Status Register. If this bit is 1  these ports shall treat poison received on CXL.cache or CXL.mem as correctable error and log the error in Correctable Error Status Register. This bit defaults to 1. This bit is hardwired to 1 in CXL 2.0 Upstream Switch Port  CXL 2.0 Downstream Switch Port and CXL 2.0 device.
R 0x1060 64 - ROOT por_cxlapb_cxl_security_policy
RESET 0x2 0x3
DESC Contains CXL Security Policy
F 0 2 device_trust_level
DESC 0 --> Trusted CXL Device. At this setting  a CXL Device will be able to get access on CXL.cache for both host-attached and device attached memory ranges. The Host can still protect security sensitive memory regions. '1 --> Trusted for Device Attached Memory Range Only. At this setting  a CXL Device will be able to get access on CXL.cache for device attached memory ranges only. Requests on CXL.cache for host-attached memory ranges will be aborted by the Host. '2 --> Untrusted CXL Device. At this setting  all requests on CXL.cache will be aborted by the Host. Please note that these settings only apply to requests on CXL.cache. The device can still source requests on CXL.io regardless of these settings. Protection on CXL.io will be implemented using IOMMU based page tables. Default value of this field is 2.
R 0x1110 64 - ROOT por_cxlapb_link_rx_credit_ctl
RESET 0x10000000 0x3ffffffffffff
DESC CXL Link Rx Credit Control Register
F 0 10 cache_req_credits
DESC Credits to advertise for Cache Request channel at init
PAR CCG_HA_REQ_PASS_BUFF_DEPTH_PARAM
F 10 10 cache_rsp_credits
DESC Credits to advertise for Cache Response channel at init
PAR CCG_HA_NUM_SNPREQS_PARAM
F 20 10 cache_data_credits
DESC Credits to advertise for Cache Data channel at init
PAR CCG_HA_DAT_PASS_BUFF_DEPTH_PARAM
F 30 10 mem_req_rsp_credits
DESC Credits to advertise for Mem Request or Response channel at init
PAR CCG_RA_NUM_REQS_PARAM
F 40 10 mem_data_credits
DESC Credits to advertise for Mem Data channel at init
PAR CCLA_RX_STL_BUFFER_DEPTH_PARAM
R 0x1118 64 RO ROOT por_cxlapb_link_rx_credit_return_stat
RESET 0x0 0x3ffffffffffff
DESC CXL Link Rx Credit Return Status Register
F 0 10 cache_req_credits
DESC Running snapshot of accumulated Cache Request credits to be returned
F 10 10 cache_rsp_credits
DESC Running snapshot of accumulated Cache Response credits to be returned
F 20 10 cache_data_credits
DESC Running snapshot of accumulated Cache Data credits to be returned
F 30 10 mem_req_rsp_credits
DESC Running snapshot of accumulated Mem Request or Response credits to be returned
F 40 10 mem_data_credits
DESC Running snapshot of accumulated Mem Data credits to be returned
R 0x1120 64 RO ROOT por_cxlapb_link_tx_credit_stat
RESET 0x0 0x3ffffffffffff
DESC CXL Link Tx Credit Status Register
F 0 10 cache_req_credits
DESC Running snapshot of accumulated Cache Request credits for TX
F 10 10 cache_rsp_credits
DESC Running snapshot of accumulated Cache Response credits for TX
F 20 10 cache_data_credits
DESC Running snapshot of accumulated Cache Data credits for TX
F 30 10 mem_req_rsp_credits
DESC Running snapshot of accumulated Mem Request or Response credits for TX
F 40 10 mem_data_credits
DESC Running snapshot of accumulated Mem Data credits for TX
R 0x1130 64 - ROOT por_cxlapb_link_layer_defeature
RESET 0x0 0x1
DESC CXL Link Layer Defeature Register
F 0 1 disable_mdh
DESC Write 1 to disable MDH. Software needs to ensure it programs this value consistently on the UP & DP. After programming, a warm reset is required for the disable to take effect.
R 0x1200 32 ROV ROOT por_cxlapb_cxl_hdm_decoder_capability
RESET 0x101c14 0x1f3fff
DESC Contains CXL_HDM_Decoder_Capability_Register. Only applicable for Device. Host does not use this register
F 0 4 decoder_count
DESC Reports the number of memory address decoders implemented by the component. 0 1 Decoder 1 2 Decoders 2 4 Decoders 36 Decoders 48 Decoders 510 Decoders All other values are reserved
F 4 4 target_count
DESC The number of target ports each decoder supports (applicable to Upstream Switch Port and Root Port only). Maximum of 8. 1 1 target port 2 2 target ports 4 4 target ports 8 8 target ports All other values are reserved
F 8 1 interleave_support_11
DESC If set  the component supports interleaving based on Address bit 11  Address bit 10  Address bit 9 and Address bit 8. Root Ports and Upstream Switch Ports shall always set this bit indicating support for interleaving based on Address bit 11-8.
F 9 1 interleave_support_14
DESC If set  the component supports interleaving based on Address bit 14  Address bit 13 and Address bit 12. Root ports and switches shall always set this bit indicating support for interleaving based on Address bits 14-12.
F 10 1 poison_on_decode_err
DESC If set  the component is capable of returning poison on read access to addresses that are not positively decoded by any HDM Decoders in this component. If clear  the component is not capable of returning poison under such scenarios.
F 11 1 interleave_capability_3_6_12_way
DESC If set  the component is capable of returning poison on read access to addresses that are not positively decoded by any HDM Decoders in this component. If clear  the component is not capable of returning poison under such scenarios.
F 12 1 interleave_capability_16
DESC If set  the component is capable of returning poison on read access to addresses that are not positively decoded by any HDM Decoders in this component. If clear  the component is not capable of returning poison under such scenarios.
F 13 1 uio_capable
DESC If set  the component is capable of returning poison on read access to addresses that are not positively decoded by any HDM Decoders in this component. If clear  the component is not capable of returning poison under such scenarios.
F 16 4 uio_capabale_decoder_count
DESC If set  the component is capable of returning poison on read access to addresses that are not positively decoded by any HDM Decoders in this component. If clear  the component is not capable of returning poison under such scenarios.
F 20 1 memdata_nxm_capable
DESC If set, the component supports MemData-NXM opcode. If cleared, the component does not support MemData-NXM opcode. All 256B Flit mode-capable components shall set this bit to 1.
R 0x1204 32 V ROOT por_cxlapb_cxl_hdm_decoder_global_control
RESET 0x0 0x3
DESC Contains CXL_HDM_Decoder_Global_Control_Register. Only applicable for Device. Host does not use this register 
F 0 1 poison_on_decode_err
DESC  This bit is RO and is hard-wired to 0 if Poison On Decode Error Capability=0. If set  the component returns poison on read access to addresses that are not positively decoded by the component. If clear  the component returns all 1s data without a poison under such scenarios.
F 1 1 hdm_decoder_enable
DESC This bit is only applicable to CXL.mem devices and shall return 0 on Root Ports and Upstream Switch Ports. When this bit is set  device shall use HDM decoders to decode CXL.mem transactions and not use HDM Base registers in DVSEC ID 0. Root Ports and Upstream Switch Ports always use HDM Decoders to decode CXL.mem transactions.
R 0x1210 32 - ROOT por_cxlapb_cxl_hdm_decoder_0_base_low
RESET 0x0 0xf0000000
DESC Contains CXL_HDM_Decoder_0_Base_High_Register. Only applicable for Device. Host does not use this register
F 28 4 memory_base_low_0
DESC Corresponds to bits 31:28 of the base of the address range managed by decoder 0
R 0x1214 32 - ROOT por_cxlapb_cxl_hdm_decoder_0_base_high
RESET 0x0 0xffffffff
DESC Contains CXL_HDM_Decoder_0_Base_Low_Register. Only applicable for Device. Host does not use this register
F 0 32 memory_base_high_0
DESC Corresponds to bits 63:32 of the base of the address range managed by decoder 0.
R 0x1218 32 - ROOT por_cxlapb_cxl_hdm_decoder_0_size_low
RESET 0x0 0xf0000000
