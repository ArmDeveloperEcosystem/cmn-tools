GROUP por_sbsx_registers
R 0x0 64 RO - por_sbsx_node_info
RESET 0x7 0xffffffffffff
DESC Provides component identification information.
F 0 16 node_type
DESC CMN node type identifier
F 16 16 node_id
DESC Component node ID
PAR NODEID_PARAM
F 32 16 logical_id
DESC Component logical ID
PAR LOGICALID_PARAM
R 0x80 64 RO - por_sbsx_child_info
RESET 0x0 0xffffffff
DESC Provides component child identification information.
F 0 16 child_count
DESC Number of child nodes; used in discovery process
F 16 16 child_ptr_offset
DESC Starting register offset which contains pointers to the child nodes
R 0x900 64 RO - por_sbsx_unit_info
RESET 0x400010082011 0x3ffffffffff91
DESC Provides component identification information for SBSX.
F 0 1 axdata_width
DESC Data width on ACE-Lite/AXI4 interface 1'b0: 128 bits 1'b1: 256 bits
PAR SBSX_AXDATA256_EN_PARAM
F 4 1 axdata_poison_en
DESC Data poison support on ACE-Lite/AXI4 interface 1'b0: Not supported 1'b1: Supported
PAR SBSX_AXDATAPOISON_EN_PARAM
F 7 9 num_outstanding_reads
DESC Maximum number of outstanding AXI read requests from SBSX
PAR SBSX_NUM_DART_PARAM
F 16 5 num_wr_data_buf
DESC Number of write data buffers in SBSX
PAR SBSX_NUM_WR_BUF_PARAM
F 21 1 ax_mpam_en
DESC MPAM enable on ACE-Lite/AXI4 interface 1'b1: Enabled 1'b0: Not enabled
PAR SBSX_AXMPAM_EN_PARAM
F 22 1 ax_cmo_on_aw
DESC Write Channel CMOs enable on ACE-Lite/AXI4 interface 1'b1: Enabled 1'b0: Not enabled
PAR SBSX_CMO_ON_AW_PARAM
F 23 8 mtu_num_rd_data_buf
DESC Number of mtu read data buffers in SBSX
PAR SBSX_MTU_NUM_RD_DATA_BUF_PARAM
F 31 1 pab_en
DESC PUB AUB bridge enable 1'b1: Enabled 1'b0: Not enabled
PAR SBSX_PAB_EN_PARAM
F 32 8 pab_logicalid
DESC PUB AUB bridge Logical ID
PAR PAB_LOGICALID_PARAM
F 40 1 ax_mecid_en
DESC MECID enable on ACE-Lite/AXI4 interface 1'b1: Enabled 1'b0: Not enabled
PAR SBSX_AXMECID_EN_PARAM
F 41 9 num_persist_trk_entries
DESC Number of entries in persist/tagmatch tracker. Size 0 indicates tracker is disabled.
PAR SBSX_NUM_PERST_TAGM_TRK_PARAM
R 0x980 64 - ROOT por_sbsx_rcr
RESET 0x0 0x81
DESC Root register access override.
F 0 1 cfg_ctl
DESC Allows Root override of the configuration control register
F 7 1 ras
DESC Allow Root override of the RAS registers
R 0x988 64 - S por_sbsx_scr
RESET 0x0 0x81
DESC Secure register access override.
F 0 1 cfg_ctl
DESC Allows Secure override of the configuration control register
F 7 1 ras
DESC Allow Secure override of the RAS registers
R 0xa00 64 - ROOT por_sbsx_cfg_ctl
RESET 0x0 0xff
DESC Functions as the configuration control register for SBSX bridge.
RGO por_sbsx_rcr.cfg_ctl
SGO por_sbsx_scr.cfg_ctl
F 0 1 disable_early_cmo_comp
DESC Disables Early Comp for CMOs in SBSX to HNF.
F 1 1 disable_write_zero
DESC Disables WriteZero Op on AXI.
F 2 1 disable_prefetch
DESC Disables Prefetches on AXI.
F 3 1 disable_cmo_prop
DESC Disables CMO propagation on ACE.
F 4 1 disable_wr_plus_cmo_prop
DESC Disables Write_plus_CMO propagation on ACE.
F 5 1 force_ncacheable_ncpybk_wr_late_comp
DESC Late Comp for Non-cacheable Non-CopyBack Writes. Overrides EWA. Not applicable to Writes where DoDWT is set.
F 6 1 force_cacheable_ncpybk_wr_late_comp
DESC Late Comp for Cacheable Non-CopyBack Writes. Overrides EWA. Not applicable to Writes where DoDWT is set.
F 7 1 disable_cmo_popa
DESC Disables RME CMO PoPA (CleanInvalidPoPA) propagation on ACE, sends CleanInvalid instead.
R 0xa08 64 - ROOT por_sbsx_aux_ctl
RESET 0x0 0x1
DESC Functions as the auxiliary control register for the SBSX bridge.
RGO por_sbsx_rcr.cfg_ctl
SGO por_sbsx_scr.cfg_ctl
F 0 1 clkgate_disable
DESC Disables internal clock gating in SBSX bridge
R 0xa10 64 - ROOT por_sbsx_datasource_ctl
RESET 0x440005 0xdf0045
DESC Functions as the DataSource control register to determine how to drive the CHI DAT.DataSource field.
RGO por_sbsx_rcr.cfg_ctl
SGO por_sbsx_scr.cfg_ctl
F 0 1 cplt_dist_set
DESC Completer Distance Set 1'b0 - Reserved, 1'b1 - Set Completer Distance field to cplt_dist_set_val when sending CompData
F 2 1 cplt_type_set
DESC Completer Type Set 1'b0 - Reserved, 1'b1 - Set Completer Type field to cplt_type_set_val when sending CompData
F 6 1 cplt_func_set
DESC Completer Functional Set 1'b0 - Pass Completer Functional field as-is when sending CompData, 1'b1 - Set Completer Functional field to cplt_func_set_val when sending CompData
F 16 2 cplt_dist_set_val
DESC Completer Distance value to use when cplt_dist_set is set to 1.
F 18 3 cplt_type_set_val
DESC Completer Type value to use when cplt_type_set is set to 1. Supported values are: 3'b001 - DRAM Completer Type, 3'b011 - High Bandwidth Memory (HBM) Completer Type
F 22 2 cplt_func_set_val
DESC Completer Functional value to use when cplt_func_set is set to 1. Supported values are: 2'b00 - PrefetchTgt not useful, 2'b01 - PrefetchTgt useful
R 0xa18 64 - ROOT por_sbsx_cbusy_limit_ctl
RESET 0x483018 0xffffff
DESC Cbusy threshold limits for Request Tracker entries.
RGO por_sbsx_rcr.cfg_ctl
SGO por_sbsx_scr.cfg_ctl
F 0 8 sbsx_cbusy_low_limit
DESC ReqTracker limit for CBusy Low
PAR SBSX_CBUSY_LOW_LIMIT_PARAM
F 8 8 sbsx_cbusy_med_limit
DESC ReqTracker limit for CBusy Med
PAR SBSX_CBUSY_MED_LIMIT_PARAM
F 16 8 sbsx_cbusy_high_limit
DESC ReqTracker limit for CBusy High
PAR SBSX_CBUSY_HIGH_LIMIT_PARAM
R 0xd900 64 - - por_sbsx_pmu_event_sel
RESET 0x0 0x3f3f3f3f
DESC Specifies the PMU event to be counted.
F 0 6 pmu_event0_id
DESC SBSX PMU Event 0 select 6'h00: No event 6'h01: Read request 6'h02: Write request 6'h03: CMO request 6'h04: RETRYACK TXRSP flit sent 6'h05: TXDAT flit seen 6'h06: TXRSP flit seen 6'h11: Read request tracker occupancy count overflow 6'h12: Write request tracker occupancy count overflow 6'h13: CMO request tracker occupancy count overflow 6'h14: WDB occupancy count overflow 6'h15: Read AXI pending tracker occupancy count overflow 6'h16: CMO AXI pending tracker occupancy count overflow 6'h17: RDB occupancy count overflow. (Only when MTU is enabled) 6'h21: ARVALID set without ARREADY 6'h22: AWVALID set without AWREADY 6'h23: WVALID set without WREADY 6'h24: TXDAT stall (TXDAT valid but no link credit available) 6'h25: TXRSP stall (TXRSP valid but no link credit available) NOTE: All other encodings are reserved.
F 8 6 pmu_event1_id
DESC SBSX PMU Event 1 select; see pmu_event0_id for encodings
F 16 6 pmu_event2_id
DESC SBSX PMU Event 2 select; see pmu_event0_id for encodings
F 24 6 pmu_event3_id
DESC SBSX PMU Event 3 select; see pmu_event0_id for encodings
R 0xe000 64 RO ROOT por_sbsx_errfr
RESET 0x20000801001a2 0x720000803ffff3
DESC Functions as the error feature register.
RGO por_sbsx_rcr.ras
SGO por_sbsx_scr.ras
F 0 2 ed
DESC Error reporting and logging control 2'b10: Error reporting and logging is controllable using por_sbsx_errctlr.ED
F 4 2 ui
DESC Error Recovery Interrupt from Uncorrected errors control 2'b00: Does not support Error Recovery Interrupt from Uncorrected errors 2'b10: Support Error Recovery Interrupt on Uncorrected errors and controllable using por_sbsx_errctlr.UI.
F 6 2 fi
DESC Fault Handling Interrupt from Deferred and Uncorrected errors control 2'b00: Does not support Fault Handling Interrupt from Deferred and Uncorrected errors 2'b10: Support Fault Handling Interrupt on Deferred and Uncorrected errors and controllable using por_sbsx_errctlr.FI.
F 8 2 ue
DESC In-band error response is always on
F 10 2 cfi
DESC Fault Handling Interrupt from Corrected errors control 2'b00: Does not support Fault Handling Interrupt from Corrected errors 2'b10: Support Fault Handling Interrupt on corrected errors and controllable using por_sbsx_errctlr.CFI.
F 12 3 cec
DESC Standard corrected error counter 3'b000: Does not implement standard error counter model 3'b100: Implements a 16-bit Corrected error counter
F 15 1 rp
DESC Repeat counter (valid only when por_sbsx_errfr.CEC != 3'b000.) 1'b0: Invalid; 1'b1: Implements a first (repeat) counter and a second (other) counter
F 16 2 dui
DESC Error Recovery Interrupt from Deferred errors control 2'b00: Does not support Error Recovery Interrupt from Deferred errors 2'b10: Support Error Recovery Interrupt from Deferred errors and controllable using por_sbsx_errctlr.DUI.
F 18 2 ceo
DESC Corrected Error overwrite. 2'b00: Keep the first Corrected Error syndrome
F 20 2 inj
DESC Fault Injection Extension. 2'b01: Support Common Fault Injection Model Extension
F 31 1 frx
DESC Feature Register extension. 1'b1: por_sbsx_errfr[63:48] is architecturally defined
F 49 1 ueu
DESC Unrecoverable Error recording 1'b0: Unrecoverable Error not supported 1'b1: Unrecoverable Error supported
F 52 1 de
DESC Deferred Error recording 1'b0: Deferred Error not supported 1'b1: Deffered Error supported
F 53 2 ce
DESC Corrected Error recording 2'b00: Corrected Error not supported 2'b10: Non-specific Corrected Error supported
R 0xe008 64 - ROOT por_sbsx_errctlr
RESET 0x0 0x50d
DESC Functions as the error control register. Controls whether specific error-handling interrupts and error detection/deferment are enabled.
RGO por_sbsx_rcr.ras
SGO por_sbsx_scr.ras
F 0 1 ed
DESC Enables error detection as specified in por_sbsx_errfr.ED
F 2 1 ui
DESC Enables error recovery interrupt for uncorrected error as specified in por_sbsx_errfr.UI
F 3 1 fi
DESC Enables fault handling interrupt for uncorrected and deferred errors as specified in por_sbsx_errfr.FI
F 8 1 cfi
DESC Enables fault handling interrupt for corrected error as specified in por_sbsx_errfr.CFI
F 10 1 dui
DESC Enables error recovery interrupt for deferred error as specified in por_sbsx_errfr.DUI
R 0xe010 64 - ROOT por_sbsx_errstatus
RESET 0x0 0xfff0ffff
DESC Functions as the error status register. When V is set, only write exact same value as in the register can clear it.
RGO por_sbsx_rcr.ras
SGO por_sbsx_scr.ras
F 31 1 av W1C
DESC Address register valid 1'b1: Address is valid; por_sbsx_erraddr contains a physical address for that recorded error 1'b0: Address is not valid
F 30 1 v W1C
DESC Status register valid 1'b1: At least one error recorded; register is valid 1'b0: No errors recorded
F 29 1 ue W1C
DESC Uncorrected errors 1'b1: At least one error detected that is not corrected and is not deferred to a subordinate 1'b0: No uncorrected errors detected
F 28 1 er W1C
DESC Error Reported 1'b1: In-band error response signaled to the Requester 1'b0: No in-band error response signaled
F 27 1 of W1C
DESC Overflow; asserted when multiple errors are detected 1'b1: More than one error detected 1'b0: None or only one error detected as described by UE/DE/CE fields
F 26 1 mv W1C
DESC por_sbsx_errmisc<01> valid 1'b1: Miscellaneous registers are valid 1'b0: Miscellaneous registers are not valid
F 24 2 ce W1C
DESC Corrected errors 2'b10: At least one corrected error recorded 2'b00: No corrected errors recorded
F 23 1 de W1C
DESC Deferred errors 1'b1: At least one error is not corrected and is deferred 1'b0: No errors deferred
F 22 1 pn W1C
DESC Poison 1'b1: Uncorrected error recorded because a poison value was consumed 1'b0: Other cases
F 20 2 uet W1C
DESC Uncorrected Error Type, valid only when UE != 0 2'b01: Uncorrected error, Unrecoverable error (UEU). 2'b00: Invalid
F 8 8 ierr W1C
DESC Implementation-defined primary error code. 8'h00: No error 8'h01: Partner implementation defined error
F 0 8 serr W1C
DESC Architecturally-defined primary error code. 8'h00: No error 8'h01: IMPLEMENTATION DEFINED error.  Refer to por_sbsx_errmisc1.ERRSRC for error type details.
R 0xe018 64 - ROOT por_sbsx_erraddr
RESET 0x0 0xc80fffffffffffff
DESC Contains the error record address.
RGO por_sbsx_rcr.ras
SGO por_sbsx_scr.ras
F 0 52 addr
DESC Transaction address
F 59 1 nse
DESC Root status of transaction.  PAS[1] of the transaction.
F 62 1 si
DESC {NSE,NS} valid 1'b0: PAS field is valid 1'b1: PAS field is invalid
F 63 1 ns
DESC Security status of transaction.  PAS[0] of the transaction.
R 0xe028 64 - ROOT por_sbsx_errmisc1
RESET 0x0 0x7f017ff0
DESC Functions as the miscellaneous error register 1. Contains miscellaneous information about deferred/uncorrected errors.
RGO por_sbsx_rcr.ras
SGO por_sbsx_scr.ras
F 4 11 srcid
DESC Error source ID
F 16 1 optype
DESC Error opcode type 1'b1: WR_NO_SNP_PTL (partial) 1'b0: WR_NO_SNP_FULL
F 24 4 memattr
DESC Error memory attributes
F 28 3 size
DESC Error transaction size
R 0xe040 64 RO - por_sbsx_errfr_ns
RESET 0x20000801001a2 0x720000803ffff3
DESC Functions as the non-secure error feature register.
F 0 2 ed
DESC Error reporting and logging control 2'b10: Error reporting and logging is controllable using por_sbsx_errctlr.ED
F 4 2 ui
DESC Error Recovery Interrupt from Uncorrected errors control 2'b00: Does not support Error Recovery Interrupt from Uncorrected errors 2'b10: Support Error Recovery Interrupt on Uncorrected errors and controllable using por_sbsx_errctlr.UI.
F 6 2 fi
DESC Fault Handling Interrupt from Deferred and Uncorrected errors control 2'b00: Does not support Fault Handling Interrupt from Deferred and Uncorrected errors 2'b10: Support Fault Handling Interrupt on Deferred and Uncorrected errors and controllable using por_sbsx_errctlr.FI.
F 8 2 ue
DESC In-band error response is always on
F 10 2 cfi
DESC Fault Handling Interrupt from Corrected errors control 2'b00: Does not support Fault Handling Interrupt from Corrected errors 2'b10: Support Fault Handling Interrupt on corrected errors and controllable using por_sbsx_errctlr.CFI.
F 12 3 cec
DESC Standard corrected error counter 3'b000: Does not implement standard error counter model 3'b100: Implements a 16-bit Corrected error counter
F 15 1 rp
DESC Repeat counter (valid only when por_sbsx_errfr_NS.CEC != 3'b000.) 1'b1: Implements a first (repeat) counter and a second (other)
F 16 2 dui
DESC Error Recovery Interrupt from Deferred errors control 2'b00: Does not support Error Recovery Interrupt from Deferred errors 2'b10: Support Error Recovery Interrupt from Deferred errors and controllable using por_sbsx_errctlr.DUI.
F 18 2 ceo
DESC Corrected Error overwrite. 2'b00: Keep the first Corrected Error syndrome
F 20 2 inj
DESC Fault Injection Extension. 2'b01: Support Common Fault Injection Model Extension
F 31 1 frx
DESC Feature Register extension. 1'b1: por_sbsx_errfr_NS[63:48] is architecturally defined
F 49 1 ueu
DESC Unrecoverable Error recording 1'b0: Unrecoverable Error not supported 1'b1: Unrecoverable Error supported
F 52 1 de
DESC Deferred Error recording 1'b0: Deferred Error not supported 1'b1: Deffered Error supported
F 53 2 ce
DESC Corrected Error recording 2'b00: Corrected Error not supported 2'b10: Non-specific Corrected Error supported
R 0xe048 64 - - por_sbsx_errctlr_ns
RESET 0x0 0x50d
DESC Functions as the non-secure error control register. Controls whether specific error-handling interrupts and error detection/deferment are enabled.
F 0 1 ed
DESC Enables error detection as specified in por_sbsx_errfr_NS.ED
F 2 1 ui
DESC Enables error recovery interrupt for uncorrected error as specified in por_sbsx_errfr_NS.UI
F 3 1 fi
DESC Enables fault handling interrupt for uncorrected and deferred errors as specified in por_sbsx_errfr_NS.FI
F 8 1 cfi
DESC Enables fault handling interrupt for corrected error as specified in por_sbsx_errfr_NS.CFI
F 10 1 dui
DESC Enables error recovery interrupt for deferred error as specified in por_sbsx_errfr_NS.DUI
R 0xe050 64 - - por_sbsx_errstatus_ns
RESET 0x0 0xfff0ffff
DESC Functions as the non-secure error status register. When V is set, only write exact same value as in the register can clear it.
F 31 1 av W1C
DESC Address register valid 1'b1: Address is valid; por_sbsx_erraddr contains a physical address for that recorded error 1'b0: Address is not valid
F 30 1 v W1C
DESC Status register valid 1'b1: At least one error recorded; register is valid 1'b0: No errors recorded
F 29 1 ue W1C
DESC Uncorrected errors 1'b1: At least one error detected that is not corrected and is not deferred to a subordinate 1'b0: No uncorrected errors detected
F 28 1 er W1C
DESC Error Reported 1'b1: In-band error response signaled to the Requester 1'b0: No in-band error response signaled
F 27 1 of W1C
DESC Overflow; asserted when multiple errors are detected 1'b1: More than one error detected 1'b0: None or only one error detected as described by UE/DE/CE fields
F 26 1 mv W1C
DESC por_sbsx_errmisc<01> valid 1'b1: Miscellaneous registers are valid 1'b0: Miscellaneous registers are not valid
F 24 2 ce W1C
DESC Corrected errors 2'b10: At least one corrected error recorded 2'b00: No corrected errors recorded
F 23 1 de W1C
DESC Deferred errors 1'b1: At least one error is not corrected and is deferred 1'b0: No errors deferred
F 22 1 pn W1C
DESC Poison 1'b1: Uncorrected error recorded because a poison value was consumed 1'b0: Other cases
F 20 2 uet W1C
DESC Uncorrected Error Type, valid only when UE != 0 2'b01: Uncorrected error, Unrecoverable error (UEU). 2'b00: Invalid
F 8 8 ierr W1C
DESC Implementation-defined primary error code. 8'h00: No error 8'h01: Partner implementation defined error
F 0 8 serr W1C
DESC Architecturally-defined primary error code. 8'h00: No error 8'h01: IMPLEMENTATION DEFINED error.  Refer to por_sbsx_errmisc1_NS.ERRSRC for error type details.
R 0xe058 64 - - por_sbsx_erraddr_ns
RESET 0x0 0xc80fffffffffffff
DESC Contains the non-secure error record address.
F 0 52 addr
DESC Transaction address
F 59 1 nse
DESC Root status of transaction.  PAS[1] of the transaction.
F 62 1 si
DESC {NSE,NS} valid 1'b0: PAS field is valid 1'b1: PAS field is invalid
F 63 1 ns
DESC Security status of transaction.  PAS[0] of the transaction.
R 0xe068 64 - - por_sbsx_errmisc1_ns
RESET 0x0 0x7f017ff0
DESC Functions as the non-secure miscellaneous error register 1. Contains miscellaneous information about deferred/uncorrected errors.
F 4 11 srcid
DESC Error source ID
F 16 1 optype
DESC Error opcode type 1'b1: WR_NO_SNP_PTL (partial) 1'b0: WR_NO_SNP_FULL
F 24 4 memattr
DESC Error memory attributes
F 28 3 size
DESC Error transaction size
R 0xe800 64 RO ROOT por_sbsx_errpfgf
RESET 0x30001e05 0x30001ee5
DESC Functions as the Pseudo-fault Generation Feature Register.
RGO por_sbsx_rcr.ras
SGO por_sbsx_scr.ras
F 29 1 syn
DESC Fault syndrome injection. 1'b1: Fault injection does not update ERRSTATUS.SERR
F 28 1 na
DESC No access required. 1'b1: Fault injection does not require cfg access
F 12 1 mv
DESC Miscellaneous syndrome. 1'b1: Fault injection update ERRSTATUS.MV to ERRPFGCTL.MV
F 11 1 av
DESC Address syndrome. 1'b1: Fault injection update ERRSTATUS.AV to ERRPFGCTL.AV
F 10 1 pn
DESC Poison flag 1'b1: Fault injection update ERRSTATUS.PN to ERRPFGCTL.PN
F 9 1 er
DESC Error reported flag 1'b1: Fault injection update ERRSTATUS.ER to ERRPFGCTL.ER
F 6 2 ce
DESC Corrected Error generation. 2'b00: No Corrected error generation. 2'b01: Non specific Corrected error injection. If ERRPFGCTL.CE == 1, update ERRSTATUS.CE to 2'b10; else, update ERRSTATUS.CE to 2'b00
F 5 1 de
DESC Deferred error generation. 1'b0: No Deferred error generation. 1'b1: Fault injection update ERRSTATUS.DE to ERRPFGCTL.DE
F 2 1 ueu
DESC Uncorrected error generation. 1'b1: If ERRPFGCTL.UEU == 1, update ERRSTATUS.UE to 1'b1 and ERRSTATUS.UET = 2'b01; else, update ERRSTATUS.UE to 1'b0 and ERRSTATUS.UET = 2'b00
F 0 1 of
DESC Overflow flag. 1'b1: Fault injection update ERRSTATUS.OF to ERRPFGCTL.OF
R 0xe808 64 - ROOT por_sbsx_errpfgctl
RESET 0x0 0x80001ee5
DESC Functions as the Pseudo-fault Generation Control Register.
RGO por_sbsx_rcr.ras
SGO por_sbsx_scr.ras
F 31 1 cdnen
DESC Countdown Enable. 1'b0: Countdown disabled. 1'b1: Error generation counter is set to ERRPFGCDN.CDN, and countdown enabled.
F 12 1 mv
DESC Miscellaneous syndrome. 1'b0: Fault injection update ERRSTATUS.MV to 1'b0 1'b1: Fault injection update ERRSTATUS.MV to 1'b1
F 11 1 av
DESC Address syndrome. 1'b0: Fault injection update ERRSTATUS.AV to 1'b0 1'b1: Fault injection update ERRSTATUS.AV to 1'b1
F 10 1 pn
DESC Poison flag 1'b0: Fault injection update ERRSTATUS.PN to 1'b0 1'b1: Fault injection update ERRSTATUS.PN to 1'b1
F 9 1 er
DESC Error reported flag 1'b0: Fault injection update ERRSTATUS.ER to 1'b0 1'b1: Fault injection update ERRSTATUS.ER to 1'b1
F 6 2 ce
DESC Corrected Error generation. 2'b00: Non Corrected error is injected. Fault injection update ERRSTATUS.CE to 2'b00 2'b01: Non specific Corrected error injection. Fault injection update ERRSTATUS.CE to 2'b10
F 5 1 de
DESC Deferred error generation. 1'b0: Fault injection update ERRSTATUS.DE to 1'b0 1'b1: Fault injection update ERRSTATUS.DE to 1'b1
F 2 1 ueu
DESC Uncorrected error generation. 1'b0: Fault injection update ERRSTATUS.UE to 1'b0 and ERRSTATUS.UET = 2'b00 1'b1: Fault injection update ERRSTATUS.UE to 1'b1 and ERRSTATUS.UET = 2'b01
F 0 1 of
DESC Overflow flag. 1'b0: Fault injection update ERRSTATUS.OF to 1'b0 1'b1: Fault injection update ERRSTATUS.OF to 1'b1
