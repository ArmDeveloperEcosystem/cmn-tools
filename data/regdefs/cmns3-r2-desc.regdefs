R 0xd900 64 - - por_rni_pmu_event_sel
RESET 0x0 0x7f7f7f7f
DESC Specifies the PMU event to be counted.
F 0 7 pmu_event0_id
DESC RN-I PMU Event 0 ID 7'h00: No event 7'h01: Port S0 RDataBeats 7'h02: Port S1 RDataBeats 7'h03: Port S2 RDataBeats 7'h04: RXDAT flits received 7'h05: TXDAT flits sent 7'h06: Total TXREQ flits sent 7'h07: Retried TXREQ flits sent 7'h08: RRT occupancy count overflow_slice0 7'h09: WRT occupancy count overflow 7'h0A: Replayed TXREQ flits 7'h0B: WriteCancel sent 7'h0C: Port S0 WDataBeats 7'h0D: Port S1 WDataBeats 7'h0E: Port S2 WDataBeats 7'h0F: RRT allocation 7'h10: WRT allocation 7'h11: PADB occupancy count overflow 7'h12: RPDB occupancy count overflow 7'h13: RRT occupancy count overflow_slice1 7'h14: RRT occupancy count overflow_slice2 7'h15: RRT occupancy count overflow_slice3 7'h16: WRT request throttled 7'h17: RNI backpressure CHI LDB full 7'h18: RRT normal rd req occupancy count overflow_slice0 7'h19: RRT normal rd req occupancy count overflow_slice1 7'h1A: RRT normal rd req occupancy count overflow_slice2 7'h1B: RRT normal rd req occupancy count overflow_slice3 7'h1C: RRT PCIe RD burst req occupancy count overflow_slice0 7'h1D: RRT PCIe RD burst req occupancy count overflow_slice1 7'h1E: RRT PCIe RD burst req occupancy count overflow_slice2 7'h1F: RRT PCIe RD burst req occupancy count overflow_slice3 7'h20: RRT PCIe RD burst allocation 7'h21: Compressed AWID ordering 7'h22: Atomic data buffer allocation 7'h23: Atomic data buffer occupancy 7'h24: RRT occupancy count overflow_slice4 7'h25: RRT occupancy count overflow_slice5 7'h26: RRT occupancy count overflow_slice6 7'h27: RRT occupancy count overflow_slice7 7'h28: RRT normal rd req occupancy count overflow_slice4 7'h29: RRT normal rd req occupancy count overflow_slice5 7'h2A: RRT normal rd req occupancy count overflow_slice6 7'h2B: RRT normal rd req occupancy count overflow_slice7 7'h2C: RRT PCIe RD burst req occupancy count overflow_slice4 7'h2D: RRT PCIe RD burst req occupancy count overflow_slice5 7'h2E: RRT PCIe RD burst req occupancy count overflow_slice6 7'h2F: RRT PCIe RD burst req occupancy count overflow_slice7 7'h30: RRT CBUSY throttled 7'h31: RRT CBUSY 3 7'h32: RRT CBUSY 2 7'h33: RRT CBUSY 1 7'h34: RRT CBUSY 0 7'h35: WRT CBUSY throttled 7'h36: WRT CBUSY 3 7'h37: WRT CBUSY 2 7'h38: WRT CBUSY 1 7'h39: WRT CBUSY 0 7'h3A: RRT TXREQ dispatched occupancy count overflow_slice0 7'h3B: RRT TXREQ dispatched occupancy count overflow_slice1 7'h3C: RRT TXREQ dispatched occupancy count overflow_slice2 7'h3D: RRT TXREQ dispatched occupancy count overflow_slice3 7'h3E: RRT TXREQ dispatched occupancy count overflow_slice4 7'h3F: RRT TXREQ dispatched occupancy count overflow_slice5 7'h40: RRT TXREQ dispatched occupancy count overflow_slice6 7'h41: RRT TXREQ dispatched occupancy count overflow_slice7 7'h42: WRT TXREQ dispatched occupancy count overflow
F 8 7 pmu_event1_id
DESC RN-I PMU Event 1 ID; see pmu_event0_id for encodings
F 16 7 pmu_event2_id
DESC RN-I PMU Event 2 ID; see pmu_event0_id for encodings
F 24 7 pmu_event3_id
DESC RN-I PMU Event 3 ID; see pmu_event0_id for encodings
ENDGROUP
GROUP por_rnsam_registers
R 0x0 64 RO - por_rnsam_node_info
RESET 0xf 0xffffffffffff
DESC Provides component identification information.
F 0 16 node_type
DESC CMN node type identifier
F 16 16 node_id
DESC Component node ID
PAR NODEID_PARAM
F 32 16 logical_id
DESC Component logical ID NOTE: RN SAM logical ID is always set to 16'b0.
R 0x80 64 RO - por_rnsam_child_info
RESET 0x0 0xffffffff
DESC Provides component child identification information.
F 0 16 child_count
DESC Number of child nodes; used in discovery process
F 16 16 child_ptr_offset
DESC Starting register offset which contains pointers to the child nodes
R 0x900 64 RO - por_rnsam_unit_info
RESET 0x1100040af084080 0x1ff00ffafffffff
DESC Provides component identification information for RN SAM.
F 0 9 num_hnf
DESC Number of hashed targets supported
PAR POR_RNSAM_NUM_HNF_TGT_PARAM
F 9 7 num_htg
DESC Number of Hashed target groups
PAR POR_RNSAM_NUM_HTG_PARAM
F 16 8 num_sys_cache_group
DESC Number of system cache groups supported
PAR POR_RNSAM_NUM_SCGROUP_PARAM
F 24 1 htg_np2_hash_en
DESC Enable non-power of two hash scheme
PAR POR_RNSAM_NP2_EN_PARAM
F 25 1 htg_hier_hash_en
DESC Enable Hierarchical hashing scheme
PAR POR_RNSAM_HIER_HASH_EN_PARAM
F 26 1 htg_axid_hash_en
DESC Enable AXID based hashing scheme
PAR POR_RNSAM_AXID_HASH_EN_PARAM
F 27 1 htg_range_comp_en
DESC Define start and end address for each HTG region
PAR POR_RNSAM_HTG_RCOMP_EN_PARAM
F 29 1 rnsam_prefetch_en
DESC RNSAM prefetch enabled
PAR POR_RNSAM_PREFETCH_EN_PARAM
F 31 1 nonhash_range_comp_en
DESC Define start and end address for each nonhashed region
PAR POR_RNSAM_NONHASH_RCOMP_EN_PARAM
F 32 8 num_non_hash_group
DESC Number of non-hashed groups supported
PAR POR_RNSAM_NUM_NONHASHGROUP_PARAM
F 48 8 num_qos_regions
DESC Number of QOS regions
PAR POR_RNSAM_NUM_QOS_REG_PARAM
F 56 1 flexible_targetid_en
DESC flexible target enable to preserve backward compatability
PAR POR_RNSAM_FLEX_TGTID_EN_PARAM
R 0x908 64 RO - por_rnsam_unit_info1
RESET 0x1634840208210 0xff7df7f7dffff
DESC Provides component identification information for RN SAM.
F 0 5 htg_rcomp_lsb
DESC HTG RCOMP LSB bit position defining minimum region size
PAR POR_RNSAM_HTG_RCOMP_LSB_PARAM
F 5 5 nonhash_rcomp_lsb
DESC NONHASH RCOMP LSB bit position defining minimum region size
PAR POR_RNSAM_NONHASH_RCOMP_LSB_PARAM
F 10 7 rnsam_num_cpa_groups
DESC Number of CPA groups
PAR POR_RNSAM_NUM_CPA_GRP_PARAM
F 18 5 rnsam_pftgt_num_scg
DESC Number of system cache groups enabled for prefetch targets
PAR POR_RNSAM_PFTGT_NUM_SCG_PARAM
F 24 7 rnsam_pftgt_num_nonhash
DESC Number of prefetch non-hashed regions supported per System Cache Group by the RNSAM
PAR POR_RNSAM_PFTGT_NUM_NONHASH_PSCG_PARAM
F 32 5 rnsam_pftgt_num_htg
DESC Number of prefetch HTG regions supported per System Cache Group by the RNSAM
PAR POR_RNSAM_PFTGT_NUM_HTG_PSCG_PARAM
F 38 1 rnsam_pftgt_default_hashed_group_en
DESC Enable default hashed group for prefetch transactions. To support backward compatible, set this parameter
PAR POR_RNSAM_PFTGT_DEF_HASHED_GRP_EN_PARAM
F 39 4 rnsam_customs_regs
DESC Number of customer specific registers for customer implemented logic
PAR POR_RNSAM_CUSTOM_REGS_PARAM
F 44 8 rnsam_num_calrnfhni
DESC Enables RNSAM_NUM_CALRNFHNI hashing
PAR POR_RNSAM_NUM_CALRNFHNI_PARAM
R 0x910 64 RO - por_rnsam_unit_info2
RESET 0x821610201002040 0x7fbfeff7fbfdfeff
DESC Provides component identification information for RN SAM.
F 0 8 num_hnp
DESC Number of HNP targets supported
PAR POR_RNSAM_NUM_HNP_TGT_PARAM
F 9 8 num_misc
DESC Number of MISC targets supported
PAR POR_RNSAM_NUM_MISC_TGT_PARAM
F 18 8 num_ccg
DESC Number of CCG targets supported
PAR POR_RNSAM_NUM_CXG_TGT_PARAM
F 27 8 num_snf
DESC Number of SNF targets supported
PAR POR_RNSAM_NUM_SNF_TGT_PARAM
F 36 8 num_ccgsa
DESC Number of CCG-SA targets supported
PAR POR_HNSAM_NUM_CCG_SA_TGT_PARAM
F 45 1 rnsam_cpa_en
DESC RNSAM supports CCG logic
PAR POR_RNSAM_CML_ENABLE_PARAM
F 46 1 rnsam_lcn_htg_en
DESC Enables LCN HTG (standalone hashing group for NUCA)
PAR POR_RNSAM_LCN_HTG_PARAM
F 47 1 rnsam_compact_hn_tables_en
DESC RNSAM COMPACT_HN_TABLES scheme enabled
PAR POR_RNSAM_COMPACT_HN_TABLES_EN_PARAM
F 48 1 hnsam_range_comp_en
DESC Define start and end address for each HNSAM regions
PAR POR_HNSAM_RCOMP_EN_PARAM
F 49 5 hnsam_rcomp_lsb
DESC HNSAM RCOMP LSB bit position defining minimum region size
PAR POR_HNSAM_RCOMP_LSB_PARAM
F 55 8 rnsam_num_hn_tgtid_override
DESC Number of HN TgtID override CAM entries
PAR POR_RNSAM_NUM_HN_TGTID_OVERRIDE_PARAM
R 0x980 64 - S por_rnsam_scr
RESET 0x0 0x1
DESC Secure register access override.
F 0 1 mem_range
DESC Allows Secure override of the memory range registers
R 0x988 64 - ROOT por_rnsam_rcr
RESET 0x0 0x1
DESC Root register access override.
F 0 1 mem_range
DESC Allows Root override of the memory range registers
R 0xc00 64 - ROOT non_hash_mem_region_reg0
RESET 0x0 0x7f0fffffffff7edd
DESC Configures non-hashed memory regions
RGO por_rnsam_rcr.mem_range
SGO por_rnsam_scr.mem_range
F 56 7 region0_size
DESC Memory region 0 size CONSTRAINT: Memory region must be a power of two, from minimum size supported to maximum memory size (2^address width).
F 16 36 region0_base_addr
DESC Bits [51:16] of base address of the range, LSB bit is defined by the parameter POR_RNSAM_NONHASH_RCOMP_LSB_PARAM
F 9 6 region0_memory_attributes
