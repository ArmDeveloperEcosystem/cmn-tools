DESC TC set address for ECC Single bit error
R 0xe800 64 RO ROOT por_mtu_errpfgf
RESET 0x30001e45 0x30001ee5
DESC Functions as the Root PAS Pseudo-fault Generation Feature Register.
RGO por_mtu_rcr.ras
SGO por_mtu_scr.ras
F 29 1 syn
DESC Fault syndrome injection. 1'b1: Fault injection does not update por_mtu_errstatus.SERR
F 28 1 na
DESC No access required. 1'b1: Fault injection does not require cfg access
F 12 1 mv
DESC Miscellaneous syndrome. 1'b1: Fault injection update por_mtu_errstatus.MV to por_mtu_errpfgctl.MV
F 11 1 av
DESC Address syndrome. 1'b1: Fault injection update por_mtu_errstatus.AV to por_mtu_errpfgctl.AV
F 10 1 pn
DESC Poison flag 1'b1: Fault injection update por_mtu_errstatus.PN to por_mtu_errpfgctl.PN
F 9 1 er
DESC Error reported flag 1'b1: Fault injection update por_mtu_errstatus.ER to por_mtu_errpfgctl.ER
F 6 2 ce
DESC Corrected Error generation. 2'b00: No Corrected error generation. 2'b01: Non specific Corrected error injection. If por_mtu_errpfgctl.CE == 1, update por_mtu_errstatus.CE to 2'b10; else, update por_mtu_errstatus.CE to 2'b00
F 5 1 de
DESC Deferred error generation. 1'b0: Deferred error generation not supported
F 2 1 ueu
DESC Uncorrected error generation. 1'b1: If por_mtu_errpfgctl.UEU == 1, update por_mtu_errstatus.UE to 1'b1 and por_mtu_errstatus.UET = 2'b01; else, update por_mtu_errstatus.UE to 1'b0 and por_mtu_errstatus.UET = 2'b00
F 0 1 of
DESC Overflow flag. 1'b1: Fault injection update por_mtu_errstatus.OF to por_mtu_errpfgctl.OF
R 0xe808 64 - ROOT por_mtu_errpfgctl
RESET 0x0 0x80001ee5
DESC Functions as the Root PAS Pseudo-fault Generation Control Register.
RGO por_mtu_rcr.ras
SGO por_mtu_scr.ras
F 31 1 cdnen
DESC Countdown Enable. 1'b0: Countdown disabled. 1'b1: Error generation counter is set to por_mtu_errpfgctl.CDN, and countdown enabled.
F 12 1 mv
DESC Miscellaneous syndrome. 1'b0: Fault injection update por_mtu_errstatus.MV to 1'b0 1'b1: Fault injection update por_mtu_errstatus.MV to 1'b1
F 11 1 av
DESC Address syndrome. 1'b0: Fault injection update por_mtu_errstatus.AV to 1'b0 1'b1: Fault injection update por_mtu_errstatus.AV to 1'b1
F 10 1 pn
DESC Poison flag 1'b0: Fault injection update por_mtu_errstatus.PN to 1'b0 1'b1: Fault injection update por_mtu_errstatus.PN to 1'b1
F 9 1 er
DESC Error reported flag 1'b0: Fault injection update por_mtu_errstatus.ER to 1'b0 1'b1: Fault injection update por_mtu_errstatus.ER to 1'b1
F 6 2 ce
DESC Corrected Error generation. 2'b00: Non Corrected error is injected. Fault injection update por_mtu_errstatus.CE to 2'b00 2'b01: Non specific Corrected error injection. Fault injection update por_mtu_errstatus.CE to 2'b10
F 5 1 de
DESC Deferred error generation. 1'b0: Deferred error generation not supported
F 2 1 ueu
DESC Uncorrected error generation. 1'b0: Fault injection update por_mtu_errstatus.UE to 1'b0 and por_mtu_errstatus.UET = 2'b00 1'b1: Fault injection update por_mtu_errstatus.UE to 1'b1 and por_mtu_errstatus.UET = 2'b01
F 0 1 of
DESC Overflow flag. 1'b0: Fault injection update por_mtu_errstatus.OF to 1'b0 1'b1: Fault injection update por_mtu_errstatus.OF to 1'b1
R 0xe810 64 - ROOT por_mtu_errpfgcdn
RESET 0x0 0xffffffff
DESC Functions as the Root PAS Pseudo-fault Generation Countdown Register.
RGO por_mtu_rcr.ras
SGO por_mtu_scr.ras
F 0 32 cdn
DESC Countdown value
R 0xe840 64 RO - por_mtu_errpfgf_ns
RESET 0x30001e45 0x30001ee5
DESC Functions as the Non-secure PAS Pseudo-fault Generation Feature Register.
F 29 1 syn
DESC Fault syndrome injection. 1'b1: Fault injection does not update por_mtu_errstatus_NS.SERR
F 28 1 na
DESC No access required. 1'b1: Fault injection does not require cfg access
F 12 1 mv
DESC Miscellaneous syndrome. 1'b1: Fault injection update por_mtu_errstatus_NS.MV to por_mtu_errpfgctl_NS.MV
F 11 1 av
DESC Address syndrome. 1'b1: Fault injection update por_mtu_errstatus.AV to por_mtu_errpfgctl_NS.AV
F 10 1 pn
DESC Poison flag 1'b1: Fault injection update por_mtu_errstatus_NS.PN to por_mtu_errpfgctl_NS.PN
F 9 1 er
DESC Error reported flag 1'b1: Fault injection update por_mtu_errstatus_NS.ER to por_mtu_errpfgctl_NS.ER
F 6 2 ce
DESC Corrected Error generation. 2'b00: No Corrected error generation. 2'b01: Non specific Corrected error injection. If por_mtu_errpfgctl_NS.CE == 1, update por_mtu_errstatus_NS.CE to 2'b10; else, update por_mtu_errstatus_NS.CE to 2'b00
F 5 1 de
DESC Deferred error generation. 1'b0: Deferred error generation not supported
F 2 1 ueu
DESC Uncorrected error generation. 1'b1: If por_mtu_errpfgctl_NS.UEU == 1, update por_mtu_errstatus_NS.UE to 1'b1 and por_mtu_errstatus_NS.UET = 2'b01; else, update por_mtu_errstatus_NS.UE to 1'b0 and por_mtu_errstatus_NS.UET = 2'b00
F 0 1 of
DESC Overflow flag. 1'b1: Fault injection update por_mtu_errstatus_NS.OF to por_mtu_errpfgctl_NS.OF
R 0xe848 64 - - por_mtu_errpfgctl_ns
RESET 0x0 0x80001ee5
DESC Functions as the Non-secure PAS Pseudo-fault Generation Control Register.
F 31 1 cdnen
DESC Countdown Enable. 1'b0: Countdown disabled. 1'b1: Error generation counter is set to por_mtu_errpfgctl_NS.CDN, and countdown enabled.
F 12 1 mv
DESC Miscellaneous syndrome. 1'b0: Fault injection update por_mtu_errstatus_NS.MV to 1'b0 1'b1: Fault injection update por_mtu_errstatus_NS.MV to 1'b1
F 11 1 av
DESC Address syndrome. 1'b0: Fault injection update por_mtu_errstatus_NS.AV to 1'b0 1'b1: Fault injection update por_mtu_errstatus_NS.AV to 1'b1
F 10 1 pn
DESC Poison flag 1'b0: Fault injection update por_mtu_errstatus_NS.PN to 1'b0 1'b1: Fault injection update por_mtu_errstatus_NS.PN to 1'b1
F 9 1 er
DESC Error reported flag 1'b0: Fault injection update por_mtu_errstatus_NS.ER to 1'b0 1'b1: Fault injection update por_mtu_errstatus_NS.ER to 1'b1
F 6 2 ce
DESC Corrected Error generation. 2'b00: Non Corrected error is injected. Fault injection update por_mtu_errstatus_NS.CE to 2'b00 2'b01: Non specific Corrected error injection. Fault injection update por_mtu_errstatus_NS.CE to 2'b10
F 5 1 de
DESC Deferred error generation. 1'b0: Deferred error generation not supported
F 2 1 ueu
DESC Uncorrected error generation. 1'b0: Fault injection update por_mtu_errstatus_NS.UE to 1'b0 and por_mtu_errstatus_NS.UET = 2'b00 1'b1: Fault injection update por_mtu_errstatus_NS.UE to 1'b1 and por_mtu_errstatus_NS.UET = 2'b01
F 0 1 of
DESC Overflow flag. 1'b0: Fault injection update por_mtu_errstatus_NS.OF to 1'b0 1'b1: Fault injection update por_mtu_errstatus_NS.OF to 1'b1
R 0xe850 64 - - por_mtu_errpfgcdn_ns
RESET 0x0 0xffffffff
DESC Functions as the Non-secure PAS Pseudo-fault Generation Countdown Register.
F 0 32 cdn
DESC Countdown value
R 0xed00 64 - ROOT por_mtu_errcapctl
RESET 0x0 0x3
DESC Functions as the error Capture Control Register
RGO por_mtu_rcr.ras
SGO por_mtu_scr.ras
F 0 1 realm_capture_control
DESC Realm Capture Control 1'b0: Transaction with realm PAS captured in root error record 1'b1: Transaction with realm PAS captured in non-secure error record 
F 1 1 secure_capture_control
DESC Secure Capture Control 1'b0: Transaction with secure PAS captured in root error record 1'b1: Transaction with secure PAS captured in non-secure error record 
R 0xee00 64 RO - por_mtu_errgsr
RESET 0x0 0x3
DESC Functions as Error Group Status Register
F 0 2 status
DESC Read-only copy of ERR<n>STATUS.V
R 0xee10 64 RO - por_mtu_erriidr
RESET 0x43b 0xffffff7f
DESC Functions as the implementation identification register.
F 20 12 productid
DESC Product Part number
F 16 4 variant
DESC Component major revision
F 12 4 revision
DESC Component minor revision
F 8 4 implementer_h
DESC Implementer[10:7]
F 0 7 implementer_l
DESC Implementer[6:0]
R 0xefa8 64 RO - por_mtu_errdevaff
RESET 0x0 0xffffffffffffffff
DESC Functions as the device affinity register.
F 0 64 devaff
DESC Device affinity register
R 0xefb8 64 RO - por_mtu_errdevarch
RESET 0x47710a0000000000 0xffffffff00000000
DESC Functions as the device architecture register.
F 32 12 archpart
DESC Architecture Part
F 44 4 archver
DESC Architecture Version
F 48 4 archrevision
DESC Architecture revision
F 52 1 present
DESC Present
F 53 11 architect
DESC Architect
R 0xefc8 64 RO - por_mtu_errdevid
RESET 0x2 0xffff
DESC Functions as the device configuration register
F 0 16 num
DESC Number of error records
R 0xefd0 64 RO - por_mtu_errpidr45
RESET 0x4 0xff
DESC Functions as the identification register for peripheral ID 4 and peripheral ID 5.
F 0 4 des_2
DESC Designer bit[10:7]
F 4 4 size
DESC Size of the RAS component. 4'h0 means 4K block
R 0xefe0 64 RO - por_mtu_errpidr01
RESET 0xb000000000 0xff000000ff
DESC Functions as the identification register for peripheral ID 0 and peripheral ID 1.
F 0 8 part_0
DESC Product ID Part 0
F 32 4 part_1
DESC Product ID Part 1
F 36 4 des_0
DESC Designer bit[3:0]
R 0xefe8 64 RO - por_mtu_errpidr23
RESET 0xb 0xf
DESC Functions as the identification register for peripheral ID 2 and peripheral ID 3.
F 0 3 des_1
DESC Designer bit[6:4]
F 3 1 jedec
DESC JEDEC-assigned JEP106 implementer code is used.
R 0xeff0 64 RO - por_mtu_errcidr01
RESET 0xf00000000d 0xff000000ff
DESC Functions as the identification register for component ID 0 and component ID 1.
F 0 8 prmbl_0
DESC PRMBL_0
F 32 4 prmbl_1
DESC PRMBL_1
F 36 4 comp_class
DESC Component Class
R 0xeff8 64 RO - por_mtu_errcidr23
RESET 0xb100000005 0xff000000ff
DESC Functions as the identification register for component ID 2 and component ID 3.
F 0 8 prmbl_2
DESC PRMBL_2
F 32 8 prmbl_3
DESC PRMBL_3
ENDGROUP
GROUP por_mxp_registers
R 0x0 64 RO - por_mxp_node_info
RESET 0x2000000000006 0xfffffffffffff
DESC Provides component identification information.
F 0 16 node_type
DESC CMN node type identifier
F 16 16 xy_id
DESC Identifies (X,Y) location of XP within the mesh NOTE: The (X,Y) location is specified following the node ID format as defined in Node ID mapping section, with the bottom 3 bits, corresponding to port ID and device ID, set to 0. Bits 31:11 must always be set to 0. The range of bits representing the (X,Y) location varies for different node ID formats.
F 32 16 logical_id
DESC Component logical ID
PAR LOGICALID_PARAM
F 48 4 num_device_port
DESC Number of device ports attached to the MXP. Mesh config = (1x1)? Max. of 6 Device Ports are supported : Max. of 4 Device Ports are supported
PAR MXP_NUM_DEV_PORT_PARAM
R 0x8 64 RO - por_mxp_device_port_connect_info_p0
RESET 0x0 0xffff0fbf
DESC Contains device port connection information for port 0.
F 0 6 device_type_p0
DESC Connected device type 6'b000000: Reserved 6'b000001: RN-I 6'b000010: RN-D 6'b000011: Reserved 6'b000100: RN-F_CHIB 6'b000101: RN-F_CHIB_ESAM 6'b000110: RN-F_CHIA 6'b000111: RN-F_CHIA_ESAM 6'b001000: HN-T 6'b001001: HN-I 6'b001010: HN-D 6'b001011: HN-P 6'b001100: SN-F_CHIC 6'b001101: SBSX 6'b001110: HN-F 6'b001111: SN-F_CHIE 6'b010000: SN-F_CHID 6'b010001: CXHA 6'b010010: CXRA 6'b010011: CXRH 6'b010100: RN-F_CHID 6'b010101: RN-F_CHID_ESAM 6'b010110: RN-F_CHIC 6'b010111: RN-F_CHIC_ESAM 6'b011000: RN-F_CHIE 6'b011001: RN-F_CHIE_ESAM 6'b011010: Reserved 6'b011011: Reserved 6'b011100: MTSX 6'b011101: HN-V 6'b011110: CCG 6'b100000: RN-F_CHIF 6'b100001: RN-F_CHIF_ESAM 6'b100010: SN-F_CHIF 6'b100011-6'111111: Reserved
