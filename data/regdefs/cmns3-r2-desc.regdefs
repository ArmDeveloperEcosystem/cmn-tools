GROUP cmn_hns_registers
R 0x0 64 RO - cmn_hns_node_info
RESET 0x0 0xffffffffffff
DESC Provides component identification information.
F 0 16 node_type
DESC CMN node type identifier
PAR HNS_NODE_TYPE_PARAM
F 16 16 node_id
DESC Component node ID
PAR NODEID_PARAM
F 32 16 logical_id
DESC Component logical ID
PAR LOGICALID_PARAM
R 0x80 64 RO - cmn_hns_child_info
RESET 0x0 0xffffffff
DESC Provides component child identification information.
F 0 16 child_count
DESC Number of child nodes; used in discovery process
F 16 16 child_ptr_offset
DESC Starting register offset which contains pointers to the child nodes
R 0x900 64 RO - cmn_hns_unit_info
RESET 0x2008000000000000 0xf03f007f80000000
DESC Provides component identification information for HN-F.
F 0 4 slc_size
DESC SLC size 4'b0000: No SLC 4'b0001: 128KB 4'b0010: 256KB 4'b0011: 512KB 4'b0100: 1MB 4'b0101: 1.5MB 4'b0110: 2MB 4'b0111: 3MB 4'b1000: 4MB 4'b1001: 384KB
F 4 3 sf_size
DESC SF size 3'b000: (  32KB * sf_num_ways) 3'b001: (  64KB * sf_num_ways) 3'b010: ( 128KB * sf_num_ways) 3'b011: ( 256KB * sf_num_ways) 3'b100: ( 512KB * sf_num_ways) 3'b101: (1024KB * sf_num_ways) 3'b111: (0KB)
F 8 5 slc_num_ways
DESC Number of cache ways in the SLC
F 16 3 tag_ram_lat
DESC SLC tag RAM latency (in cycles)
F 20 3 data_ram_latency
DESC SLC data RAM latency (in cycles)
F 31 8 num_poc_entries
DESC Number of POCQ entries
PAR HNS_NUM_ENTRIES_POCQ_PARAM
F 39 4 mpam_ns_partid
DESC MPAM Non-Secure supported PARTIDs 4'b0000:   1 NS PARTID 4'b0001:   Reserved 4'b0010:   Reserved 4'b0011:   Reserved 4'b0100:   Reserved 4'b0101:  32 NS PARTID 4'b0110:  64 NS PARTID 4'b0111: 128 NS PARTID 4'b1000: 256 NS PARTID 4'b1001: 512 NS PARTID
F 44 4 mpam_s_partid
DESC MPAM Secure supported PARTIDs 4'b0000:   1 S PARTID 4'b0001:   Reserved 4'b0010:   Reserved 4'b0011:   8 S PARTID 4'b0100:  16 S PARTID
F 48 6 mpam_ns_num_csumon
DESC Number of Non-Secure Cache Storage Usage Monitors for MPAM
PAR HNS_MPAM_NS_NUM_CSUMON_PARAM
F 54 6 sf_num_ways
DESC Number of cache ways in the SF
F 60 4 mpam_s_num_csumon
DESC Number of Secure Cache Storage Usage Monitors for MPAM
PAR HNS_MPAM_S_NUM_CSUMON_PARAM
R 0x908 64 RO - cmn_hns_unit_info_1
RESET 0x1020510020001 0xfffffffffff0f
DESC Provides component identification information for HN-F.
F 0 4 max_rnf_per_cluster
DESC Describes the maximum number of RN-F's in a single cluster
PAR HNS_MAX_RNF_PER_CLUSTER_PARAM
F 8 8 sf_rnf_vector_width
DESC Total Number of bits in RNF tracking vector in the Snoop Filter (Total SF_VEC_WIDTH = (TOTAL_RNF/HNS_MAX_CLUSTER_PARAM)+HNS_SF_ADD_VECTOR_WIDTH)
PAR HNS_MIN_SF_RNFVEC_WIDTH_PARAM + HNS_SF_ADD_VECTOR_WIDTH_PARAM
F 16 7 hnsam_num_nonhash_regions
DESC Number of non-hashed regions supported by the HNSAM
PAR POR_HNSAM_NUM_NONHASH_PARAM
F 23 5 hnsam_num_htg_regions
DESC Number of HTG regions supported by the HNSAM
PAR POR_HNSAM_NUM_HTG_PARAM
F 28 1 hnsam_default_hashed_region_en
DESC Enable default hashed group for HNSAM. To support backward compatible, set this parameter
PAR POR_HNSAM_DEF_HASHED_GRP_EN_PARAM
F 29 1 hnsam_rcomp_en
DESC Enable Range based address comparison for HNSAM HTG/Nonhashed groups. Program start address and end address
PAR POR_HNSAM_RCOMP_EN_PARAM
F 30 5 hnsam_rcomp_lsb
DESC Defines the minimum size of HTG when POR_HNSAM_RCOMP_EN_PARAM = 1, 20 value defines minimum size as 1MB and 26 value defines minimum size as 64MB
PAR POR_HNSAM_RCOMP_LSB_PARAM
F 35 4 hnsam_custom_regs
DESC Number of customer specific registers for customer implemented logic
PAR POR_HNSAM_CUSTOM_REGS_PARAM
F 39 6 lcnsam_num_htg
DESC Number of hashed regions supported by LCN SAM
PAR HNS_LCNSAM_NUM_HTG_PARAM
F 45 7 lcnsam_num_nonhashgroup
DESC Number of non hashed regions supported by LCN SAM 
PAR HNS_LCNSAM_NUM_NONHASHGROUP_PARAM
R 0x980 64 - S cmn_hns_scr
RESET 0x0 0x3ff
DESC Secure register access override.
F 0 1 qos
DESC Allows Secure override of the QoS registers
F 1 1 cfg_ctl
DESC Allows Secure override of the configuration control register (cmn_hns_cfg_ctl)
F 2 1 ppu
DESC Allows Secure override of the power policy registers
F 3 1 slc_lock_ways
DESC Allows Secure override of the cache way locking registers
F 4 1 sam_control
DESC Allows Secure override of the HN-F SAM control registers
F 5 1 slcsf_dbgrd
DESC Allows Secure override of the SLC/SF debug read registers
F 6 1 partner_scratch_override
DESC Allows Secure override of the Partenr scratch registers
F 7 1 ras_secure_access_override
DESC Allow Secure override of the RAS ERRMISC<n> registers
F 8 1 pa2setaddr_ctl
DESC Allow Secure override of the PA2SETADDR registers
F 9 1 ras
DESC Allow Secure override of the RAS registers
R 0x988 64 - ROOT cmn_hns_rcr
RESET 0x0 0x3ff
DESC Root register access override.
F 0 1 qos
DESC Allows Root override of the QoS registers
F 1 1 cfg_ctl
DESC Allows Root override of the configuration control register (cmn_hns_cfg_ctl)
F 2 1 ppu
DESC Allows Root override of the power policy registers
F 3 1 slc_lock_ways
DESC Allows Root override of the cache way locking registers
F 4 1 sam_control
DESC Allows Root override of the HN-F SAM control registers
F 5 1 slcsf_dbgrd
DESC Allows Root override of the SLC/SF debug read registers
F 6 1 partner_scratch_override
DESC Allows Root override of the Partner scratch registers
F 7 1 ras_secure_access_override
DESC Allows Root override of the RAS ERRMISC<n> registers
F 8 1 pa2setaddr_ctl
DESC Allows Root override of the PA2SETADDR registers
F 9 1 ras
DESC Allow Root override of the RAS registers
R 0xa00 64 - ROOT cmn_hns_cfg_ctl
RESET 0x2004c0863898a000 0xfffcfff7ffffbff7
DESC Functions as the configuration control register for HN-F.
RGO cmn_hns_rcr.cfg_ctl
SGO cmn_hns_scr.cfg_ctl
F 0 1 wlu_alloc_on_hit
DESC Forces WLU requests to allocate if the line hit in SLC
F 1 1 ncb_wr_alloc_on_hit
DESC Forces non CopyBack write requests to allocate if the line hit in SLC/SF
F 2 1 delay_comb_wrcmo_comp
DESC Delay CompCMO response for combined write cmo request when cmo is not propagated to SN.
F 4 1 force_flush_ewa0_en
DESC Force SLC and SF flush to use EWA 0 for SN writes
F 5 1 force_flush_pcmo_en
DESC Generate PCMO request for SLC and SF flush generated SN writes
F 6 1 force_flush_pcmo_deep_en
DESC Make PCMO request for SLC and SF flush generated SN writes as Deep PCMO. CONSTRAINT: hns_force_flush_pcmo_deep_en is valid only if hns_force_flush_pcmo_en bit is set. CONSTRAINT: This bit can be set only if ALL SNs in the system support deep attribute.
F 7 1 force_flush_popa_en
DESC Generate PoPA request for SLC and SF flush generated SN writes. CONSTRAINT: force_flush_popa_en is valid only if ABF CleanInvalid mode is set.
F 8 1 ncdevcmo_mc_comp_en
DESC Disables HN-F completion when set NOTE: When set, HN-F sends completion for the following transactions received after completion from SN: 1. Non-cacheable WriteNoSnp 2. Device WriteNoSnp 3. CMO (cache maintenance operations) CONSTRAINT: When this bit is set, por_rni_cfg_ctl.dis_ncwr_stream and por_rnd_cfg_ctl.dis_ncwr_stream must also be set.
F 9 1 ocm_en
DESC Enables region locking with OCM support
F 10 1 ocm_allways_en
DESC Enables all SLC ways with OCM
F 11 1 dmt_dis
DESC Disables DMT when set
F 12 1 pcmo_pop_en
DESC Terminates PCMO in HNS when this bit is set to 1'b1. PCMO is dropped and dirty data is not flushed
F 13 1 slc_repl_hint_use_en
DESC 1'b0: Interconnect generated SLC Replacement hints are used for eLRU. 1'b1: RN-F provided SLC Replacement hints are used for eLRU.
F 15 1 dwt_dis
DESC Disables DWT when set
F 16 1 adv_cbusy_mode_en
DESC Enables the advanced features of HNS CBusy handling
F 17 1 slc_mpam_cpor_en
DESC Enable MPAM Cache Portion Partitioning for SLC 1'b1: Cache Portion Partitioning is enabled if supported in Hardware. 1'b0: Cache Portion Partitioning is disabled for SLC. NOTE: If MPAM is disabled at build time, this bit has no meaning.
F 18 1 slc_mpam_ccap_en
DESC Enable MPAM Cache Capacity Partitioning for SLC 1'b1: Cache Capacity Partitioning is enabled if supported in Hardware. 1'b0: Cache Capacity Partitioning is disabled for SLC. NOTE: If MPAM is disabled at build time, this bit has no meaning.
F 19 1 slc_lru_victim_dis
DESC Disable enhanced LRU based victim selection for SLC 1'b0: SLC victim selection is based on eLRU. 1'b1: SLC victim selection is based on LFSR. NOTE: Victim selection for SF is always LFSR-based.
F 20 2 slc_lru_set_groups
DESC Number of sets in monitor group for enhance LRU 2'b00: 16 2'b01: 32 2'b10: 64 2'b11: 128 NOTE: Default is 32 sets per monitor group. If cache size is small (128KB or less), there would be only one set per group.
F 22 2 slc_lru_sel_cnt_value
DESC Selection counter value for eLRU to determine which group policy is more effective 2'b00: Sel counter is like an 8-bit range; upper limit is 255; middle point is 128 2'b01: Sel counter is like a 9-bit range; upper limit is 511; middle point is 256 2'b10: Sel counter is like a 10-bit range; upper limit is 1023; middle point is 512 2'b11: Sel counter is like an 11-bit range; upper limit is 2047; middle point is 1024 NOTE: Default is 10-bit with counter reset to a value of 512.
F 24 2 slc_lru_slcsrc_insert_value
DESC Insertion value if SLC source bit is set NOTE: Default is 2'b00.
F 26 2 slc_lru_staticmode_insert_value
DESC Insertion value for Static mode eLRU NOTE: Default is 2'b10.
F 28 2 slc_lru_dualmode_insert_value
DESC Insertion value for Dual mode eLRU NOTE: Default is 2'b11.
F 30 1 slc_ta_lru_en
DESC Thread Aware eLRU enable 1'b0: ThreadID used for eLRU is zero. 1'b1: ThreadID used for eLRU is based on MPAMID or LPID+LID. Note: If SLC size is less than 256KB, this bit is ignore.
F 31 1 slc_mpamid_as_lru_thread
DESC Use MPAM PARTID as ThreadID for Thread Aware eLRU 1'b0: ThreadID is based on LPID+LID for Thread Aware eLRU. 1'b1: ThreadID is based on MPAM PARTID+NS for Thread Aware eLRU. Note: MPAM PARTID is used only if MPAM is enabled.
F 32 1 mte_mode_dis
DESC Disables the MTE features in HNS when set to 1'b1. Can only program when POR_CHI_MTE_ENABLE_PARAM is set
PAR (POR_CHI_MTE_ENABLE_PARAM == 1'b0)
F 33 1 sf_rn_cluster_mode_en
DESC Enables the snoop filter clustering of the RN-F ID's using programmable registers
F 34 1 sf_rnf_vec_precise_mode_en
DESC Enables the snoop filter's precise RNF vector in clustered mode when set to 1'b1
F 36 1 metadata_mode_dis
DESC Disables the METADATA features in HNS when set to 1'b1
F 37 1 hbt_sfbi_alloc_slc_en
DESC Enable SLC allocation of Implicit WB data from RN due to SF Eviction of HBT line. Note: Only Capacity SF Eviction affected.
F 38 1 stash_snp_dis
DESC Disables stashing snoop in HNS when set to 1'b1
F 39 1 sfbi_snpunique_dis
DESC Disable SnpUnique when SFBI is allowed to allocate in SLC. When Set, SFBI only sends SnpCleanInvalid. Note: Applicable for HBT & LBT both.
F 40 1 rnf_wr_alloc_on_hit
DESC Forces RNF Write requests to allocate if the line hit in SLC.
F 41 1 rni_wr_alloc_on_hit
DESC Forces RNI Write requests to allocate if the line hit in SLC.
F 42 1 lbt_honor_wr_alloc_on_hit
DESC Forces LBT Write requests to honor wlu_alloc_on_hit, rnf_wr_alloc_on_hit, and rni_wr_alloc_on_hit
F 43 1 alloc_on_pcie_wr_ptl
DESC Forces HBT PCIE partial writes to allocate in SLC
F 44 1 delay_cacheable_wns_comp
DESC Sends late completion for cacheable WriteNoSnoop
F 45 1 ue_on_mem_addr_dec_err
DESC Log CXL address decode error as UE in error register
F 46 1 poison_on_mem_addr_dec_err_en
DESC When set, set poison in read data for CXL address decode error
F 47 1 rd_migrate_on_sfmiss
DESC Migrates a read from LCC/SLC if sf miss
F 50 1 rdonce_sleep_data_fwd_opt_dis
DESC When set, Disable RdOnce data forward optimization when entry is sleeping.
F 51 1 slc_victim_clean_tag_transfer_en
DESC When set, HNS propagates clean tag to SN when SLC victim has clean tag
F 52 3 mpam_ns_rl_partid_cfg
DESC MPAM Non-Secure/Realm PARTID configuration based on a combined total of (HNS_MPAM_NS_PARTID_MAX_PARAM+HNS_MPAM_RL_PARTID_MAX_PARAM) PARTIDs 3'b000: 1 PARTID allocated to Realm; Remaining PARTIDs allocated to Non-Secure 3'b001: 1 PARTID allocated to Non-Secure; Remaining PARTIDs allocated to Realm 3'b010: 1/2 PARTIDs allocated to Non-Secure; 1/2 to Realm. Remaining 1 PARTID allocated to Non-Secure 3'b011: 3/4 PARTIDs allocated to Non-Secure; 1/4 to Realm. Remaining 1 PARTID allocated to Non-Secure 3'b100: 1/4 PARTIDs allocated to Non-Secure; 3/4 to Realm. Remaining 1 PARTID allocated to Non-Secure
F 55 3 mpam_ns_rl_csumon_cfg
DESC MPAM Non-Secure/Realm CSUMON configuration based on a combined total of (HNS_MPAM_NS_NUM_CSUMON_PARAM+HNS_MPAM_RL_NUM_CSUMON_PARAM) CSUMONs 3'b000: 1 CSUMON allocated to Realm; Remaining CSUMONs allocated to Non-Secure 3'b001: 1 CSUMON allocated to Non-Secure; Remaining CSUMONs allocated to Realm 3'b010: 1/2 CSUMONs allocated to Non-Secure; 1/2 to Realm. Remaining 1 CSUMON allocated to Non-Secure 3'b011: 3/4 CSUMONs allocated to Non-Secure; 1/4 to Realm. Remaining 1 CSUMON allocated to Non-Secure 3'b100: 1/4 CSUMONs allocated to Non-Secure; 3/4 to Realm. Remaining 1 CSUMON allocated to Non-Secure
F 58 1 cmopopa_mc_comp
DESC When set, HN-F sends completion for CMOPoPA after completion from SN
F 59 1 dwnstrm_writer_present
DESC When set, HNS does SN read for NC requests when clean data is available in SLC or upstream RNs
F 60 1 dis_rni_dwnstrm_writer_beh
DESC When set, HNS doesn't do SN read for NC requests from RNI/RND when clean data is available in SLC or upstream RNs Only applicable when dwnstrm_writer_present is set
F 61 2 mpam_softlim_value
DESC Soft Limit value for MPAM capacity partitioning. 2'b00: Soft limit is 0% below hardlimit. 2'b01: Soft limit is 3.13% (1/32) below hardlimit 2'b10: Soft limit is 6.25% (1/16) below hardlimit 2'b11: Soft limit is 9.38% (3/32) below hardlimit NOTE: Default is 3.13% below hardlimit. If CMAX value set is at or below 12.5%, soft limit is ignored.
F 63 1 mpam_partid_oor_use_default_partid_en
DESC When set, use Default MPAM PartID for CMAX & CPBM if Request PartID is Out Of Range. Note: Override is only for internal use to determine CMAX & CPBM. Original PartID is stored and propogated to SN. Note: Default PartID is Zero for each NS/NSE Space.
R 0xa08 64 - ROOT cmn_hns_aux_ctl
RESET 0xc00000000600002 0xffffff0006fffbff
DESC Functions as the auxiliary control register for HN-F.
F 0 1 hns_only_mode
DESC Enables HN-F only mode; disables SLC and SF when set
F 1 1 honor_ewa
DESC When set, postpones completion for writes where EWA=0 in the request until HN-F receives completion from MC or SBSX
F 2 1 no_wu_alloc
DESC Disables WriteUnique/WriteLineUnique allocations in SLC when set
F 3 1 pcie_read_no_alloc
DESC When set, disables ReadOnce and ReadNoSnp allocation in SLC from PCIE
F 4 1 io_read_no_alloc
DESC When set, disables ReadOnce and ReadNoSnp allocation in SLC from RN-Is
F 5 1 non_sh_no_alloc
DESC Disables SLC allocation for non-shareable cacheable transactions when set
F 6 1 snp_once_dis
DESC When set, disables SnpOnce and converts to SnpShared
PAR HNS_DIS_SNP_ONCE_PARAM
F 7 1 hns_stash_dis
DESC Disables HN-F stash support
PAR POR_CHIA_RNF_MODE_EN_PARAM
F 8 1 likelysh_dis
DESC Disables Likely Shared based allocations
F 9 1 seqreq_coll_dis
F 11 1 slc_por_init_dis
DESC Disables SLC and SF initialization on Reset
F 12 1 cg_dis
DESC Disables HN-F architectural clock gates
F 13 1 sf_dis
DESC Disables SF
F 14 1 misc_cg_dis
DESC Disables architectural clock gates in hns_misc hierarchy
F 15 1 dct_dis
DESC Disables DCT when set
PAR POR_CHIA_RNF_MODE_EN_PARAM
F 16 1 poison_intr_en
DESC Enables reporting an interrupt by HN-F when poison is detected at SLC
PAR POR_CHIA_RNF_MODE_EN_PARAM
F 17 1 ecc_dis
DESC Disables SLC and SF ECC generation/detection when set
F 18 1 pois_dis
DESC Disables parity error data poison when set
F 19 1 slc_tag_ecc_scrub_dis
DESC Disables SLC tag single-bit ECC error scrubbing when set
F 20 1 sf_ecc_scrub_dis
DESC Disables SF tag single-bit ECC error scrubbing when set
F 21 1 slc_data_ecc_scrub_dis
DESC Disables data single-bit ECC error scrubbing for non-migrating reads when set
F 22 1 dwt_txreq_byp_dis
DESC Disables DWT TXREQ bypass when set
F 23 1 dwt_owo_dis
DESC Disables DWT for OWO requests
F 25 1 sf_flush_seq_abf_entries_dis
DESC When set, disables using SEQ ABF entries for PM SF flush
F 26 1 two_rnf_addr_hash_dis
DESC Disable address hash and use single bit (bit 7) to select RNF interface when 2RNF is supported
F 40 1 sf_snp_vec_dis
DESC Disables SF snoop vector when set
F 41 1 slc_victim_qos_high
DESC SLC victim QoS behavior for SN write request 1'b0: Each victim inherits the QoS value of the request which caused it 1'b1: All victims use high QoS class (14)
F 42 2 adq_8b_entry_limit
DESC Limit number of ADQ 8B entry for debug purpose. 00: ADQ 8B entry limit is disabled. Default 8 entries are used. 01: Only  1 ADQ 8B entry [0:0] can be used. NOT SUPPORTED FOR HNS config 10: Only  2 ADQ 8B entry [1:0] can be used. 11: Only  4 ADQ 8B entry [3:0] can be used.
Note: 2'b01 (1 entry) is not supported for HNS config as one entry needs to be reserved for HBT.
F 44 2 adq_32b_entry_limit
DESC Limit number of ADQ 32B entry for debug purpose. 00: ADQ 32B entry limit is disabled. Default 4 entries are used. 01: Only  1 ADQ 32B entry [0:0] can be used. NOT SUPPORTED FOR HNS config 10: Only  2 ADQ 32B entry [1:0] can be used. 11: Only  3 ADQ 32B entry [2:0] can be used.
Note: 2'b01 (1 entry) is not supported for HNS config as one entry needs to be reserved for HBT.
F 46 2 seq_abf_entry_limit
DESC Limit number of SEQ Entries used for ABF Flush req. 00: ABF SEQ entry limit is disabled. Default 4 entries are used. 01: Only  1 ABF SEQ entry [0:0] can be used. 10: Only  2 ABF SEQ entry [1:0] can be used. 11: Only  3 ABF SEQ entry [2:0] can be used.
F 48 2 seq_nonabf_entry_limit
DESC Limit number of SEQ Entries used for SF Eviction req. 00: SF Eviction SEQ entry limit is disabled. Default 8 entries are used. 01: Only  2 SF Eviction SEQ entry [1:0] can be used. NOT SUPPORTED FOR HNS config 10: Only  3 SF Eviction SEQ entry [2:0] can be used. 11: Only  4 SF Eviction SEQ entry [3:0] can be used.
Note: 2'b01 (2 entry) is not supported for HNS config.
F 50 5 spare_aux_ctl_bits
DESC Spare aux control bits for potential ECO fixes.
F 55 1 shared_intv_dis
DESC Disables snoop requests to CHIB RN-F with shared copy
PAR POR_CHIA_RNF_MODE_EN_PARAM
F 56 1 ord_stash_dis
DESC Disables stash operation for ordered write stash requests
F 57 1 poc_atomic_fwd_dis
DESC Disable the atomic data forwarding in POCQ
F 58 1 weoe_to_evict_ls1_en
DESC Enables HN-F to treat WEOE ops as EVICT when LS=1
F 59 1 rdonce_data_fwd_opt_l3hit_dis
DESC When Set, Disable RdOnce optimization for L3Hit. Only applicable if rdonce_sleep_data_fwd_opt_dis = 0
F 60 1 rpu_to_rnsd_en
DESC Enables HN-F to treat ReadPrefUnique ops as ReadNotSharedDirty
F 61 1 slc_ecc_pipe_mode_dis
DESC Disables inline ECC pipe mode in SLC. CONSTRAINT: Must be programmed at boot time.
F 62 2 mru_excl_lsc_ctl
DESC MRU Exclusive control for LSC.
R 0xa10 64 - ROOT cmn_hns_aux_ctl_1
RESET 0x2820001024a900 0x3dffff5ffff6fff9
DESC Functions as the auxiliary control register for HN-F.
F 0 1 chic_rdnosnpsep_dis
DESC Disables separation of Data and Comp in CHIC mode
F 3 3 l3_frc_slow_mode_enter_limit
DESC Enter L3 pipe slow mode based on cycle count. 000: Slow mode forced entry disabled 001: Enter slow mode   4K cycles after last slow mode exit 010: Enter slow mode   8K cycles after last slow mode exit 011: Enter slow mode  16K cycles after last slow mode exit 100: Enter slow mode  32K cycles after last slow mode exit 101: Enter slow mode  64K cycles after last slow mode exit 110: Enter slow mode 128K cycles after last slow mode exit 111: Enter slow mode 256K cycles after last slow mode exit
F 6 2 l3_frc_slow_mode_exit_limit
DESC Exit L3 pipe slow mode based on cycle count. 00: Slow mode forced exit disabled 01: Exit slow mode 1K cycles after entering slow mode 10: Exit slow mode 2K cycles after entering slow mode 11: Exit slow mode 4K cycles after entering slow mode
F 8 1 l3_replay_slow_mode_en
DESC Enables L3 arbitration slow mode in case of constant replays, when set to 1'b1
F 9 2 l3_replay_slow_mode_replay_type
DESC HNS replay type that will enable slow mode. 00: Replay slow mode is enabled for any replays 01: Replay slow mode is enabled for setway replays 10: Replay slow mode is enabled for seq full replays
F 11 2 l3_replay_slow_mode_nonreplay_cnt_limit
DESC Number of required back to back transactions that don't replay to exit replay mode. 00: Exit slow mode after  8 back to back non-replayed ops 01: Exit slow mode after 16 back to back non-replayed ops 10: Exit slow mode after 32 back to back non-replayed ops 11: Exit slow mode after 64 back to back non-replayed ops
F 13 3 l3_replay_slow_mode_cnt_limit
DESC L3 arbitration throttle count limit, when enabled. 000: L3 Throttle is enabled after   64 replays 001: L3 Throttle is enabled after  128 replays 010: L3 Throttle is enabled after  256 replays 011: L3 Throttle is enabled after  512 replays 100: L3 Throttle is enabled after 1024 replays 101: L3 Throttle is enabled after 2048 replays 110: L3 Throttle is enabled after 4096 replays 111: L3 Throttle is enabled after 8192 replays
F 17 1 mte_wrnosnp_txr_tag_drop_en
DESC When set to 1'b1, HNS will drop clean tags from a WriteNoSnp with tagop Transfer
F 18 1 mte_no_sn_match
DESC When set, HNS does MTE match locally without propagating to SN
F 20 1 mte_memattr_nc_tag_drop_en
DESC Enables HNS to drop any dirty tags for Non-Cacheable memory, when set to 1'b1
F 21 1 sf_precise_setway_en
DESC Enables Precise setway hazard, when set to 1'b1
F 22 3 sf_debug_way_limit
DESC Limit number of SF ways for debug purpose. 000: SF Way limit is disabled. SF_NUM_WAYS_PARAM determines number of ways supported 001: Only  1 SF way[0:0]   can be allocated.  NOT SUPPORTED FOR HNS config 010: Only  2 SF ways[1:0]  can be allocated. 011: Only  4 SF ways[3:0]  can be allocated. 100: Only  8 SF ways[7:0]  can be allocated. 101: Only 12 SF ways[11:0] can be allocated. 110: Only 16 SF ways[15:0] can be allocated.
Note: HBT/CCG has a reserved way (MSB way) that's independent of this limit. Note: 3'b001 (1 entry) is not supported for HNS config. It's only supported for LCN or HNF config. Note: SF Way Blocking (cmn_hns_sf_cxg_blocked_ways) is not supported when sf_debug_way_limit is non-zero.
F 25 1 be_all_ones_opt_dis
DESC Disable the optimizations related to BE=1's hint on WR_PTL from RNI
F 26 1 nonalloc_wr_snpclninv_dis
DESC Disable the snp type of snp_cln_inv on non-allocating writes. Send snp_uniq instead
F 27 1 l3_pipe_lookup_arb_pri_dis
DESC When set to 1'b1, L3 pipe arbiter will not give priority to lookup requests over fill requests.
F 28 1 txrsp_comp_bypass_dis
DESC When set, TXRSP COMP bypass gets disabled for WEOE/EVICT
F 29 7 class_based_pocq_arb_dis
DESC Disables Class based arbitration for various POCQ arbiters. For each bit: 1'b0: Use Class based arbitration. 1'b1: Use QoS based arbitration. Legacy mode.
[35]: POCQ entry selection for SN Static Credit Grant return. [34]: POCQ entry selection for SLC/SF pipeline request. [33]: POCQ entry selection for TXRSP. [32]: POCQ entry selection for TXDAT. [31]: POCQ entry selection for TXREQ. [30]: POCQ entry selection for ADQ. [29]: Reserved for future use. 
F 36 1 mc_wr_l3byp_dis
DESC When set, disables l3 bypass path to mc request for writes
F 38 1 always_dbidcomp_ha_en
DESC When set, HNS will combine DBID and Comp response for all writeunique and writenosnoop requests from CXHA to post SLC/SF lookup and snoops
