R 0x1f90 32 - ROOT por_ccla_ras_err_en
RESET 0x0 0x3f
DESC When enabled, RAS errors can be sent over CXL. Only applicable to device. Host doesn't use this register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 1 wdb_ue_enable
DESC If set, report write data buffer uncorrectable error over CXL
F 1 1 wdb_de_enable
DESC If set, report write data buffer deferred error over CXL
F 2 1 pdb_ue_enable
DESC If set, report passive data buffer uncorrectable error over CXL
F 3 1 pdb_de_enable
DESC If set, report passive data buffer deferred error over CXL
F 4 1 txn_timeout_enable
DESC If set, report transaction timeout error over CXL
F 5 1 nde_cmp_enable
DESC If set, report non data error over CXL
R 0x1f98 32 - ROOT por_ccla_ras_viral_en
RESET 0x0 0x7f
DESC When enabled, viral is sent over cxl
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 1 wdb_ue_enable
DESC If set, report write data buffer uncorrectable error over CXL
F 1 1 pdb_ue_enable
DESC If set, report passive data buffer uncorrectable error over CXL
F 2 1 txn_timeout_enable
DESC If set, report transaction timeout error over CXL
F 3 1 nde_cmp_enable
DESC If set, report non data error over CXL
F 4 1 datack_parity_err_enable
DESC If set, report data check parity error over CXL
F 5 1 hdm_decode_err_enable
DESC If set, report hdm decode error over CXL
F 6 1 hdm_decoder_lut_parity_err_enable
DESC If set, report hdm decoder lut parity error over CXL
R 0xd908 64 - - por_ccla_pmu_event_sel
RESET 0x0 0xffffffff
DESC Specifies the PMU event to be counted.
F 0 8 pmu_event0_id
DESC CCLA PMU Event 0 ID 8'h00: No event 8'h21: LA_RX_CXS : number of RX CXS beats 8'h22: LA_TX_CXS : number of TX CXS beats 8'h23: LA_RX_CXS_AVG_SIZE : average size of RX CXS beats 8'h24: LA_TX_CXS_AVG_SIZE : average size of TX CXS beats 8'h25: LA_TX_CXS_LCRD_BACKPRESSURE : CXS backpressue due to lack of CXS credits 8'h26: LA_LINK_CRDBUF_OCC : CCLA RX RAM buffer occupany 8'h27: LA_LINK_CRDBUF_ALLOC: CCLA RX RAM buffer allocation 8'h28: PFWD RCVR CXS beats 8'h29: PFWD SNDR NUM FLITS 8'h2A: PFWD SNDR Number of message stalls due to static credits 8'h2B: PFWD SNDR Number of message stalls due to dynamic credits
F 8 8 pmu_event1_id
DESC CCLA PMU Event 1 ID; see pmu_event0_id for encodings
F 16 8 pmu_event2_id
DESC CCLA PMU Event 2 ID; see pmu_event0_id for encodings
F 24 8 pmu_event3_id
DESC CCLA PMU Event 3 ID; see pmu_event0_id for encodings
R 0xe000 64 RO ROOT por_ccla_errfr
RESET 0x120000801201a2 0x720000803ffff3
DESC Functions as the error feature register.
RGO por_ccla_rcr.ras_secure_access_override
SGO por_ccla_scr.ras_secure_access_override
F 0 2 ed
DESC Error reporting and logging control 2'b10: Error reporting and logging is controllable using por_ccla_errctlr.ED
F 4 2 ui
DESC Error Recovery Interrupt from Uncorrected errors control 2'b00: Does not support Error Recovery Interrupt from Uncorrected errors 2'b10: Support Error Recovery Interrupt on Uncorrected errors and controllable using por_ccla_errctlr.UI.
F 6 2 fi
DESC Fault Handling Interrupt from Deferred and Uncorrected errors control 2'b00: Does not support Fault Handling Interrupt from Deferred and Uncorrected errors 2'b10: Support Fault Handling Interrupt on Deferred and Uncorrected errors and controllable using por_ccla_errctlr.FI.
F 8 2 ue
DESC In-band error response is always on
F 10 2 cfi
DESC Fault Handling Interrupt from Corrected errors control 2'b00: Does not support Fault Handling Interrupt from Corrected errors 2'b10: Support Fault Handling Interrupt on corrected errors and controllable using por_ccla_errctlr.CFI.
F 12 3 cec
DESC Standard corrected error counter 3'b000: Does not implement standard error counter model
F 15 1 rp
DESC Repeat counter (valid only when por_ccla_errfr.CEC != 3'b000.) 1'b0: Invalid
F 16 2 dui
DESC Error Recovery Interrupt from Deferred errors control 2'b00: Does not support Error Recovery Interrupt from Deferred errors 2'b10: Support Error Recovery Interrupt from Deferred errors and controllable using por_ccla_errctlr.DUI.
F 18 2 ceo
DESC Corrected Error overwrite. 2'b00: Keep the first Corrected Error syndrome
F 20 2 inj
DESC Fault Injection Extension. 2'b01: Support Common Fault Injection Model Extension
F 31 1 frx
DESC Feature Register extension. 1'b1: por_ccla_errfr[63:48] is architecturally defined
F 49 1 ueu
DESC Unrecoverable Error recording 1'b0: Unrecoverable Error not supported 1'b1: Unrecoverable Error supported
F 52 1 de
DESC Deferred Error recording 1'b0: Deferred Error not supported 1'b1: Deffered Error supported
F 53 2 ce
DESC Corrected Error recording 2'b00: Corrected Error not supported 2'b10: Non-specific Corrected Error supported
R 0xe008 64 - ROOT por_ccla_errctlr
RESET 0x0 0x50d
DESC Functions as the error control register. Controls whether specific error-handling interrupts and error detection/deferment are enabled.
RGO por_ccla_rcr.ras_secure_access_override
SGO por_ccla_scr.ras_secure_access_override
F 0 1 ed
DESC Enables error detection as specified in por_ccla_errfr.ED
F 2 1 ui
DESC Enables error recovery interrupt for uncorrected error as specified in por_ccla_errfr.UI
F 3 1 fi
DESC Enables fault handling interrupt for uncorrected and deferred errors as specified in por_ccla_errfr.FI
F 8 1 cfi
DESC Enables fault handling interrupt for corrected error as specified in por_ccla_errfr.CFI
F 10 1 dui
DESC Enables error recovery interrupt for deferred error as specified in por_ccla_errfr.DUI
R 0xe010 64 - ROOT por_ccla_errstatus
RESET 0x0 0xfff0ffff
DESC Functions as the error status register. When V is set, only write exact same value as in the register can clear it.
RGO por_ccla_rcr.ras_secure_access_override
SGO por_ccla_scr.ras_secure_access_override
F 31 1 av W1C
DESC Address register valid 1'b1: Address is valid; por_ccla_erraddr contains a physical address for that recorded error 1'b0: Address is not valid
F 30 1 v W1C
DESC Status register valid 1'b1: At least one error recorded; register is valid 1'b0: No errors recorded
F 29 1 ue W1C
DESC Uncorrected errors 1'b1: At least one error detected that is not corrected and is not deferred to a subordinate 1'b0: No uncorrected errors detected
F 28 1 er W1C
DESC Error Reported 1'b1: In-band error response signaled to the Requester 1'b0: No in-band error response signaled
F 27 1 of W1C
DESC Overflow; asserted when multiple errors are detected 1'b1: More than one error detected 1'b0: None or only one error detected as described by UE/DE/CE fields
F 26 1 mv W1C
DESC por_ccla_errmisc<01> valid 1'b1: Miscellaneous registers are valid 1'b0: Miscellaneous registers are not valid
F 24 2 ce W1C
DESC Corrected errors 2'b10: At least one corrected error recorded 2'b00: No corrected errors recorded
F 23 1 de W1C
DESC Deferred errors 1'b1: At least one error is not corrected and is deferred 1'b0: No errors deferred
F 22 1 pn W1C
DESC Poison 1'b1: Uncorrected error recorded because a poison value was consumed 1'b0: Other cases
F 20 2 uet W1C
DESC Uncorrected Error Type, valid only when UE != 0 2'b01: Uncorrected error, Unrecoverable error (UEU). 2'b00: Invalid
F 8 8 ierr W1C
DESC Implementation-defined primary error code. 8'h00: No error 8'h01: Partner implementation defined error
F 0 8 serr W1C
DESC 8'h00: No error 8'h01: IMPLEMENTATION DEFINED error - refer to por_ccla_errmisc1.ERRSRC 8'h02: Data value from (non-associative) internal memory. For example, Error Correction Code (ECC) from on-chip SRAM or buffer. 8'h05: Error detected on internal data path. For example, parity error in LA TX path 8'h12: Error response from Completer of access. For example, error response from cache write-back. 8'h13: External timeout. For example, timeout on interaction with another component. 8'h17 or 8'h18: Deferred error from Completer/Requester passed through. For example, poisoned data received from the Completer/Requester of an access and returned to the Requester. 
R 0xe018 64 - ROOT por_ccla_erraddr
RESET 0x0 0xc80fffffffffffff
DESC Contains the error record address.
RGO por_ccla_rcr.ras_secure_access_override
SGO por_ccla_scr.ras_secure_access_override
F 0 52 addr
DESC Transaction address
F 59 1 nse
DESC Root status of transaction.  PAS[1] of the transaction.
F 62 1 si
DESC {NSE,NS} valid 1'b0: PAS field is valid 1'b1: PAS field is invalid
F 63 1 ns
DESC Security status of transaction.  PAS[0] of the transaction.
R 0xe028 64 - ROOT por_ccla_errmisc1
RESET 0x0 0x1ff0000000fffff
DESC Functions as the miscellaneous error register 1. Contains miscellaneous information about deferred/uncorrected errors.
RGO por_ccla_rcr.ras_secure_access_override
SGO por_ccla_scr.ras_secure_access_override
F 4 16 srcid
DESC Error source ID
F 48 9 errset
DESC RAM entry set address for parity error
F 0 4 errsrc
DESC Source of the parity error 4'b0000: Read data buffer 0 4'b0001: Read data buffer 1 4'b0010: Write data buffer 0 4'b0011: Write data buffer 1 4'b0100: Passive Buffer 4'b0101: CCLA Data RAM 4'b0110: PortFwd Data RAM 4'b0111: CXL Viral 4'b1000: CXL.Mem Poison 4'b1001: CXL.Cache Poison 4'b1010: CHI NDE (CXL.MEM mode) 4'b1011: Transaction timeout (CXL.MEM mode) 4'b1100: HDM decoder error 4'b1101: RA Transaction timeout 4'b1110: HA HDM LUT Parity or ECC double bit 4'b1111: Internal Datacheck error
R 0xe040 64 RO - por_ccla_errfr_ns
RESET 0x120000801201a2 0x720000803ffff3
DESC Functions as the non-secure error feature register.
F 0 2 ed
DESC Error reporting and logging control 2'b10: Error reporting and logging is controllable using por_ccla_errctlr_NS.ED
F 4 2 ui
DESC Error Recovery Interrupt from Uncorrected errors control 2'b00: Does not support Error Recovery Interrupt from Uncorrected errors 2'b10: Support Error Recovery Interrupt on Uncorrected errors and controllable using por_ccla_errctlr_NS.UI.
F 6 2 fi
DESC Fault Handling Interrupt from Deferred and Uncorrected errors control 2'b00: Does not support Fault Handling Interrupt from Deferred and Uncorrected errors 2'b10: Support Fault Handling Interrupt on Deferred and Uncorrected errors and controllable using por_ccla_errctlr_NS.FI.
F 8 2 ue
DESC In-band error response is always on
F 10 2 cfi
DESC Fault Handling Interrupt from Corrected errors control 2'b00: Does not support Fault Handling Interrupt from Corrected errors 2'b10: Support Fault Handling Interrupt on corrected errors and controllable using por_ccla_errctlr_NS.CFI.
F 12 3 cec
DESC Standard corrected error counter 3'b000: Does not implement standard error counter model
F 15 1 rp
DESC Repeat counter (valid only when por_ccla_errfr_NS.CEC != 3'b000.) 1'b0: Invalid
F 16 2 dui
DESC Error Recovery Interrupt from Deferred errors control 2'b00: Does not support Error Recovery Interrupt from Deferred errors 2'b10: Support Error Recovery Interrupt from Deferred errors and controllable using por_ccla_errctlr_NS.DUI.
F 18 2 ceo
DESC Corrected Error overwrite. 2'b00: Keep the first Corrected Error syndrome
F 20 2 inj
DESC Fault Injection Extension. 2'b01: Support Common Fault Injection Model Extension
F 31 1 frx
DESC Feature Register extension. 1'b1: por_ccla_errfr_NS[63:48] is architecturally defined
F 49 1 ueu
DESC Unrecoverable Error recording 1'b0: Unrecoverable Error not supported 1'b1: Unrecoverable Error supported
F 52 1 de
DESC Deferred Error recording 1'b0: Deferred Error not supported 1'b1: Deffered Error supported
F 53 2 ce
