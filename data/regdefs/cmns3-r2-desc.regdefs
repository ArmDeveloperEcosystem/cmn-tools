R 0xd70 64 - ROOT por_ccla_agentid_to_portid_val
RESET 0x0 0xff
DESC Specifies which Agent ID to Port ID mappings are valid.
RGO por_ccla_rcr.portid_ctl
SGO por_ccla_scr.portid_ctl
F 0 8 valid
DESC Specifies whether the Port ID is valid; bit number corresponds to logical Agent ID number (from 0 to 63)
R 0xd78 64 V ROOT por_ccla_portfwd_en
RESET 0x0 0xffffffffffffffff
DESC Functions as the Port-to-Port forwarding control register. Works with por_ccla_portfwd_status.
F 0 64 port_fwd_en
DESC Bit vector, where each bit represents logical PortID of a Port (CCG) present on CMN. Each bit when set, enables Port-to-Port forwarding with the corresponding port. 1'b0: Port-to-Port forwarding is disabled 1'b1: Port-to-Port forwarding  is enabled
R 0xd80 64 ROV ROOT por_ccla_portfwd_status
RESET 0x0 0xffffffffffffffff
DESC Functions as the Port-to-Port forwarding status register. Works with por_ccla_portfwd_ctl.
F 0 64 port_fwd_ack
DESC Bit vector, where each bit represents logical PortID of a Port (CCG) present on CMN. Each bit represents the status of the port-to-port control request sent to the corresponding port. 1'b0: Port-to-Port forwarding channel is de-active. 1'b1: Port-to-Port forwarding channel is active
R 0xd88 64 V ROOT por_ccla_portfwd_req
RESET 0x0 0xffffffffffffffff
DESC Functions as the Port-to-Port forwarding control register. Works with por_ccla_portfwd_status.
F 0 64 port_fwd_req
DESC Bit vector, where each bit represents logical PortID of a Port (CCG) present on CMN. Each bit is used to control the communication channel with the corresponding port. 1'b0: Port-to-Port forwarding channel de-activate request 1'b1: Port-to-Port forwarding channel activate  request
R 0xd90 64 - ROOT por_ccla_linkid_to_hops
RESET 0x0 0x19b
DESC Specifies number of portforward hops for the linkid.
RGO por_ccla_rcr.portid_ctl
SGO por_ccla_scr.portid_ctl
F 0 2 linkid0_num_hops
DESC Specifies the number of portforward hops for linkid0
F 3 2 linkid1_num_hops
DESC Specifies the number of portforward hops for linkid1
F 7 2 linkid2_num_hops
DESC Specifies the number of portforward hops for linkid2
R 0xe00 64 - ROOT por_ccla_cxl_link_rx_credit_ctl
RESET 0x10000100 0x3ffffffffffff
DESC CXL Link Rx Credit Control Register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 10 cache_req_credits
DESC Credits to advertise for Cache Request channel at init
PAR CCG_HA_REQ_PASS_BUFF_DEPTH_PARAM
F 10 10 cache_rsp_credits
DESC Credits to advertise for Cache Response channel at init
PAR CCG_HA_NUM_SNPREQS_PARAM
F 20 10 cache_data_credits
DESC Credits to advertise for Cache Data channel at init
PAR CCG_HA_DAT_PASS_BUFF_DEPTH_PARAM
F 30 10 mem_req_rsp_credits
DESC Credits to advertise for Mem Request or Response channel at init
PAR CCG_RA_NUM_REQS_PARAM
F 40 10 mem_data_credits
DESC Credits to advertise for Mem Data channel at init
PAR CCLA_RX_STL_BUFFER_DEPTH_PARAM
R 0xe08 64 RO ROOT por_ccla_cxl_link_rx_credit_return_stat
RESET 0x0 0x3ffffffffffff
DESC CXL Link Rx Credit Return Status Register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 10 cache_req_credits
DESC Running snapshot of accumulated Cache Request credits to be returned
F 10 10 cache_rsp_credits
DESC Running snapshot of accumulated Cache Response credits to be returned
F 20 10 cache_data_credits
DESC Running snapshot of accumulated Cache Data credits to be returned
F 30 10 mem_req_rsp_credits
DESC Running snapshot of accumulated Mem Request or Response credits to be returned
F 40 10 mem_data_credits
DESC Running snapshot of accumulated Mem Data credits to be returned
R 0xe10 64 RO ROOT por_ccla_cxl_link_tx_credit_stat
RESET 0x0 0x3ffffffffffff
DESC CXL Link Tx Credit Status Register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 10 cache_req_credits
DESC Running snapshot of accumulated Cache Request credits for TX
F 10 10 cache_rsp_credits
DESC Running snapshot of accumulated Cache Response credits for TX
F 20 10 cache_data_credits
DESC Running snapshot of accumulated Cache Data credits for TX
F 30 10 mem_req_rsp_credits
DESC Running snapshot of accumulated Mem Request or Response credits for TX
F 40 10 mem_data_credits
DESC Running snapshot of accumulated Mem Data credits for TX
R 0xe18 64 - ROOT por_ccla_cxl_link_layer_defeature
RESET 0x0 0x1
DESC CXL Link Layer Defeature Register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 1 disable_mdh
DESC Write 1 to disable MDH. Software needs to ensure it programs this value consistently on the UP & DP. After programming, a warm reset is required for the disable to take effect.
R 0xe20 64 - ROOT por_ccla_ull_ctl
RESET 0x0 0x3f
DESC Upper Link Layer Control Register
RGO por_ccla_rcr.ull_ctl
SGO por_ccla_scr.ull_ctl
F 0 1 send_vd_init
DESC Used to send VD Init message. Must only be used for direct ULL to ULL connection. Must be used along with Tx ULL state (tx_ull_state) status bit 1'b0: When clear and tx_ull_state is in run_state, sends VD.De-activate flit. 1'b1: When set and tx_ull_state is in stop state, sends VD.Activate flit.
F 1 1 ull_to_ull_en
DESC Used to enable ULL-to_ULL mode. Must be set on both sides of the link before 'send_vd_init' is set on either side 1'b0: When clear, ull-to-ull mode is disabled. 1'b1: When set, ull-to-ull mode is enabled.
F 2 2 ull_flit_format
DESC Used to enable 256 byte flits when in ULL-to_ULL mode. Format be set on both sides of the link on the same write as 'send_vd_init' 2'b00: 68B Legacy Flit format 2'b01: Reserved 2'b10: 128B Latency Optimized Flit format 2'b11: 256B Flit format
F 4 1 cxl_reset_done
DESC System software indication to communicate CXL reset done. HW de-asserts the CXL reset only after the de-assertion of rh_busy status and software cxl_reset_done handshake Read to this registers is always zero
F 5 1 send_c2c_link_sts
DESC send c2c link status llinit
R 0xe28 64 RO ROOT por_ccla_ull_status
RESET 0x0 0x3f
DESC Upper Link Layer Status Register
RGO por_ccla_rcr.ull_ctl
SGO por_ccla_scr.ull_ctl
F 0 1 tx_ull_state
DESC Reflects the Tx ULL state . 1'b0: Tx ULL is in Stop state 1'b1: Tx ULL is in Run state 
F 1 1 rx_ull_state
DESC Reflects the Rx ULL state . 1'b0: Rx ULL is in Stop state 1'b1: Rx ULL is in Run state 
F 2 1 rh_busy_state
DESC Reflects the CCRH transaction pending state . 1'b0: RH (HA/RA) are in IDLE state 1'b1: RH (HA/RA) are in Busy state 
F 3 1 ull_inbound_viral_state
DESC Indicates ULL is in Viral state from the Inbound CXS Flit. 1'b0: ULL is not in Viral state 1'b1: ULL is in Viral state
F 4 1 ull_outbound_viral_state
DESC Indicates ULL is in Viral state originated in the ULL. 1'b0: ULL is not in Viral state 1'b1: ULL is in Viral state
F 5 1 cxl_reset_status
DESC Reflects CXL reset status. 1'b0: CXL reset de-asserted 1'b1: CXL reset asserted
R 0xe30 64 - ROOT por_ccla_cxl_ll_errinject_ctl
RESET 0x0 0x5
DESC CXL .cache .mem Link Layer Error Injection Control Register. Not used in Host mode
RGO por_ccla_rcr.cxlerrinj_ctl
SGO por_ccla_scr.cxlerrinj_ctl
F 0 1 cachepoisoninjectionstart
DESC Software writes 0x1 to this bit to trigger a single poison injection on a CXL.cache message in the Tx direction. Hardware must override the poison field in the data header slot ofthe corresponding message (D2H if device, H2D if Host). This bit is required only if CXL.cache protocol issupported.
F 2 1 mempoisoninjectionstart
DESC Software writes 0x1 to this bit to trigger a single poison injection on a CXL.mem message in the Tx direction. Hardware must override the poison field in the data header slot ofthe corresponding message (DRS if device, RwD if Host). This bit is required only if CXL.mem protocol issupported.
R 0xe38 64 RO ROOT por_ccla_cxl_ll_errinject_stat
RESET 0x0 0xa
DESC CXL .cache .mem Link Layer Error Injection Status Register
RGO por_ccla_rcr.cxlerrinj_ctl
SGO por_ccla_scr.cxlerrinj_ctl
F 1 1 cachepoisoninjectionbusy
DESC Hardware loads 1 to this bit when the Start bit is written. Hardware must clear this bit to indicate that it has indeed finished poisoning a packet. Software is permitted to poll on this bit to find out when hardware has finished poison injection. This bit is required only if CXL.cache protocol issupported.
F 3 1 mempoisoninjectionbusy
DESC Hardware loads 1 to this bit when the Start bit is written. Hardware must clear this bit to indicate that it has indeed finished poisoning a packet. Software is permitted to poll on this bit to find out when hardware has finished poison injection. This bit is required only if CXL.mem protocol issupported.
R 0xe40 64 V ROOT por_ccla_cxl_viral_prop_en
RESET 0x0 0xffffffffffffffff
DESC Bit Vector which controls viral propagation. Each bit represents the logical ID of corresponding CML gateway block.
F 0 64 viral_prop_en
DESC Bit vector, where each bit represents logical ID of a CML gateway block present on CMN. Each bit when set, enables propagation of CXL Viral to that gateway block. 1'b0: Viral propagation is disabled 1'b1: Viral propagation is enabled
R 0xe50 64 - ROOT por_ccla_cxl_security_policy
RESET 0x2 0x3
DESC Contains CXL Security Policy
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 2 device_trust_level
DESC 0 --> Trusted CXL Device. At this setting  a CXL Device will be able to get access on CXL.cache for both host-attached and device attached memory ranges. The Host can still protect security sensitive memory regions. '1 --> Trusted for Device Attached Memory Range Only. At this setting  a CXL Device will be able to get access on CXL.cache for device attached memory ranges only. Requests on CXL.cache for host-attached memory ranges will be aborted by the Host. '2 --> Untrusted CXL Device. At this setting  all requests on CXL.cache will be aborted by the Host. Please note that these settings only apply to requests on CXL.cache. The device can still source requests on CXL.io regardless of these settings. Protection on CXL.io will be implemented using IOMMU based page tables. Default value of this field is 2.
R 0xe58 32 - ROOT por_ccla_cxl_cache_id_decoder_capability
RESET 0x0 0x1
DESC Contains CXL_Cache_ID_Decoder_Capability
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 1 explicit_cache_id_decoder_commit_required
DESC If 1, indicates that the software must set Cache ID Decoder Commit bit anytime a new CXL.cache device is enabled anywhere below this port. If 1, the Cache ID Decoder Commit bit, the Cache ID Decoder Committed bit, the Cache ID Decoder Commit timeout Scale field, the Cache ID Decoder Commit Timeout Base field, and Cache ID Decoder Error Not Committed bit are implemented. Cache ID Decoder Commit operation may be used by a component to update its internal structures or perform consistency checks.
R 0xe60 32 - ROOT por_ccla_cxl_cache_id_decoder_control
RESET 0x0 0x30f0f0f
DESC Contains CXL_Cache_ID_Decoder_Control
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 1 forward_cache_id
DESC 1 indicates the Port forwards CXL.cache messages in both directions. The reset default is 0.
F 1 1 assign_cache_id
DESC 1 indicates this Downstream Port is connected directly to a CXL.cache Device and assigns a cache ID=Local Cache ID to it. The reset default is 0.
F 2 1 hdm_d_type_2_device_present
DESC 1 indicates there is a Type 2 Device below this Downstream Port that is using HDM-D flows. The reset default is 0.
F 3 1 cache_id_decoder_commit
DESC If Explicit Cache ID Decoder Commit Required=1. software must cause this bit to transition from 0 to 1 to commit the Cache ID assignment change to this Cache ID Decoder instance. The default value of this field is 0. This bit must be RW if the Explicit Cache ID Decoder Commit Required bit is set; otherwise, it is permitted to be hardwired to 0 and the Cache ID Decoder update does not require an explicit commit. Software must not set this bit unless the Explicit Cache ID Decoder Commit Required bit is set.
F 8 4 hdm_d_type_2_device_cache_id
DESC If HDM-D Type 2 Device Present=1, this field represents the Cache ID that has been assigned to the Type 2 device below this Downstream Port that is using HDM-D flows. This field may be used by the port to identify a Type 2 device that is using HDM-D flows and must not be used for assigning Cache ID. The reset default is 0h.
F 16 4 local_cache_id
DESC If Assign Cache ID Enable=1, the Port assigns this Cache ID to the directly connected CXL.cache device regardless of whether it is using HDM-D flows or HDM-DB flows. The reset default is 0h.
F 24 2 trust_level
DESC Trust Level assigned to the directly connected device when Assign Cache ID=1. 00b = See Table 8-26 01b = Reserved 10b = See Table 8-26 11b = Reserved The reset default is 10b.
R 0xe68 32 - ROOT por_ccla_cxl_cache_id_decoder_status
RESET 0x0 0xff03
DESC Contains CXL_Cache_ID_Decoder_Status 
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 1 cache_id_decoder_committed
DESC When set to 1, it indicates that the last write that caused the Cache ID Decoder Commit bit to transition from 0 to 1 was successfully processed by the component. This bit is cleared when the software causes the Cache ID Decoder Commit bit to transition from 1 to 0. This bit is reserved if Explicit Cache ID Decoder Commit Required=0.
F 1 1 cache_id_decoder_error_not_committed
DESC When set to 1, it indicates that the last write that caused the Cache ID Decoder Commit bit to transition from 0 to 1 was processed by the component, but resulted in an error. This bit is cleared when the software causes the Cache ID Decoder Commit bit to transition from 1 to 0. This bit is reserved if Explicit Cache ID Decoder Commit Required=0.
F 8 4 cache_id_decoder_commit_timeout_scale
DESC This field specifies the time scale associated with Cache ID Decoder Commit Timeout. 0000b = 1 us 0001b = 10 us 0010b = 100 us 0011b = 1 ms 0100b = 10 ms 0101b = 100 ms 0110b = 1 second 0111b = 10 seconds All other encodings are reserved This field is reserved if Explicit Cache ID Decoder Commit Required=0.
F 12 4 cache_id_decoder_commit_timeout_base
DESC This field determines the Cache ID Decoder Commit timeout. The timeout duration is calculated by multiplying the Timeout Base with the Timeout Scale. Failure to set either the Cache ID Decoder Committed bit or the Cache ID Decoder Error Not Committed bit within the timeout value is treated as equivalent to commit error. In case of a timeout, the software must clear the Cache ID Decoder Commit bit to 0 prior to setting it to 1 again. This field is reserved if Explicit Cache ID Decoder Commit Required=0.
R 0xe78 32 ROV ROOT por_ccla_cxl_hdm_decoder_capability
RESET 0x101c14 0x1f3fff
DESC Contains CXL_HDM_Decoder_Capability_Register. Only applicable for Device. Host does not use this register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 4 decoder_count
DESC Reports the number of memory address decoders implemented by the component. 0 1 Decoder 1 2 Decoders 2 4 Decoders 36 Decoders 48 Decoders 510 Decoders All other values are reserved
F 4 4 target_count
DESC The number of target ports each decoder supports (applicable to Upstream Switch Port and Root Port only). Maximum of 8. 1 1 target port 2 2 target ports 4 4 target ports 8 8 target ports All other values are reserved
F 8 1 interleave_support_11
DESC If set  the component supports interleaving based on Address bit 11  Address bit 10  Address bit 9 and Address bit 8. Root Ports and Upstream Switch Ports shall always set this bit indicating support for interleaving based on Address bit 11-8.
F 9 1 interleave_support_14
DESC If set  the component supports interleaving based on Address bit 14  Address bit 13 and Address bit 12. Root ports and switches shall always set this bit indicating support for interleaving based on Address bits 14-12.
F 10 1 poison_on_decode_err
DESC If set  the component is capable of returning poison on read access to addresses that are not positively decoded by any HDM Decoders in this component. If clear  the component is not capable of returning poison under such scenarios.
F 11 1 interleave_capability_3_6_12_way
DESC If set  the component is capable of returning poison on read access to addresses that are not positively decoded by any HDM Decoders in this component. If clear  the component is not capable of returning poison under such scenarios.
F 12 1 interleave_capability_16
DESC If set  the component is capable of returning poison on read access to addresses that are not positively decoded by any HDM Decoders in this component. If clear  the component is not capable of returning poison under such scenarios.
F 13 1 uio_capable
DESC If set  the component is capable of returning poison on read access to addresses that are not positively decoded by any HDM Decoders in this component. If clear  the component is not capable of returning poison under such scenarios.
F 16 4 uio_capabale_decoder_count
DESC If set  the component is capable of returning poison on read access to addresses that are not positively decoded by any HDM Decoders in this component. If clear  the component is not capable of returning poison under such scenarios.
F 20 1 memdata_nxm_capable
DESC If set, the component supports MemData-NXM opcode. If cleared, the component does not support MemData-NXM opcode. All 256B Flit mode-capable components shall set this bit to 1.
R 0xe80 32 V ROOT por_ccla_cxl_hdm_decoder_global_control
RESET 0x0 0x3
DESC Contains CXL_HDM_Decoder_Global_Control_Register . Only applicable for Device. Host does not use this register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 1 poison_on_decode_err
DESC  This bit is RO and is hard-wired to 0 if Poison On Decode Error Capability=0. If set  the component returns poison on read access to addresses that are not positively decoded by the component. If clear  the component returns all 1s data without a poison under such scenarios.
F 1 1 hdm_decoder_enable
DESC This bit is only applicable to CXL.mem devices and shall return 0 on Root Ports and Upstream Switch Ports. When this bit is set  device shall use HDM decoders to decode CXL.mem transactions and not use HDM Base registers in DVSEC ID 0. Root Ports and Upstream Switch Ports always use HDM Decoders to decode CXL.mem transactions.
R 0xed0 32 V ROOT por_ccla_snoop_filter_group_id
RESET 0x0 0xffff
DESC Contains Snoop_Filter_Group_ID
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 16 group_id
DESC Uniquely identifies a snoop filter instance that is used to track CXL.cache devices below this Port. All Ports that share a single Snoop Filter instance shall set this field to the same value.
R 0xed8 32 V ROOT por_ccla_snoop_filter_effective_size
RESET 0x0 0xffffffff
DESC Contains Snoop_Filter_Effective_Size
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 32 capacity
DESC Effective Snoop Filter Capacity representing the size of cache that can be effectively tracked by the Snoop Filter with this Group ID  in multiples of 64K.
R 0xee0 32 - ROOT por_ccla_dvsec_cxl_range_1_base_high
RESET 0x0 0xffffffff
DESC Contains DVSEC_CXL_Range_1_Base_High. Only applicable for Device. Host does not use this register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 32 memory_base_high
DESC Corresponds to bits 63:32 of CXL Range 1 base in the host address space. Locked by CONFIG_LOCK. If a device implements CXL HDM Decoder Capability registers and software has enabled HDM Decoder by setting HDM Decoder Enable bit in CXL HDM Decoder Global Control register  the value of this field is not used during address decode. It is recommended that software program this to match CXL HDM Decoder 0 Base High Register for backward compatibility reasons.
R 0xee8 32 - ROOT por_ccla_dvsec_cxl_range_1_base_low
RESET 0x0 0xf0000000
DESC Contains DVSEC_CXL_Range_1_Base_Low. Only applicable for Device. Host does not use this register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 28 4 memory_base_low
DESC Corresponds to bits 31:28 of CXL Range 1 base in the host address space. Locked by CONFIG_LOCK. If a device implements CXL HDM Decoder Capability registers and software has enabled HDM Decoder by setting HDM Decoder Enable bit in CXL HDM Decoder Global Control register  the value of this field is not used during address decode. It is recommended that software program this to match CXL HDM Decoder 0 Base Low Register for backward compatibility reasons.
R 0xef0 32 - ROOT por_ccla_dvsec_cxl_range_2_base_high
RESET 0x0 0xffffffff
DESC Contains DVSEC_CXL_Range_2_Base_High. Only applicable for Device. Host does not use this register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 32 memory_base_high
DESC Corresponds to bits 63:32 of CXL Range 2 base in the host address space. Locked by CONFIG_LOCK. If a device implements CXL HDM Decoder Capability registers and software has enabled HDM Decoder by setting HDM Decoder Enable bit in CXL HDM Decoder Global Control register  the value of this field is not used during address decode. It is recommended that software program this to match the corresponding CXL HDM Decoder Base High Register for backward compatibility reasons.
R 0xef8 32 - ROOT por_ccla_dvsec_cxl_range_2_base_low
RESET 0x0 0xf0000000
DESC Contains DVSEC_CXL_Range_2_Base_Low. Only applicable for Device. Host does not use this register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 28 4 memory_base_low
DESC Corresponds to bits 31:28 of CXL Range 2 base in the host address space. Locked by CONFIG_LOCK
R 0xf00 32 - ROOT por_ccla_dvsec_cxl_control
RESET 0x2 0x4fff
DESC Contains DVSEC_CXL_Control. Only applicable for Device. Host does not use this register 
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 1 cache_enable
DESC When set  enables CXL.cache protocol operation when in Flex Bus.CXL mode. Locked by CONFIG_LOCK.
F 1 1 io_enable
DESC When set  enables CXL.io protocol operation when in Flex Bus.CXL mode.
F 2 1 mem_enable
DESC When set  enables CXL.mem protocol operation when in Flex Bus.CXL mode. Locked by CONFIG_LOCK.
F 3 5 cache_sf_coverage
DESC Performance hint to the device. Locked by CONFIG_LOCK. 0x00: Indicates no Snoop Filter coverage on the Host For all other values of N: Indicates Snoop Filter coverage on the Host of 2^(N+15d) Bytes.
F 8 3 cache_sf_granularity
DESC Performance hint to the device. Locked by CONFIG_LOCK. 000: Indicates 64B granular tracking on the Host 001: Indicates 128B granular tracking on the Host 010: Indicates 256B granular tracking on the Host 011: Indicates 512B granular tracking on the Host 100: Indicates 1KB granular tracking on the Host 101: Indicates 2KB granular tracking on the Host 110: Indicates 4KB granular tracking on the Host 111: Reserved
F 11 1 cache_clean_eviction
DESC Performance hint to the device. Locked by CONFIG_LOCK. 0: Indicates clean evictions from device caches are needed for best performance 1: Indicates clean evictions from device caches are NOT needed for best performance
F 14 1 viral_enable
DESC When set  enables Viral handling in the CXL device. Locked by CONFIG_LOCK. If 0  the CXL device may ignore the viral that it receives
R 0xf08 32 V ROOT por_ccla_dvsec_cxl_control2
RESET 0x0 0xf
DESC Contains DVSEC_CXL_Control2. Only applicable for Device. Host does not use this register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 1 disable_caching
DESC When set to 1  device shall no longer cache new modified lines in its local cache. Device shall continue to correctly respond to CXL.cache transactions.
F 1 1 initiate_cache_write_back
DESC When set to 1  device shall write back all modified lines in the local cache and invalidate all lines. The device shall send CacheFlushed message to host as required by CXL.Cache protocol to indicate it does not hold any modified lines.
F 2 1 initiate_cxl_reset
DESC When set to 1  device shall initiate CXL Reset as defined in Section 9.7. This bit always returns the value of 0 when read by the software. A write of 0 is ignored.
F 3 1 cxl_reset_mem_clr_enable
DESC When set  and CXL Reset Mem Clr Capable returns 1  Device shall clear or randomize volatile HDM ranges as part of the CXL Reset operation. When CXL Reset Mem Clr Capable is clear  this bit is ignored and volatile HDM ranges may or may not be cleared or randomized during CXL Reset.
R 0xf10 32 V ROOT por_ccla_dvsec_cxl_lock
RESET 0x0 0x1
DESC Contains DVSEC_CXL_Lock. Only applicable for Device. Host does not use this register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 1 config_lock
DESC When set  all register fields in the PCIe DVSEC for CXL Devices Capability with RWL attribute become read only. Consult individual register fields for details. This bit is cleared upon device Conventional Reset. This bit and all the fields that are locked by this bit are not affected by CXL Reset.
R 0xf18 32 - ROOT por_ccla_dvsec_flex_bus_port_control
RESET 0x0 0x65
DESC Contains DVSEC_Flex_Bus_Port_Control
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 1 cache_enable
DESC When set  enables CXL.cache protocol operation when in Flex Bus.CXL mode.
F 2 1 mem_enable
DESC When set  enables CXL.mem protocol operation when in Flex Bus.CXL mode.
F 5 1 cxl2p0_enable
DESC When set  enable CXL2.0 protocol operation when in Flex Bus.CXL mode.
F 6 1 cxl_multi_logical_device_enable
DESC When set  enable Multi-Logical Device operation when in Flex Bus.CXL mode
R 0xf28 64 V ROOT por_ccla_root_port_n_security_policy
RESET 0x2 0x3
DESC Contains Root_Port_n_Security_Policy_Register 
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 2 trust_level
DESC Trust Level for the CXL.cache Device below Root Port n
R 0xf30 64 V ROOT por_ccla_root_port_n_id
RESET 0x0 0xff
DESC Contains Root_Port_n_ID_Register 
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 0 8 port_identifier
DESC Port Identifier of the Root Port n
R 0xf40 32 - ROOT por_ccla_err_capabilities_control
RESET 0x0 0x2000
DESC Contains err_capabilities_control. Only applicable to device. Host doesn't use this register
RGO por_ccla_rcr.cxllink_ctl
SGO por_ccla_scr.cxllink_ctl
F 13 1 poison_enabled
DESC If this bit is 0  CXL 1.1 Upstream Ports  CXL 1.1 Downstream Ports and CXL 2.0 Root Port shall treat poison received on CXL.cache or CXL.mem as uncorrectable error and log the error in Uncorrectable Error Status Register. If this bit is 1  these ports shall treat poison received on CXL.cache or CXL.mem as correctable error and log the error in Correctable Error Status Register. This bit defaults to 1. This bit is hardwired to 1 in CXL 2.0 Upstream Switch Port  CXL 2.0 Downstream Switch Port and CXL 2.0 device.
R 0xf58 32 - ROOT por_ccla_ide_key_refresh_time_control
RESET 0x0 0xffffffff
DESC Contains IDE_key_refresh_time_control. Not applicable to CMN 700
