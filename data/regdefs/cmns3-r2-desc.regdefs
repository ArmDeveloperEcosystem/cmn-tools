R 0x12e8 64 - ROOT por_cxlapb_cxl_hdm_decoder_6_dpa_skip_high
RESET 0x0 0xffffffff
DESC Contains CXL_HDM_Decoder_6_DPA_Skip_High_Register. Only applicable for Device. Host does not use this register
F 0 32 dpa_skip_high_6
DESC Corresponds to bits 63:32 of the DPA Skip length which  when non-zero  specifies a length of DPA space that is skipped  unmapped by any decoder  prior to the HPA to DPA mapping provided by this decoder.
R 0x12f0 32 - ROOT por_cxlapb_cxl_hdm_decoder_7_base_low
RESET 0x0 0xf0000000
DESC Contains CXL_HDM_Decoder_7_Base_High_Register. Only applicable for Device. Host does not use this register
F 28 4 memory_base_low_7
DESC Corresponds to bits 31:28 of the base of the address range managed by decoder 0
R 0x12f4 32 - ROOT por_cxlapb_cxl_hdm_decoder_7_base_high
RESET 0x0 0xffffffff
DESC Contains CXL_HDM_Decoder_7_Base_Low_Register. Only applicable for Device. Host does not use this register
F 0 32 memory_base_high_7
DESC Corresponds to bits 63:32 of the base of the address range managed by decoder 0.
R 0x12f8 32 - ROOT por_cxlapb_cxl_hdm_decoder_7_size_low
RESET 0x0 0xf0000000
DESC Contains CXL_HDM_Decoder_7_Size_Low_Register. Only applicable for Device. Host does not use this register
F 28 4 memory_size_low_7
DESC Corresponds to bits 31:28 of the size of the address range managed by decoder 0
R 0x12fc 32 - ROOT por_cxlapb_cxl_hdm_decoder_7_size_high
RESET 0x0 0xffffffff
DESC Contains CXL_HDM_Decoder_7_Size_High_Register. Only applicable for Device. Host does not use this register
F 0 32 memory_size_high_7
DESC Corresponds to bits 63:32 of the size of address range managed by decoder 0.
R 0x1300 32 - ROOT por_cxlapb_cxl_hdm_decoder_7_control
RESET 0x0 0x1fff
DESC Contains CXL_HDM_Decoder_7_Control_Register. Only applicable for Device. Host does not use this register
F 0 4 interleave_granularity_7
DESC The number of consecutive bytes that are assigned to each target in the Target List. 0 256 Bytes 1 512 Bytes 2 1024 Bytes (1KB) 3 2048 Bytes (2KB) 4 4096 Bytes (4KB) 5 8192 Bytes (8 KB) 6 16384 Bytes (16 KB)
F 4 4 interleave_ways_7
DESC The number of targets across which this memory range is interleaved. 0 - 1 way 1 - 2 way 2 4 way 3 8 way All other reserved
F 8 1 lock_on_commit_7
DESC If set  all RWL fields in Decoder 0 registers will become read only when Committed changes to 1.
F 9 1 commit_7
DESC Software sets this to 1 to commit this decoder
F 10 1 committed_7
DESC Indicates the decoder is active
F 11 1 err_not_committed_7
DESC Indicates the decode programming had an error and decoder is not active.
F 12 1 target_device_type_7
DESC 0: Target is a CXL Type 2 Device 1: Target is a CXL Type 3 Device
R 0x1304 32 - ROOT por_cxlapb_cxl_hdm_decoder_7_dpa_skip_low
RESET 0x0 0xf0000000
DESC Contains CXL_HDM_Decoder_7_DPA_Skip_Low_Register. Only applicable for device. Host does not use this register 
F 28 4 dpa_skip_low_7
DESC Corresponds to bits 31:28 of the DPA Skip length which  when non-zero  specifies a length of DPA space that is skipped  unmapped by any decoder  prior to the HPA to DPA mapping provided by this decoder.
R 0x1308 64 - ROOT por_cxlapb_cxl_hdm_decoder_7_dpa_skip_high
RESET 0x0 0xffffffff
DESC Contains CXL_HDM_Decoder_7_DPA_Skip_High_Register. Only applicable for Device. Host does not use this register
F 0 32 dpa_skip_high_7
DESC Corresponds to bits 63:32 of the DPA Skip length which  when non-zero  specifies a length of DPA space that is skipped  unmapped by any decoder  prior to the HPA to DPA mapping provided by this decoder.
R 0x1800 32 ROV ROOT por_cxlapb_snoop_filter_group_id
RESET 0x0 0xffff
DESC Contains Snoop_Filter_Group_ID
F 0 16 group_id
DESC Uniquely identifies a snoop filter instance that is used to track CXL.cache devices below this Port. All Ports that share a single Snoop Filter instance shall set this field to the same value.
R 0x1804 32 RO ROOT por_cxlapb_snoop_filter_effective_size
RESET 0x0 0xffffffff
DESC Contains Snoop_Filter_Effective_Size
F 0 32 capacity
DESC Effective Snoop Filter Capacity representing the size of cache that can be effectively tracked by the Snoop Filter with this Group ID  in multiples of 64K.
R 0x1858 32 - ROOT por_cxlapb_ide_key_refresh_time_control
RESET 0x0 0xffffffff
DESC Contains IDE_key_refresh_time_control. Not applicable to CMN 700
F 0 32 tx_key_refresh_time
DESC Minimum number of flits transmitter needs to block transmission of protocol flits after IDE.Start has sent. Used when switching keys.
R 0x185c 32 - ROOT por_cxlapb_ide_truncation_transmit_delay_control
RESET 0x0 0xff
DESC Contains IDE_truncation_transmit_delay_control. Not applicable to CMN 700
F 0 8 tx_truncation_transmit_delay
DESC This parameter feeds into the computation of minimum number of IDE idle flits Transmitter needs send after sending a truncated MAC flit.
R 0x1900 64 RO ROOT por_cxlapb_cxl_timeout_iso_capability
RESET 0x6030111 0xffffffff
DESC Contains cxl_timeout_iso_capability.
F 0 4 cxl_mem_txn_timeout_range
DESC In CXL Root Port Functions that support Transaction Timeout programmability this field allows system software to modify the Transaction Timeout ranges for CXL.mem.
F 4 1 cxl_mem_txn_timeout_supported
DESC When Set indicates support for CXL.mem Transaction Timeout mechanism.
F 5 3 rsvdp1
DESC Reserved
F 8 4 cxl_cache_txn_timeout_range
DESC In CXL Root Port Functions that support Transaction Timeout programmability this field allows system software to modify the Transaction Timeout Range for CXL.cache.
F 12 1 cxl_cache_txn_timeout_supported
F 13 3 rsvdp2
DESC Reserved
F 16 1 cxl_mem_iso_supported
DESC This field indicates support for Isolation on CXL.mem.
F 17 1 cxl_mem_iso_linkdown_supported
DESC This field indicates support for triggering Link-Down on the CXL port if CXL.mem enters Isolation mode.
F 18 1 cxl_cache_iso_supported
DESC This field indicates support for Isolation on CXL.cache.
F 19 1 cxl_cache_iso_linkdown_supported
DESC This field indicates support for triggering Link-Down on the CXL Root Port if CXL.cache enters Isolation mode.
F 20 5 rsvdp3
DESC Reserved
F 25 1 iso_err_cor_supported
DESC If Set, this bit indicates that the Root Port supports the ability to signal with ERR_COR when Isolation is triggered.
F 26 1 iso_interrupt_supported
DESC This field indicates support for signaling interrupt when Isolation is triggered.
F 27 5 iso_interrupt_message_number
DESC This field indicates which MSI/MSI-X vector is used for the interruptmessage generated in association with the CXL Timeout and Isolation Capability structure.
R 0x1908 32 - ROOT por_cxlapb_cxl_timeout_iso_ctl
RESET 0x0 0xffffffff
DESC Contains cxl_timeout_iso_ctl. Not applicable to CMN 700
F 0 4 cxl_mem_txn_timeout_value
DESC In CXL Root Port Functions that support Transaction Timeout programmability this field allows system software to modify the Transaction Timeout Value for CXL.mem.
F 4 1 cxl_mem_txn_timeout_enable
DESC When Set this bit enables CXL.mem Transaction Timeout mechanism.
F 5 3 rsvdp1
DESC Reserved
F 8 4 cxl_cache_txn_timeout_value
DESC In CXL Root Port Functions that support Transaction Timeout programmability this field allows system software to modify the Transaction Timeout Value for CXL.cache.
F 12 1 cxl_cache_txn_timeout_enable
F 13 3 rsvdp2
DESC Reserved
F 16 1 cxl_mem_iso_enable
DESC This field allows System Software to enable CXL.mem Isolation actions. If this field is set Isolation actions will be triggered if either a CXL.mem Transaction Timeout is detected or if the CXL link went down.
F 17 1 cxl_mem_iso_linkdown_enable
DESC This field allows System Software to trigger link down on the CXL Root Port if CXL.mem enters Isolation mode.
F 18 1 cxl_cache_iso_enable
DESC This field allows System Software to enable CXL.cache Isolation actions.
F 19 1 cxl_cache_iso_linkdown_enable
DESC This field allows System Software to trigger link down on the CXL Root Port if CXL.cache enters Isolation mode.
F 20 5 rsvdp3
DESC Reserved
F 25 1 iso_err_cor_enable
DESC When Set this bit enables the sending of an ERR_COR Message to indicate Isolation has been triggered.
F 26 1 iso_interrupt_enable
DESC When Set this bit enables the generation of an interrupt to indicate that Isolation has been triggered.
F 27 5 rsvdp4
DESC Reserved
R 0x190c 32 - ROOT por_cxlapb_cxl_timeout_iso_status
RESET 0x0 0x7fff
DESC Contains cxl_timeout_iso_status. Not applicable to CMN 700
F 0 1 cxl_mem_txn_timeout
DESC When Set, this indicates that a CXL.mem transaction timed out.
F 1 3 rsvdp1
DESC Reserved
F 4 1 cxl_cache_txn_timeout
DESC When Set, this indicates that a CXL.cache transaction timed out.
F 5 3 rsvdp2
DESC Reserved
F 8 1 cxl_mem_iso_status
DESC This field indicates that Isolation mode for CXL.mem was triggered.
F 9 1 cxl_mem_iso_linkdown_status
DESC This field indicates that Isolation Mode for CXL.mem was triggered due to link down
F 10 2 rsvdp3
DESC Reserved
F 12 1 cxl_cache_iso_status
DESC This field indicates that Isolation mode for CXL.cachewas triggered.
F 13 1 cxl_cache_iso_linkdown_status
DESC This field indicates that Isolation Mode for CXL.cache was triggered due to link down.
F 14 1 cxl_rp_busy
DESC When either the CXL.mem Isolation Status bit or the CXL.cacheIsolation Status bit is Set and this bit is Set, the Root Port is busy with internal activity that must complete before software is permitted to Clear the CXL.mem Isolation Status bit and the CXL.cache Isolation Status bit.
R 0x1980 32 RO ROOT por_cxlapb_cxl_cache_id_decoder_capability
RESET 0x0 0x1
DESC Contains CXL_Cache_ID_Decoder_Capability
F 0 1 explicit_cache_id_decoder_commit_required
DESC If 1, indicates that the software must set Cache ID Decoder Commit bit anytime a new CXL.cache device is enabled anywhere below this port. If 1, the Cache ID Decoder Commit bit, the Cache ID Decoder Committed bit, the Cache ID Decoder Commit timeout Scale field, the Cache ID Decoder Commit Timeout Base field, and Cache ID Decoder Error Not Committed bit are implemented. Cache ID Decoder Commit operation may be used by a component to update its internal structures or perform consistency checks.
R 0x1984 32 - ROOT por_cxlapb_cxl_cache_id_decoder_control
RESET 0x0 0x30f0f0f
DESC Contains CXL_Cache_ID_Decoder_Control
F 0 1 forward_cache_id
DESC 1 indicates the Port forwards CXL.cache messages in both directions. The reset default is 0.
F 1 1 assign_cache_id
DESC 1 indicates this Downstream Port is connected directly to a CXL.cache Device and assigns a cache ID=Local Cache ID to it. The reset default is 0.
F 2 1 hdm_d_type_2_device_present
DESC 1 indicates there is a Type 2 Device below this Downstream Port that is using HDM-D flows. The reset default is 0.
F 3 1 cache_id_decoder_commit
DESC If Explicit Cache ID Decoder Commit Required=1. software must cause this bit to transition from 0 to 1 to commit the Cache ID assignment change to this Cache ID Decoder instance. The default value of this field is 0. This bit must be RW if the Explicit Cache ID Decoder Commit Required bit is set; otherwise, it is permitted to be hardwired to 0 and the Cache ID Decoder update does not require an explicit commit. Software must not set this bit unless the Explicit Cache ID Decoder Commit Required bit is set.
F 8 4 hdm_d_type_2_device_cache_id
DESC If HDM-D Type 2 Device Present=1, this field represents the Cache ID that has been assigned to the Type 2 device below this Downstream Port that is using HDM-D flows. This field may be used by the port to identify a Type 2 device that is using HDM-D flows and must not be used for assigning Cache ID. The reset default is 0h.
F 16 4 local_cache_id
DESC If Assign Cache ID Enable=1, the Port assigns this Cache ID to the directly connected CXL.cache device regardless of whether it is using HDM-D flows or HDM-DB flows. The reset default is 0h.
F 24 2 trust_level
DESC Trust Level assigned to the directly connected device when Assign Cache ID=1. 00b = See Table 8-26 01b = Reserved 10b = See Table 8-26 11b = Reserved The reset default is 10b.
R 0x1988 32 RO ROOT por_cxlapb_cxl_cache_id_decoder_status
RESET 0x0 0xff03
DESC Contains CXL_Cache_ID_Decoder_Status 
F 0 1 cache_id_decoder_committed
DESC When set to 1, it indicates that the last write that caused the Cache ID Decoder Commit bit to transition from 0 to 1 was successfully processed by the component. This bit is cleared when the software causes the Cache ID Decoder Commit bit to transition from 1 to 0. This bit is reserved if Explicit Cache ID Decoder Commit Required=0.
F 1 1 cache_id_decoder_error_not_committed
DESC When set to 1, it indicates that the last write that caused the Cache ID Decoder Commit bit to transition from 0 to 1 was processed by the component, but resulted in an error. This bit is cleared when the software causes the Cache ID Decoder Commit bit to transition from 1 to 0. This bit is reserved if Explicit Cache ID Decoder Commit Required=0.
F 8 4 cache_id_decoder_commit_timeout_scale
DESC This field specifies the time scale associated with Cache ID Decoder Commit Timeout. 0000b = 1 us 0001b = 10 us 0010b = 100 us 0011b = 1 ms 0100b = 10 ms 0101b = 100 ms 0110b = 1 second 0111b = 10 seconds All other encodings are reserved This field is reserved if Explicit Cache ID Decoder Commit Required=0.
F 12 4 cache_id_decoder_commit_timeout_base
DESC This field determines the Cache ID Decoder Commit timeout. The timeout duration is calculated by multiplying the Timeout Base with the Timeout Scale. Failure to set either the Cache ID Decoder Committed bit or the Cache ID Decoder Error Not Committed bit within the timeout value is treated as equivalent to commit error. In case of a timeout, the software must clear the Cache ID Decoder Commit bit to 0 prior to setting it to 1 again. This field is reserved if Explicit Cache ID Decoder Commit Required=0.
