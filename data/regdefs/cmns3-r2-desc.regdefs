GROUP por_mtu_registers
R 0x0 64 RO - por_mtu_node_info
RESET 0x10 0xffffffffffff
DESC Provides component identification information.
F 0 16 node_type
DESC CMN node type identifier
F 16 16 node_id
DESC Component node ID
PAR NODEID_PARAM
F 32 16 logical_id
DESC Component logical ID
PAR LOGICALID_PARAM
R 0x80 64 RO - por_mtu_child_info
RESET 0x0 0xffffffff
DESC Provides component child identification information.
F 0 16 child_count
DESC Number of child nodes; used in discovery process
F 16 16 child_ptr_offset
DESC Starting register offset which contains pointers to the child nodes
R 0x900 64 RO - por_mtu_unit_info
RESET 0x104100 0x3ffff8
DESC Provides component identification information for MTU.
F 0 3 tc_size
DESC TC size 3'b000: No TC 3'b001: 128KB 3'b010: 256KB 3'b011: 512KB 3'b100: 1MB 3'b101: 2MB 3'b110: 32KB, 3'b111: 64KB
F 3 7 mtu_num_outstanding_reqs
DESC Maximum number of outstanding AXI requests from MTU
PAR MTU_TCQ_NUM_REQ_PARAM
F 10 6 mtu_num_data_buf
DESC Number of data buffers in MTU
PAR MTU_TCQ_DATA_BUF_PARAM
F 16 6 mtu_max_dram_addr_width
DESC DRAM Addr width
PAR MTU_MAX_DRAM_ADDR_WIDTH_PARAM
R 0x980 64 - ROOT por_mtu_rcr
RESET 0x0 0x83
DESC Root register access override.
F 0 1 cfg_ctl
DESC Allows Root override of the configuration control register
F 1 1 tc_dbgrd
DESC Allows Root override of the secure debug register (por_mtu_cfg_tc_dgbrd)
F 7 1 ras
DESC Allow Root override of the RAS registers
R 0x988 64 - S por_mtu_scr
RESET 0x0 0x83
DESC Secure register access override.
F 0 1 cfg_ctl
DESC Allows Secure override of the configuration control register
F 1 1 tc_dbgrd
DESC Allows Secure override of the secure debug register (por_mtu_cfg_tc_dgbrd)
F 7 1 ras
DESC Allow Secure override of the RAS registers
R 0xa00 64 - ROOT por_mtu_cfg_ctl
RESET 0x0 0x1fff
DESC Functions as the configuration control register for MTU.
RGO por_mtu_rcr.cfg_ctl
SGO por_mtu_scr.cfg_ctl
F 0 1 mtu_axi_wr_qos_override_en
DESC Enables QoS override for all AXI Write requests.
F 1 4 mtu_axi_wr_qos_override_value
DESC QoS Override value to be used for all AXI Write requests generated by MTU. This value is used only when axi_wr_qos_override_en is set.
F 5 1 mtu_axi_rd_qos_override_en
DESC Enables QoS override for all AXI Read requests.
F 6 4 mtu_axi_rd_qos_override_value
DESC QoS Override value to be used for all AXI Read requests generated by MTU. This value is used only when axi_rd_qos_override_en is set.
F 10 1 mtu_tag_pa_out_of_range_chk_en
DESC Enables Tag Address Out of Range checking.
F 11 1 mtu_cmo_late_comp_en
DESC Enables CMO completion only when data is flushed out of TC to Memory
F 12 1 mtu_req_alloc_hint_en
DESC Request Alloc Hint is used to determine TC allocation for TC Miss. Note: If this bit is clear, Tags are always allocated in TC. During no_tc_mode, and no_fill_mode; Tags are never allocated.
R 0xa08 64 - ROOT por_mtu_aux_ctl
RESET 0x8 0xff
DESC Functions as the auxiliary control register for the MTU
F 0 1 no_tc_mode
DESC Enables No TC Mode; disables MTU Tag Cache when set.
F 1 1 no_fill_mode
DESC Enables No Fill Mode for Tag Cache. When set, no new lines would be allocated in Tag Cache.
F 2 2 tc_flush_tcq_limit
DESC Controls number of TC Flush requests allowed to occupy TCQ entries. 2'b00: TC Flush Requests allowed to take one TCQ entry. 2'b01: TC Flush Requests allowed to take 25% of TCQ entries. 2'b10: TC Flush Requests allowed to take 50% of TCQ entries. 2'b11: TC Flush Requests allowed to take All TCQ entries.
F 4 1 tdb_fwd_disable
DESC Disable Tag Data Buffer forwarding from a request to a dependent child request.
F 5 1 prefetchtgt_tc_alloc_disable
DESC Do not allocate PrefetchTgt requests in TC.
F 6 1 mtu_nderr_disable
DESC Disable NDErr from MTU to RN for any Tag errors.
F 7 1 mtu_cg_disable
DESC Disables MTU architectural clock gating.
R 0xa30 64 - ROOT por_mtu_tc_flush_pr
RESET 0x0 0x3
DESC Functions as Tag Cache Flush Policy Register
RGO por_mtu_rcr.cfg_ctl
SGO por_mtu_scr.cfg_ctl
F 0 1 mtu_tc_flush_enable
DESC Start Tag Cache Flush
F 1 1 mtu_tc_flush_mode
DESC Tag Cache Flush Mode 1'b0: Clean Invalid. WB dirty data and invalidate local copy in TC. 1'b1: Clean Shared. WB dirty data and keep clean copy in TC.
R 0xa38 64 RO - por_mtu_tc_flush_sr
RESET 0x0 0x1
DESC Functions as Tag Cache Flush Status Register
F 0 1 mtu_tc_flush_complete
DESC Tag Cache Flush Complete
R 0xa40 64 - ROOT por_mtu_tag_addr_ctl
RESET 0x0 0x7
DESC PA to DA address conversion control
