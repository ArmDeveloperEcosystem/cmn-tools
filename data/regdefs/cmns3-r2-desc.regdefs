R 0x1928 64 ROV ROOT por_ccg_ha_cxprtcl_link2_status
RESET 0x2 0x7
DESC Functions as the CXHA CCIX Protocol Link 2 status register. Works with por_ccg_ha_cxprtcl_link2_ctl.
F 0 1 lnk2_link_ack
DESC Link Up/Down acknowledge; hardware updates this register bit to acknowledge the software link request 1'b0: Link Down acknowledge; hardware clears Link_ACK on receiving a Link Down request; the local agent stops sending protocol credits to the remote agent when Link_ACK is clear 1'b1: Link Up acknowledge; hardware sets Link_ACK when the local agent is ready to start accepting protocol credits from the remote agent NOTE: The local agent must clear Link_DN before setting Link_ACK.
F 1 1 lnk2_link_down
DESC Link Down status; hardware updates this register bit to indicate Link Down status 1'b0: Link is not Down; hardware clears Link_DN when it receives a Link Up request 1'b1: Link is Down; hardware sets Link_DN after the local agent has received all local protocol credits. The local agent must continue to respond to any remote protocol activity, including accepting and returning remote protocol credits until Link Up is clear 
F 2 1 lnk2_snoopdomain_ack
DESC Provides Snoop domain status (SYSCOACK) for CCIX Link 2
R 0x1c00 64 - ROOT por_ccg_ha_agentid_to_linkid_reg0
RESET 0x0 0x303030303030303
DESC Specifies the mapping of Baseid to Link ID for Agent IDs 0 to 7.
RGO por_ccg_ha_rcr.linkid_ctl
SGO por_ccg_ha_scr.linkid_ctl
F 0 2 agent0_linkid
DESC Specifies Link ID for baseid-0
F 8 2 agent1_linkid
DESC Specifies Link ID for baseid-1
F 16 2 agent2_linkid
DESC Specifies Link ID for baseid-2
F 24 2 agent3_linkid
DESC Specifies Link ID for baseid-3
F 32 2 agent4_linkid
DESC Specifies Link ID for baseid-4
F 40 2 agent5_linkid
DESC Specifies Link ID for baseid-5
F 48 2 agent6_linkid
DESC Specifies Link ID for baseid-6
F 56 2 agent7_linkid
DESC Specifies Link ID for baseid-7
R 0x1cf8 64 - ROOT por_ccg_ha_agentid_to_linkid_val
RESET 0x0 0xff
DESC Specifies which Agent ID to Link ID mappings are valid.
RGO por_ccg_ha_rcr.linkid_ctl
SGO por_ccg_ha_scr.linkid_ctl
F 0 8 valid
DESC Specifies whether the Link ID is valid; bit number corresponds to logical Agent ID number (from 0 to 7)
R 0xd900 64 - - por_ccg_ha_pmu_event_sel
RESET 0x0 0xfffffffff
DESC Specifies the PMU event to be counted as a 8-bit ID with the following encodings: 8'h00: CXHA_PMU_EVENT_NULL 8'h61: CXHA_PMU_EVENT_RDDATBYP 8'h62: CXHA_PMU_EVENT_CHIRSP0_UP_STALL 8'h63: CXHA_PMU_EVENT_CHIDAT_UP_STALL 8'h64: CXHA_PMU_EVENT_SNPPCRD_LNK0_STALL 8'h65: CXHA_PMU_EVENT_SNPPCRD_LNK1_STALL 8'h66: CXHA_PMU_EVENT_SNPPCRD_LNK2_STALL 8'h67: CXHA_PMU_EVENT_REQTRK_OCC 8'h68: CXHA_PMU_EVENT_RDB_OCC 8'h69: CXHA_PMU_EVENT_RDBBYP_OCC 8'h6A: CXHA_PMU_EVENT_WDB_OCC 8'h6B: CXHA_PMU_EVENT_SNPTRK_OCC 8'h6C: CXHA_PMU_EVENT_SDB_OCC 8'h6D: CXHA_PMU_EVENT_SNPHAZ_OCC 8'h6E: CXHA_PMU_EVENT_REQTRK_ALLOC 8'h6F: CXHA_PMU_EVENT_RDB_ALLOC 8'h70: CXHA_PMU_EVENT_RDBBYP_ALLOC 8'h71: CXHA_PMU_EVENT_WDB_ALLOC 8'h72: CXHA_PMU_EVENT_SNPTRK_ALLOC 8'h73: CXHA_PMU_EVENT_SDB_ALLOC 8'h74: CXHA_PMU_EVENT_SNPHAZ_ALLOC 8'h75: CCHA_PMU_EVENT_PB_RHU_REQ_OCC 8'h76: CCHA_PMU_EVENT_PB_RHU_REQ_ALLOC 8'h77: CCHA_PMU_EVENT_PB_RHU_PCIE_REQ_OCC 8'h78: CCHA_PMU_EVENT_PB_RHU_PCIE_REQ_ALLOC 8'h79: CCHA_PMU_EVENT_PB_PCIE_WR_REQ_OCC 8'h7A: CCHA_PMU_EVENT_PB_PCIE_WR_REQ_ALLOC 8'h7B: CCHA_PMU_EVENT_PB_PCIE_REG_REQ_OCC 8'h7C: CCHA_PMU_EVENT_PB_PCIE_REG_REQ_ALLOC 8'h7D: CCHA_PMU_EVENT_PB_PCIE_RSVD_REQ_OCC 8'h7E: CCHA_PMU_EVENT_PB_PCIE_RSVD_REQ_ALLOC 8'h7F: CCHA_PMU_EVENT_PB_RHU_DAT_OCC 8'h80: CCHA_PMU_EVENT_PB_RHU_DAT_ALLOC 8'h81: CCHA_PMU_EVENT_PB_RHU_PCIE_DAT_OCC 8'h82: CCHA_PMU_EVENT_PB_RHU_PCIE_DAT_ALLOC 8'h83: CCHA_PMU_EVENT_PB_PCIE_WR_DAT_OCC 8'h84: CCHA_PMU_EVENT_PB_PCIE_WR_DAT_ALLOC 8'h85: CXHA_PMU_EVENT_CHIRSP1_UP_STALL
F 0 8 pmu_event0_id
DESC CXHA PMU Event 0 ID
F 8 8 pmu_event1_id
DESC CXHA PMU Event 1 ID
F 16 8 pmu_event2_id
DESC CXHA PMU Event 2 ID
F 24 8 pmu_event3_id
DESC CXHA PMU Event 3 ID
F 32 4 pmu_occup1_id
DESC CXHA PMU occupancy event selector ID
ENDGROUP
GROUP por_ccg_ra_registers
R 0x0 64 RO - por_ccg_ra_node_info
RESET 0x103 0xffffffffffff
DESC Provides component identification information.
F 0 16 node_type
DESC CMN node type identifier
F 16 16 node_id
DESC Component CHI node ID
PAR NODEID_PARAM
F 32 16 logical_id
DESC Component logical ID
PAR LOGICALID_PARAM
R 0x80 64 RO - por_ccg_ra_child_info
RESET 0x0 0xffffffff
DESC Provides component child identification information.
F 0 16 child_count
DESC Number of child nodes; used in discovery process
F 16 16 child_ptr_offset
DESC Starting register offset which contains pointers to the child nodes
R 0x900 64 RO - por_ccg_ra_unit_info
RESET 0x8820080084000006 0xffffffffffffff9f
DESC Provides component identification information for CXRA.
F 0 5 num_mem_regions
DESC Number of memory regions supported
PAR CCG_RA_SAM_NUM_ADDR_REGION_PARAM
F 7 1 ccg_2xtxrsp_en
DESC Enable more than 1 TX CHI ports. Total number of TX CHI response ports are 2.
PAR CCG_2XTXRSP_EN_PARAM
F 8 10 a4s_logicalid
DESC AXI4Stream interfaces logical ID
PAR CCG_A4S_LOGICALID_PARAM
F 18 9 request_tracker_depth
DESC Depth of Request Tracker - number of outstanding Memory requests on CCIX
PAR CCG_RA_NUM_REQS_PARAM
F 27 9 rdb_depth
DESC Depth of Read Data Buffer
PAR CCG_RA_NUM_RDBUF_PARAM
F 36 9 wdb_depth
DESC Depth of Write Data Buffer
PAR CCG_RA_NUM_WRBUF_PARAM
F 45 9 snoop_tracker_depth
DESC Depth of Snoop Tracker - number of outstanding SNP requests on CCIX
PAR CCG_RA_NUM_SNPREQS_PARAM
F 54 9 snoop_databuffer_depth
DESC Depth of Snoop Data Buffer - number of outstanding SNP requests on CHI
PAR CCG_RA_NUM_SNPBUF_PARAM
F 63 1 mpe_en
DESC Enable MPE in CCG. MPE is not supported in CML SMP and needs to be set to 1'b0
PAR CCG_RA_MPE_ENABLE_PARAM
R 0x908 64 RO - por_ccg_ra_unit_info_1
RESET 0x8010040 0xfffffff
DESC Provides component identification information for CXRA.
F 0 9 num_ca_all_ha
DESC Number of Caching agents behind a HA on CC at IOC-RA.
PAR CCG_RA_NUM_CA_ALL_HA_PARAM
F 9 9 num_rcb
DESC Number rcb in RA
PAR CCG_RA_NUM_RCB_PARAM
F 18 10 lht_request_tracker_depth
DESC Depth of LHT Request Tracker - number of outstanding Memory requests on C2C
PAR CCG_RA_NUM_LHT_REQS_PARAM
R 0x980 64 - S por_ccg_ra_scr
RESET 0x0 0xf
DESC Secure register access override.
F 0 1 cfg_ctl
DESC Allows Secure override of the configuration control register
F 1 1 rasam_ctl
DESC Allows Secure override of the RA SAM control registers
F 2 1 linkid_ctl
DESC Allows Secure override of the RA Link ID registers
F 3 1 ldid_ctl
DESC Allows Secure override of the RA LDID registers
R 0x988 64 - ROOT por_ccg_ra_rcr
RESET 0x0 0xf
DESC Root register access override.
F 0 1 cfg_ctl
DESC Allows Root override of the configuration control register
F 1 1 rasam_ctl
DESC Allows Root override of the RA SAM control registers
F 2 1 linkid_ctl
DESC Allows Root override of the RA Link ID registers
F 3 1 ldid_ctl
DESC Allows Root override of the RA LDID registers
R 0xa00 64 - ROOT por_ccg_ra_cfg_ctl
RESET 0x18000007c1007 0x3fffffffffe07
DESC Functions as the configuration control register. Specifies the current mode.
RGO por_ccg_ra_rcr.cfg_ctl
SGO por_ccg_ra_scr.cfg_ctl
F 0 1 pcie_qos15_entry_rsv_en
DESC Enables entry reservation for QoS15 traffic from PCIe RN-I/RN-D 1'b1: Reserves tracker entry for QoS15 requests from PCIe RN-I/RN-D 1'b0: Does not reserve tracker entry for QoS15 requests from PCIe RN-I/RN-D
F 1 1 qos15_entry_rsv_en
DESC Enables entry reservation for QoS15 traffic 1'b1: Reserves tracker entry for QoS15 requests 1'b0: Does not reserve tracker entry for QoS15 requests
F 2 1 pcie_nonqos15_entry_rsv_en
DESC Enables entry reservation for non QoS15 traffic from PCIe RN-I/RN-D 1'b1: Reserves tracker entry for non QoS15 requests from PCIe RN-I/RN-D 1'b0: Does not reserve tracker entry for non QoS15 requests from PCIe RN-I/RN-D
F 9 1 cxsa_mode_en
DESC When set, enables the CCIX Subordinate Agent mode.In this mode RA functions as a CCIX Subordinate Agent 1'b1: CCIX Subordinate Agent 1'b0: CCIX Requesting Agent
F 10 1 ccix_writeevict_or_evict
DESC When set, downgrades WriteEvictOrEvict to Evict 1'b1: Evict is sent 1'b0: WriteEvict is sent
F 11 7 num_outstanding_hns_snp
DESC Specifies the Max number of outstanding snoops from the given RA to each HNS to guarantee snoop sink and deadlock prevention. Must be set to (HNS_NUM_ENTRIES_SNPQ_PARAM)/(NUM_NON_CXSA_RA).
F 18 8 mpe_twk_to_data_delay
DESC Specifies the number of clocks between mpe tweak and data
F 26 1 mpe_enable
DESC Specifies if MPE is enable
F 27 1 mpe_non_secure_bypass_disable
DESC When clear, non-secure data bypasses the MPE. When set, all data (including non-secure) is sent to the MPE. This register bit polarity allows non-secure data to be bypassed by default
F 28 1 mpe_mecid_filter_enable
DESC Specifies if mecid based filtering to send incoming request to MPE is enabled
F 29 16 mpe_mecid_filter
DESC Specifies mecid that is used to filter out incoming request to not to send to MPE
F 45 1 pmu_ev_32b_dataless_mode
DESC Select 32B mode for dataless Rd/Wr request for PMU events
F 46 1 cxl_mem_iso_nde_err_en
DESC Switch to NDE for the completion response for CHI Write requests, data with all 1's and NDE for CHI Read requests
F 47 1 chi_snp_support_nde_en
DESC Sends NDE when RA downgrades an incoming request for C2C SnoopSupport=false property
F 48 1 hns_c2c_fwd_pgs_en
DESC 1'b1 : hns traffic to ra over chi c2c is considered forward progress gaurantee 1'b0 : hns traffic to ra over chi c2c is not considered forward progress gaurantee
F 49 1 chi_pftgt_hint_disable
DESC 1'b1 : CHI Prefetch target hint is not propagated with the CHI request. 1'b0 : CHI Prefetch target hint is propagated with the CHI request.
R 0xa08 64 - ROOT por_ccg_ra_aux_ctl
RESET 0x82da3f343cc3846 0xfffffffffffeffff
DESC Functions as the auxiliary control register for CXRA.
F 0 1 cg_disable
DESC Disables clock gating when set
F 1 1 early_rdrcpt_en
DESC Early ReadReceipt enable; enables sending early ReadReceipt for ordered read requests
F 2 1 early_compack_en
DESC Early CompAck enable; enables sending early CompAck on CCIX for requests that require CompAck
F 3 1 devnr_ord_wfc
DESC When set, enables waiting for completion (COMP) before dispatching next Device-nR dependent transaction (TXN)
F 4 1 sameaddr_ord_wfc
DESC When set, enables waiting for completion (COMP) before dispatching next same Addr dependent transaction (TXN)
F 5 1 dis_rem_secure_access
DESC When set, treats all the incoming snoops as non-secure and forces the NS bit to 1
F 6 1 r2byp_en
DESC When set, enables request bypass. Applies to read and dataless requests only. Note: When set will affect the capability to chain a request on the TX side
F 7 1 dis_rdreqchain
DESC When set, disables chaining of read and dataless requests.
F 8 1 dis_wrreqchain
DESC When set, disables chaining of write requests.
F 9 1 dis_dbiddispq_rsp
DESC When set, disables the dispatch of DBID responses from a separate DispatchQ.
F 10 1 dis_cxsa_early_write_comp
DESC When set, disables early write completions in CCIX Subordinate Agent mode.
F 11 1 owo_stream_dis
DESC When set, disables CompAck dependency to dispatch an ordered PCIe write.
F 12 1 dvm_earlycomp_en
DESC When set, enables early DVM Op completion responses from RA.
F 13 1 prst_sepresp_en
DESC When set, enables separate persist response on CCIX for persistent cache maintenance (PCMO2) operation Note: this bit is applicable only in SMP mode.
F 14 1 dis_rnid_tnl_retry_trk
DESC When set, disables RNID write request tunneling retry tracker.
F 15 1 dis_rnid_early_wrcomp
DESC When set, disables early write completions for tunneled writes from RNI.
F 17 1 dis_3hop_dbid_order
DESC When set, disables ordered disapatch of DBIDs for 3-hop writes. By default, 3-hop DBIDs are dispatched in order. Applicable only if 3-hop write flow is enabled
F 18 1 dis_cxl_typ3_snpop
DESC When set, drives SnpType= NOP on CXL Type3 M2S Req and RwD messages
F 19 1 remote_rni_present
DESC When set, Enables TXNID coloring to enable traffic to remote RNI
F 20 1 dis_stash_prop
DESC When set, disables propagation of stash opcodes on CCIX. Applicable only in SMP mode. This is not applicable to C2C and should not be changed.
F 21 1 dis_stash_sep_prop
DESC When set, disables propagation of StashSep opcodes on CCIX. StashSep opcodes are sent as Stash opcodes when set. Applicable only in SMP mode
F 22 2 max_nd_reqout_msgs
DESC Used to configure the maximum number of non-data requests messages (reads, dataless) presented to CCLA's packing logic. 2'b00: one message 2'b01: two messages 2'b10: three messages 2'b11: four messages Note: The max is further limited by max allowed by the given protocol (CCIX2.0/CXL.mem/CXL.cache
F 24 2 max_dat_reqout_msgs
DESC Used to configure the maximum number of data requests messages (writes, atomics etc.) presented to CCLA's packing logic. 2'b00: one message 2'b01: two messages 2'b10: three messages 2'b11: four messages Note: The max is further limited by max allowed by the given protocol (CCIX2.0/CXL.mem/CXL.cache
F 26 1 ignore_likyshared_weore
DESC When set, disables the use of LikelyShared(LS) bit to make a decision for WriteEvictOrEvict 1'b0: Send WriteEvict when LS= 0 and send Evict when LS=1 1'b1: Ignore LS bit. WriteEvict is sent. Further static decision can be made using ccix_writeevict_or_evict in cfg_ctl register
F 27 1 dwngrd_chie_snps
DESC When set, downgrades CHIE SnpPreferUnique to SnpNotSharedDirty
F 28 1 set_all_pcie_wr_wlast
DESC When set, sets WLAST indication for all PCIe writes going to HA RNI 
F 29 1 disable_3hop_wr_flow
DESC When set, disables 3-hop write flow to remote HA. Applicable only in SMP mode
F 30 1 disables_combined_wcmo
DESC When set, disables sending combined W+CMO to remote HA. Applicable only in SMP mode
F 31 1 cxsa_send_pftchtgt_useful
DESC When set, sends PreFetch Usefull indication on CHI datasource field in CXSA mode
F 32 1 disable_backsnoop_hns
DESC When set, disables back snooping on an HNS/LCN initiated WriteClean request which is due to LLC eviction
F 33 1 enable_3hop_data_disp_throttle
DESC When set, enables throttling of the 3hop write data throttling if dathdr_rspout_fifo is out of tokens
F 34 1 dis_rem_secure_access_ext
DESC When set, forces the NSE bit to 1 and the address space can be selected between Root and Realm with NS bit for the incoming snoops
F 35 1 use_4bit_data_source_enc
DESC This field is deprecated from CHIG. When set, forces use of 4-bit Data Source Encoding. Used for DMT
F 36 5 error_isolation_read_rsp_starvation_value
DESC The number of cycles for which incoming data resp will take priority over synthesized read resp in case of error isolation triggered.
F 41 4 error_isolation_txn_timeout_count_threshold
DESC The number of transaction timeouts, which would trigger the cxl.mem isolation.
F 45 1 stash_datapull_entry_rsv_en
DESC When set, reserves at least entry 3 in bank0 of the RA RHT for read request due to stash snoop data pull
F 46 1 stash_datapull_entry_rsv_dis_other_fwdgs
DESC When set, only entry 3 in bank0 can be used for read request due to stash snoop data pull.
F 47 1 max_dyn_dat_reqout_en
DESC When set, enables RA to dynamically pack 3 or 4 DATHDR request based on number of extensions
F 48 1 max_dyn_nd_reqout_en
DESC When set, enables RA to dynamically pack 3 or 4 ND request based on number of extensions
F 49 1 addr_ordr_gbc
DESC When set, enables waiting for completion (COMP) before dispatching next same Addr dependent transaction (TXN). This includes the request group of CMO, WCMO, Stash and Atomics
F 50 1 evict_early_comp_en
DESC When set, allows Evict send from HNS to receive early comp
F 51 1 chi_c2c_2hop_wr_en
DESC Enables Write Push for CHI C2C in RA
F 52 6 num_rsvdc_wdb_token
DESC Number of RSVD WDB token for write pull. Cannot be changed below 2
F 58 6 num_spec_rsvdc_wdb_token
DESC Number of SPEC RSVD WDB token for write pull. Cannot be changed below 2
R 0xa10 64 - ROOT por_ccg_ra_aux_ctl2
RESET 0x6d 0x1ff
DESC Extension to the first aux ctl reg which functions as the auxiliary control register for CXRA.
F 0 1 chi_rsvdc_req_dat_sel
DESC Selects RSVDC fields to be used from Request or Data for Write Push for C2C 1'b1: Req RSVDC is selected 1'b0: Data RSVDC is selected
F 1 1 hns_snp_throttle_mode_en
DESC To enable Snoop throttling for HNS
PAR ((POR_3XSNP_EN_PARAM == 1) ? 1'b0 : 1'b1)
F 2 1 disable_stash_attr
DESC stashnid, stashnidv, stashlpid and stashlpidv are not pass through in chi c2c mode
F 3 1 iocoh_early_rdrcpt_dis
DESC early read receipt disable for io coherent read request in c2c mode. This should be set if DataSepResp and RespSepData are supported responses for io coherent reads from c2c downstream
F 4 1 c2c_mdh_en
DESC CCL DATHDR RSPOUT and REQOUT MDH Mode Enable during C2C
F 5 1 disable_chi_c2c_pcie_wr_ord
DESC PCIE Write Tunneling and Write Streaming features are disabled and no ordering is enforced. RNI is expected to serialize all PCIE Writes. Only applicable during CHI C2C mode
F 6 1 disable_chi_c2c_dbidrespord
DESC Ddisables DBIDRESPORD for non-copy-back writes when chi c2c mode is enabled
F 7 1 rsvd_persist_tracker_enable
DESC For transaction that belongs to forward progress class, a seperate persist tracker is used to make sure entries are available for reservation class transaction. It is a 4-entry
F 8 1 early_dbid_for_3hop_dis
DESC Chicken bit to disable early dbid send out of LHT for 3hop writes that are not ReqOrd
