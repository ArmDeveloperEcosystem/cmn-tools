R 0xf7f8 64 - ROOT por_ccla_c2c_logical_linkend_0_mc_credit1
RESET 0x10001000100 0x3ffffffffffffff
DESC C2C Logical Linkend MC Credit 1 
RGO por_ccla_rcr.c2c_cfg
SGO por_ccla_scr.c2c_cfg
F 0 10 numcrdtrsp
DESC Max Number of Response Credits allocated to this link end. Num Crdt RSP[15:10] are reserved.
F 16 10 numcrdtsnp
DESC  Max Number of Snoop Credits allocated to this link end.  
PAR CCG_RA_NUM_SNPREQS_PARAM
F 32 12 numcrdtdat
DESC   Max Number of Data Credits allocated to this link end.  
PAR CCG_HA_DAT_PASS_BUFF_DEPTH_PARAM
F 48 10 numcrdtmisc
DESC Max Number of Misc Credits allocated to this link end. 
R 0xf800 64 - ROOT por_ccla_c2c_logical_linkend_0_mc_credit2
RESET 0x100 0x1fff
DESC C2C Logical Linkend MC Credit 2 
RGO por_ccla_rcr.c2c_cfg
SGO por_ccla_scr.c2c_cfg
F 0 13 numcrdtreq
DESC Number of Total Request Credits allocated to this link end. Num Crdt REQ[15:13] are reserved.
PAR CCG_HA_REQ_PASS_BUFF_DEPTH_PARAM
R 0xf808 64 - ROOT por_ccla_c2c_logical_linkend_0_mc_credit3
RESET 0x10000 0x3fffffffffffff
DESC C2C Logical Linkend MC Credit 1 
RGO por_ccla_rcr.c2c_cfg
SGO por_ccla_scr.c2c_cfg
F 0 6 numcrdtrp0
DESC Number REQ MC credits allocated to RP0. NumCrdtRP0[15:6] are reserved.
F 16 6 numcrdtrp1
DESC  Number REQ MC credits allocated to RP1. NumCrdtRP0[15:6] are reserved.
F 32 6 numcrdtrp2
DESC  Number REQ MC credits allocated to RP2. NumCrdtRP0[15:6] are reserved.
F 48 6 numcrdtrp3
DESC Number REQ MC credits allocated to RP3. NumCrdtRP0[15:6] are reserved.
R 0xf810 64 - ROOT por_ccla_c2c_logical_linkend_0_mc_credit4
RESET 0x0 0x3fffffffffffff
DESC C2C Logical Linkend MC Credit 4 
RGO por_ccla_rcr.c2c_cfg
SGO por_ccla_scr.c2c_cfg
F 0 6 numcrdtrp0
DESC Number REQ MC credits allocated to RP0. NumCrdtRP0[15:6] are reserved.
F 16 6 numcrdtrp1
DESC  Number REQ MC credits allocated to RP1. NumCrdtRP0[15:6] are reserved.
F 32 6 numcrdtrp2
DESC  Number REQ MC credits allocated to RP2. NumCrdtRP0[15:6] are reserved.
F 48 6 numcrdtrp3
DESC Number REQ MC credits allocated to RP3. NumCrdtRP0[15:6] are reserved.
R 0xf818 64 - ROOT por_ccla_c2c_logical_linkend_0_mc_credit5
RESET 0x1000100000000 0x3ffffffffffffff
DESC C2C Logical Linkend MC Credit 5 
RGO por_ccla_rcr.c2c_cfg
SGO por_ccla_scr.c2c_cfg
F 0 10 numcrdtreqsh
DESC Number REQ MC credits allocated to Shared. NumCrdtRP0[15:6] are reserved.
PAR CCG_HA_REQ_PASS_BUFF_DEPTH_PARAM-10'h1
F 16 10 numcrdtdatash
DESC  Number DAT MC credits allocated to Shared. NumCrdtRP0[15:6] are reserved.
PAR CCG_HA_DAT_PASS_BUFF_DEPTH_PARAM-10'h2
F 32 10 numcrdtdatadp0
DESC  Number REQ MC credits allocated to RP2. NumCrdtRP0[15:6] are reserved.
F 48 10 numcrdtdatadp1
DESC Number REQ MC credits allocated to Data DP1. NumCrdtRP0[15:6] are reserved.
R 0xf820 64 RO ROOT por_ccla_c2c_port_egressid_route_table_capabilities
RESET 0x0 0x7ff
DESC C2C Port ID route table capabilities
RGO por_ccla_rcr.c2c_cfg
SGO por_ccla_scr.c2c_cfg
F 0 11 numportidrouteentries
DESC NumPortIdRouteEntries - Number of Route Id Entries supported. Valid values are 0 - 2^NumChipIDBits.
R 0xf828 64 RO ROOT por_ccla_c2c_port_ingressid_route_table_capabilities
RESET 0x0 0x7ff
DESC C2C Port ID route table capabilities
RGO por_ccla_rcr.c2c_cfg
SGO por_ccla_scr.c2c_cfg
F 0 11 numportidrouteentries
DESC NumPortIdRouteEntries - Number of Route Id Entries supported. Valid values are 0 - 2^NumChipIDBits.
