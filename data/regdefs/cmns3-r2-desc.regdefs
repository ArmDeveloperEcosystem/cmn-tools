DESC Number of static credits granted by this CCLA port for port forwarded traffic
PAR CCG_PORTFWD_NUM_STATIC_TXBUF_PARAM
F 32 8 portfwd_dynamic_crds
DESC Number of dynamic credits granted by this CCLA port for port forwarded traffic
PAR CCG_PORTFWD_NUM_DYNAMIC_TXBUF_PARAM
F 40 1 ccg_cxl_device_mode_en
DESC ccg_cxl_device_mode_en
PAR CCG_CXL_DEVICE_MODE_EN_PARAM
F 41 1 rx_stl_ram_protection_mode
DESC Protection mode on the RX_STL RAM (0: parity, 1: ECC)
PAR CCLA_RX_DATA_BUF_USE_ECC_PARAM
F 42 5 ccg_type
DESC CCG type
PAR CCG_TYPE_PARAM
R 0x980 64 - S por_ccla_scr
RESET 0x0 0x1fd
