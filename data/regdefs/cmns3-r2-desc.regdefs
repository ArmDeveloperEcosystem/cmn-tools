F 0 16 hns_rt_mpam_cpor_idr_cpbm_wd
DESC Number of bits in the cache portion partitioning bit map of this device.
PAR HNS_MPAM_CPBM_WD_PARAM
R 0x8038 64 RO ROOT cmn_hns_rt_mpam_ccap_idr
RESET 0x7 0xf0001f3f
DESC MPAM cache capacity partitioning ID register. This is banked separately
F 0 6 hns_rt_mpam_ccap_idr_cmax_wd
DESC Number of fractional bits implemented in the cache capacity partitioning.
PAR HNS_MPAM_CMAX_WD_PARAM
F 8 5 hns_rt_mpam_ccap_idr_cassoc_wd
DESC Number of fractional bits implemented in the cache associativity partitioning.
F 28 1 hns_rt_mpam_ccap_idr_has_cassoc
DESC 0: HN-F does not support MPAMCFG_CASSOC 1: HN-F supports MPAMCFG_CASSOC
F 29 1 hns_rt_mpam_ccap_idr_has_cmin
DESC 0: HN-F does not support MPAMCFG_CMIN 1: HN-F supports MPAMCFG_CMIN
F 30 1 hns_rt_mpam_ccap_idr_no_cmax
DESC 0: HN-F support MPAMCFG_CMAX 1: HN-F doesn't support MPAMCFG_CMAX
F 31 1 hns_rt_mpam_ccap_idr_has_cmax_softlim
DESC 0: HN-F has no SOFTLIM field and the maximum capacity is controlled with a hard limit 1: HN-F has a SOFTLIM field and the maximum capacity is controlled with a hard limit
R 0x8040 64 RO ROOT cmn_hns_rt_mpam_mbw_idr
RESET 0x0 0x1fff7c3f
DESC MPAM Memory Bandwidth partitioning ID register. This is banked separately
F 0 6 hns_rt_mpam_mbw_idr_bwa_wd
DESC Number of implemented bits in bandwidth allocation fields: MIN, MAX, and STRIDE. Value must be between 1 to 16
F 10 1 hns_rt_mpam_mbw_idr_has_min
DESC 0: There is no minimum memory bandwidth control and no MPAMCFG_MBW_MIN register 1: MPAMCFG_MBW_MIN register exists and minimum memory bandwidth allocation scheme is supported.
F 11 1 hns_rt_mpam_mbw_idr_has_max
DESC 0: There is no maximum memory bandwidth control and no MPAMCFG_MBW_MAX register 1: MPAMCFG_MBW_MAX register exists and maximum memory bandwidth allocation scheme is supported.
F 12 1 hns_rt_mpam_mbw_idr_has_pbm
DESC 0: There is no memory bandwidth portion control and no MPAMCFG_MBW_PBM register 1: MPAMCFG_MBW_PBM register exists and memory bandwidth portion allocation scheme is supported.
F 13 1 hns_rt_mpam_mbw_idr_has_prop
DESC 0: There is no memory bandwidth proportional stride control and no MPAMCFG_MBW_PROP register 1: MPAMCFG_MBW_PROP register exists and memory bandwidth proportional stride memory bandwidth allocation scheme is supported.
F 14 1 hns_rt_mpam_mbw_idr_windwr
DESC 0: The bandwidth accounting period should be read from MPAMCFG_MBW_WINDWR register, which might be fixed. 1: The bandwidth accounting width is readable and writable per partition in MPAMCFG_MBW_WINDWR register.
F 16 13 hns_rt_mpam_mbw_idr_bwpbm_wd
DESC Number of bits indication portions in MPAMCFG_MBW_PBM register.
R 0x8048 64 RO ROOT cmn_hns_rt_mpam_pri_idr
RESET 0x0 0x3f303f3
DESC MPAM Priority partitioning ID register. This is banked separately
F 0 1 hns_rt_mpam_pri_idr_has_intpri
DESC 0: This memory system component supports priority, but doesn't have an internal priority field in MPAMCFG_PRI. 1: This memory system component supports internal priority and has an INTPRI field.
F 1 1 hns_rt_mpam_pri_idr_intpri_0_is_low
DESC 0: In the INTPRI field, a value of 0 means highest priority. 1: In the INTPRI field, a value of 0 means lowest priority.
F 4 6 hns_rt_mpam_pri_idr_intpri_wd
DESC Number of bits in the internal priority field (INTPRI) in MPAMCFG_PRI.
F 16 1 hns_rt_mpam_pri_idr_has_dspri
DESC 0: This memory system component supports priority, but doesn't have a downstream priority (DSPRI) field in MPAMCFG_PRI. 1: This memory system component supports downstream priority and has an DSPRI field.
F 17 1 hns_rt_mpam_pri_idr_has_dspri_0_is_low
DESC 0: In the DSPRI field, a value of 0 means highest priority. 1: In the DSPRI field, a value of 0 means lowest priority.
F 20 6 hns_rt_mpam_pri_idr_dspri_wd
DESC Number of bits in downstream priority field (DSPRI) in MPAMCFG_PRI.
R 0x8050 64 RO ROOT cmn_hns_rt_mpam_partid_nrw_idr
RESET 0x0 0xffff
DESC MPAM PARTID narrowing ID register. This is banked separately
F 0 16 hns_rt_mpam_partid_nrw_idr_intpartid_max
DESC This field indicates the largest intPARTID supported in this component.
