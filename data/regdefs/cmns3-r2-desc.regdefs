R 0x2388 64 - - por_c2capb_c2c_logical_linkend_0_mc_credit1
RESET 0x10001000100 0x3ffffffffffffff
DESC C2C Logical Linkend MC Credit 1 
F 0 10 numcrdtrsp
DESC Max Number of Response Credits allocated to this link end. Num Crdt RSP[15:10] are reserved.
F 16 10 numcrdtsnp
DESC  Max Number of Snoop Credits allocated to this link end.  
PAR CCG_RA_NUM_SNPREQS_PARAM
F 32 12 numcrdtdat
DESC   Max Number of Data Credits allocated to this link end.  
PAR CCG_HA_DAT_PASS_BUFF_DEPTH_PARAM
F 48 10 numcrdtmisc
DESC Max Number of Misc Credits allocated to this link end. 
R 0x2390 64 - - por_c2capb_c2c_logical_linkend_0_mc_credit2
RESET 0x0 0x1fff
DESC C2C Logical Linkend MC Credit 2 
F 0 13 numcrdtreq
DESC Number of Total Request Credits allocated to this link end. Num Crdt REQ[15:13] are reserved.
PAR CCG_HA_REQ_PASS_BUFF_DEPTH_PARAM
R 0x2398 64 - - por_c2capb_c2c_logical_linkend_0_mc_credit3
RESET 0x10000 0x3fffffffffffff
DESC C2C Logical Linkend MC Credit 1 
F 0 6 numcrdtrp0
DESC Number REQ MC credits allocated to RP0. NumCrdtRP0[15:6] are reserved.
F 16 6 numcrdtrp1
DESC  Number REQ MC credits allocated to RP1. NumCrdtRP0[15:6] are reserved.
F 32 6 numcrdtrp2
DESC  Number REQ MC credits allocated to RP2. NumCrdtRP0[15:6] are reserved.
F 48 6 numcrdtrp3
DESC Number REQ MC credits allocated to RP3. NumCrdtRP0[15:6] are reserved.
R 0x23a0 64 - - por_c2capb_c2c_logical_linkend_0_mc_credit4
RESET 0x0 0x3fffffffffffff
DESC C2C Logical Linkend MC Credit 1 
F 0 6 numcrdtrp0
DESC Number REQ MC credits allocated to RP0. NumCrdtRP0[15:6] are reserved.
F 16 6 numcrdtrp1
DESC  Number REQ MC credits allocated to RP1. NumCrdtRP0[15:6] are reserved.
F 32 6 numcrdtrp2
DESC  Number REQ MC credits allocated to RP2. NumCrdtRP0[15:6] are reserved.
F 48 6 numcrdtrp3
DESC Number REQ MC credits allocated to RP3. NumCrdtRP0[15:6] are reserved.
R 0x23a8 64 - - por_c2capb_c2c_logical_linkend_0_mc_credit5
RESET 0x1000100000000 0x3ffffffffffffff
DESC C2C Logical Linkend MC Credit 1 
F 0 10 numcrdtreqsh
DESC Number REQ MC credits allocated to Shared. NumCrdtRP0[15:6] are reserved.
PAR CCG_HA_REQ_PASS_BUFF_DEPTH_PARAM-10'h1
F 16 10 numcrdtdatash
DESC  Number DAT MC credits allocated to Shared. NumCrdtRP0[15:6] are reserved.
PAR CCG_HA_DAT_PASS_BUFF_DEPTH_PARAM-10'h2
F 32 10 numcrdtdatadp0
DESC  Number REQ MC credits allocated to RP2. NumCrdtRP0[15:6] are reserved.
F 48 10 numcrdtdatadp1
DESC Number REQ MC credits allocated to Data DP1. NumCrdtRP0[15:6] are reserved.
ENDGROUP
GROUP por_dn_registers
R 0x0 64 RO - por_dn_node_info
RESET 0x1 0xffffffffffff
DESC Provides component identification information.
F 0 16 node_type
DESC CMN node type identifier
F 16 16 node_id
DESC Component CHI node ID
PAR NODEID_PARAM
F 32 16 logical_id
DESC Component logical ID
PAR LOGICALID_PARAM
R 0x80 64 RO - por_dn_child_info
RESET 0x0 0xffffffff
DESC Provides component child identification information.
F 0 16 child_count
DESC Number of child nodes; used in discovery process
F 16 16 child_ptr_offset
DESC Starting register offset which contains pointers to the child nodes
R 0x900 64 RO - por_dn_build_info
RESET 0x9 0xff
DESC Contains the configuration parameter values. Indicates the specific DN configuration.
F 0 1 dvm_v8_1_en
DESC Indicates that all nodes receiving DVM snoops support DVM v8/v8.1 operations.
F 1 7 dn_num_vmf_param
DESC Indicates the value of the DN_NUM_VMF_PARAM, with legal values of 4, 16, or 32.
PAR DN_NUM_VMF_PARAM
R 0x980 64 - ROOT por_dn_rcr
RESET 0x0 0x3
DESC Root register access override.
F 0 1 vmf
DESC Allows Root override of the secure VMF registers
F 1 1 cfg_ctl
DESC Allows Root override of the configuration control register
R 0x988 64 - S por_dn_scr
RESET 0x0 0x3
DESC Secure register access override.
F 0 1 vmf
DESC Allows Secure override of the VMF registers
F 1 1 cfg_ctl
DESC Allows Secure override of the configuration control register
R 0xa00 64 - ROOT por_dn_cfg_ctl
RESET 0xe10 0xff7f
DESC Functions as the configuration control register for DVM Node.
RGO por_dn_rcr.cfg_ctl
SGO por_dn_scr.cfg_ctl
F 0 1 enable_8_4_termination
DESC Enables termination of 8.4 DVMOps in DN.
F 1 5 rxsnp_starv_cnt
DESC Credit steal threshold.  The number of cycles RXSNP loses to RXREQ before credit stealing occurs.  Must be set to non-zero value - a value of 0 is treated as the default value of 8.
F 6 1 disable_dvmop_early_comp
DESC Disables Early Comp (CompDBID) for DVMOps
F 8 2 txsnp_pend_cnt
DESC Maximum number of (Non-Sync + Sync) SnpDVMOps issued on TXSNP. 2'b00: Max of 4 SnpDVMOps in progress (default) 2'b01: Max of 8 SnpDVMOps in progress 2'b10: Max of 16 SnpDVMOps in progress 2'b11: Reserved
F 10 1 broadcast_dvmop_inner
DESC Used to filter DVMOps marked as innersharable (IS) from being sent off-chip.
F 11 1 broadcast_dvmop_outer
DESC Used to filter DVMOps marked as outersharable (OS) from being sent off-chip.
F 12 1 filter_remote_dvmsync_en
DESC Enables logic which filters redundant DVMSyncs to remote domains.
F 13 1 disable_remote_broadcast_on_vmf_miss
DESC Disables broadcast of VMID Filterable DVMOps to remote on VMF miss.
F 14 1 enable_9_2_termination
DESC Enables termination of v9.2 DVMOps in DN.
F 15 1 dn_is_iohub
DESC Indicates to the DN that it is in an IO Hub. DVMOp requests from Compute Chiplet CCGs are treated as local reqs
R 0xa08 64 - ROOT por_dn_aux_ctl
RESET 0x0 0x3f
DESC Functions as the auxiliary control register for DN.
F 0 1 disable_vmf
DESC Disables VMID-based DVM snoop filtering when set
PAR POR_R2_ENABLE_PARAM
F 1 1 disable_clk_gating
DESC Disables autonomous clock gating when set
F 2 1 filter_rnd_icache_ops
DESC Filters out BPI and VICI/PICI Snps to RNDs when set
PAR POR_R2_ENABLE_PARAM
F 4 1 disable_ddn
DESC Disables Distributed DN functionality- Snoops all RNs and CML nodes in the mesh and disables snooping other DNs. Must program all RNSAMs to target HND for DVMs and then set this to 1 in HND.
F 5 1 disable_rxreq_crd_stealing
DESC Disables credit stealing from RXREQ LinkLayer when RXSNP is starved for RCB alloc.
R 0xc00 64 - ROOT por_dn_vmf0_ctrl
RESET 0xffff00000000 0xffff0001ffff
DESC Functions as the control register for VMID-based DVM snoop filtering. NOTE: This register has no effect when por_dn_aux_ctl.disable_vmf is set to 1.
RGO por_dn_rcr.vmf
SGO por_dn_scr.vmf
F 0 1 valid_0
DESC Register valid 1'b1: Register is enabled 1'b0: Register is not enabled
F 1 16 vmid_0
DESC VMID value NOTE: The incoming request's VMID is only compared with this VMID value if the request's VMID valid bit is set. If the request's VMID is valid and the two VMIDs match, filtering is applied to the incoming request.
F 32 16 mask_0
DESC VMID mask; enables mapping of multiple VMID values to a single register NOTE: Logically, the AND operator is performed on the mask and por_dn_vmf0_ctrl.vmid. Then, the AND operator is performed on the mask and the incoming request's VMID. The two results are then compared, and filtering is applied to the incoming request if the masked VMIDs match.
R 0xc08 64 - ROOT por_dn_vmf0_rnf0
RESET 0x0 0xffffffffffffffff
DESC Contains the logical RN-F bit vector 63:0 corresponding to por_dn_vmf0_ctrl.vmid. Used for VMID-based DVM snoop filtering.
RGO por_dn_rcr.vmf
SGO por_dn_scr.vmf
F 0 64 snp_destvec0_0
DESC RN-F bit vector 63:0 corresponding to por_dn_vmf0_ctrl.vmid
R 0xc10 64 - ROOT por_dn_vmf0_rnf1
RESET 0x0 0xffffffffffffffff
DESC Contains the logical RN-F bit vector 127:64 corresponding to por_dn_vmf0_ctrl.vmid. Used for VMID-based DVM snoop filtering.
RGO por_dn_rcr.vmf
SGO por_dn_scr.vmf
F 0 64 snp_destvec1_0
DESC RN-F bit vector 127:64 corresponding to por_dn_vmf0_ctrl.vmid
R 0xc18 64 - ROOT por_dn_vmf0_rnf2
RESET 0x0 0xffffffffffffffff
DESC Contains the logical RN-F bit vector 191:128 corresponding to por_dn_vmf0_ctrl.vmid. Used for VMID-based DVM snoop filtering.
RGO por_dn_rcr.vmf
SGO por_dn_scr.vmf
F 0 64 snp_destvec2_0
DESC RN-F bit vector 191:128 corresponding to por_dn_vmf0_ctrl.vmid
R 0xc20 64 - ROOT por_dn_vmf0_rnf3
RESET 0x0 0xffffffffffffffff
DESC Contains the logical RN-F bit vector 255:192 corresponding to por_dn_vmf0_ctrl.vmid. Used for VMID-based DVM snoop filtering.
RGO por_dn_rcr.vmf
SGO por_dn_scr.vmf
F 0 64 snp_destvec3_0
DESC RN-F bit vector 255:192 corresponding to por_dn_vmf0_ctrl.vmid
R 0xc28 64 - ROOT por_dn_vmf0_rnd0
RESET 0x0 0xffffffffffffffff
DESC Contains the logical RN-D bit vector 63:0 corresponding to por_dn_vmf0_ctrl.vmid. Used for VMID-based DVM snoop filtering.
RGO por_dn_rcr.vmf
SGO por_dn_scr.vmf
F 0 64 snp_destvec0_0
DESC RN-D bit vector 63:0 corresponding to por_dn_vmf0_ctrl.vmid
R 0xc30 64 - ROOT por_dn_vmf0_cxra
RESET 0x0 0xffffffffffffffff
DESC Contains the logical CXRA bit vector 63:0 corresponding to por_dn_vmf0_ctrl.vmid. Used for VMID-based DVM snoop filtering. NOTE: Not applicable in a single-chip CMN system. Does not have any effect.
RGO por_dn_rcr.vmf
SGO por_dn_scr.vmf
F 0 64 snp_destvec_0
DESC CXRA bit vector 63:0 corresponding to por_dn_vmf0_ctrl.vmid
R 0xc38 64 - ROOT por_dn_vmf1_ctrl
RESET 0xffff00000000 0xffff0001ffff
DESC Functions as the control register for VMID-based DVM snoop filtering. NOTE: This register has no effect when por_dn_aux_ctl.disable_vmf is set to 1.
RGO por_dn_rcr.vmf
SGO por_dn_scr.vmf
F 0 1 valid_1
DESC Register valid 1'b1: Register is enabled 1'b0: Register is not enabled
F 1 16 vmid_1
DESC VMID value NOTE: The incoming request's VMID is only compared with this VMID value if the request's VMID valid bit is set. If the request's VMID is valid and the two VMIDs match, filtering is applied to the incoming request.
F 32 16 mask_1
DESC VMID mask; enables mapping of multiple VMID values to a single register NOTE: Logically, the AND operator is performed on the mask and por_dn_vmf1_ctrl.vmid. Then, the AND operator is performed on the mask and the incoming request's VMID. The two results are then compared, and filtering is applied to the incoming request if the masked VMIDs match.
R 0xc40 64 - ROOT por_dn_vmf1_rnf0
RESET 0x0 0xffffffffffffffff
DESC Contains the logical RN-F bit vector 63:0 corresponding to por_dn_vmf1_ctrl.vmid. Used for VMID-based DVM snoop filtering.
RGO por_dn_rcr.vmf
SGO por_dn_scr.vmf
F 0 64 snp_destvec0_1
