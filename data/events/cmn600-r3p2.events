# Hardware PMU event selectors for PL610-r3p2
# Record syntax: README.md; source analysis: DERIVATION.md

# Filter positions and widths in pmu_event_sel.
F 0x1 0 occup1_id 32 4
F 0x5 0 occup1_id 32 3

# Node 0x1, PMU 0
V 0x1 occup1_id 0x0 all
V 0x1 occup1_id 0x1 dvmop
V 0x1 occup1_id 0x2 dvmsync
E 0x1 0 0x0 none
E 0x1 0 0x1 dn_dvmop_tlbi
E 0x1 0 0x2 dn_dvmop_bpi
E 0x1 0 0x3 dn_dvmop_pici
E 0x1 0 0x4 dn_dvmop_vici
E 0x1 0 0x5 dn_dvmsync
E 0x1 0 0x6 dn_vmid_filtered
E 0x1 0 0x7 dn_rndop_filtered
E 0x1 0 0x8 dn_retry
E 0x1 0 0x9 dn_txsnp_flitv
E 0x1 0 0xa dn_txsnp_stall
E 0x1 0 0xb dn_trkfull
E 0x1 0 0xc dn_trk_occupancy
U 0x1 0 0xc occup1_id

# Node 0x5, PMU 0
V 0x5 occup1_id 0x0 all
V 0x5 occup1_id 0x1 read
V 0x5 occup1_id 0x2 write
V 0x5 occup1_id 0x3 atomic
V 0x5 occup1_id 0x4 stash
