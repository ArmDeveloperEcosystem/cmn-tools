# Hardware PMU event selectors for PL624-r3p0
# Record syntax: README.md; source analysis: DERIVATION.md

# Filter positions and widths in pmu_event_sel.
# CMN-700 TRM 102308, por_dn_pmu_event_sel and cmn_hns_pmu_event_sel.
F 0x1 0 occup1_id 32 4
F 0x200 0 occup1_id 32 3
F 0x200 0 class_occup_id 35 2
F 0x200 0 hbt_lbt_sel 37 2
F 0x200 0 sn_home_sel 39 2

# Node 0x1, PMU 0
V 0x1 occup1_id 0x0 all
V 0x1 occup1_id 0x1 dvmop
V 0x1 occup1_id 0x2 dvmsync
E 0x1 0 0x0 none
E 0x1 0 0x1 dn_dvmop_tlbi
E 0x1 0 0x2 dn_dvmop_bpi
